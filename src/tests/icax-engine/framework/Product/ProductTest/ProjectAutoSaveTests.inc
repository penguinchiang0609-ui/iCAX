namespace {
    struct AutoSaveTestPayload {std::vector<uint8_t> Bytes;};
    std::string AutoSaveReadBytes(const std::filesystem::path& path){std::ifstream file(path,std::ios::binary);return {std::istreambuf_iterator<char>(file),std::istreambuf_iterator<char>()};}
    iCAX::Data::ObjectMap AutoSaveCall(const std::shared_ptr<CProductRuntime>& runtime,const std::shared_ptr<iCAX::Project::CProject>& project,uint64_t method=iCAX::Project::kProjectAutoSaveMethodCode){
        const auto endpoint=runtime->GetSceneFrontendSDOEndpoint(project->GetProjectID(),project->GetMainSceneID());endpoint.Send(MakeRequestFrame(9901,method));auto frames=WaitForFrames(endpoint);if(frames.size()!=1)throw std::runtime_error("Auto-save SDO response count");if(frames[0].nStatus!=iCAX::Interaction::EInvocationStatus::Ok)throw std::runtime_error(iCAX::Interaction::GetSDOPayloadText(frames[0]));return DecodeObjectPayload(frames[0]);
    }
}
TEST(ProductAutoSaveTest, JournalPersistsNativeUndoRedoCancelAndReopenWithoutRewritingArchive)
{
    const auto path=MakeTempProjectPath();auto runtime=MakeRuntime();runtime->Start();auto catalog=runtime->OpenProjectCatalog("Auto-save",path.string(),"Auto-save",path.string());auto project=catalog->GetMainProject();const auto id=project->GetProjectID();
    EXPECT_EQ("Snapshot",AutoSaveCall(runtime,project,iCAX::Project::kProjectSaveMethodCode).at("persistence").To<std::string>());const auto bytes=AutoSaveReadBytes(path);
    const auto entity=iCAX::Data::GenerateNewUUID(),cancelled=iCAX::Data::GenerateNewUUID();project->Stop();auto& db=project->MainSceneDatabase();{auto scope=db.BeginUndoCommand("Committed edit");db.CreateEntity(entity);scope->End();}project->Start();EXPECT_EQ("Journal",AutoSaveCall(runtime,project).at("persistence").To<std::string>());EXPECT_EQ(bytes,AutoSaveReadBytes(path));
    project->Stop();ASSERT_TRUE(db.Undo());project->Start();EXPECT_EQ("Journal",AutoSaveCall(runtime,project).at("persistence").To<std::string>());project->Stop();ASSERT_TRUE(db.Redo());{auto scope=db.BeginUndoCommand("Cancelled edit");db.CreateEntity(cancelled);scope->Cancel();}project->Start();EXPECT_EQ("Journal",AutoSaveCall(runtime,project).at("persistence").To<std::string>());EXPECT_EQ(bytes,AutoSaveReadBytes(path));
    ASSERT_TRUE(runtime->CloseProjectCatalog(catalog->GetCatalogID()));catalog=runtime->OpenProjectFile(path.string());project=catalog->GetMainProject();project->Stop();EXPECT_EQ(id,project->GetProjectID());EXPECT_TRUE(project->MainSceneDatabase().HasEntity(entity));EXPECT_FALSE(project->MainSceneDatabase().HasEntity(cancelled));project->Start();EXPECT_EQ("Journal",AutoSaveCall(runtime,project).at("persistence").To<std::string>());
    EXPECT_EQ("Snapshot",AutoSaveCall(runtime,project,iCAX::Project::kProjectSaveMethodCode).at("persistence").To<std::string>());EXPECT_NE(bytes,AutoSaveReadBytes(path));const auto journalBytes=AutoSaveReadBytes(path.string()+".log");EXPECT_EQ(journalBytes.find('\n'),journalBytes.size()-1);ASSERT_TRUE(runtime->CloseProjectCatalog(catalog->GetCatalogID()));catalog=runtime->OpenProjectFile(path.string());catalog->GetMainProject()->Stop();EXPECT_TRUE(catalog->GetMainProject()->MainSceneDatabase().HasEntity(entity));EXPECT_FALSE(catalog->GetMainProject()->MainSceneDatabase().HasEntity(cancelled));runtime->Stop();runtime->CloseProjectCatalog(catalog->GetCatalogID());RemoveProjectFiles(path);
}
TEST(ProductAutoSaveTest, ActiveGestureAndTransactionDeferAndSettingsOrResourceChangesRequireArchive)
{
    const auto path=MakeTempProjectPath();auto runtime=MakeRuntime();runtime->Start();auto catalog=runtime->OpenProjectCatalog("Auto-save",path.string(),"Auto-save",path.string());auto project=catalog->GetMainProject();AutoSaveCall(runtime,project,iCAX::Project::kProjectSaveMethodCode);const auto bytes=AutoSaveReadBytes(path);
    project->Stop();auto& db=project->MainSceneDatabase();auto scope=db.BeginUndoCommand("Drag remains active");db.CreateEntity(iCAX::Data::GenerateNewUUID());project->Start();const auto deferred=AutoSaveCall(runtime,project);EXPECT_FALSE(deferred.at("saved").To<bool>());EXPECT_TRUE(deferred.at("deferred").To<bool>());EXPECT_EQ("Deferred",deferred.at("persistence").To<std::string>());EXPECT_EQ(bytes,AutoSaveReadBytes(path));project->Stop();scope->Cancel();auto& tx=db.BeginTransaction("Pending transaction");project->Start();EXPECT_TRUE(AutoSaveCall(runtime,project).at("deferred").To<bool>());project->Stop();db.CancelTransaction(tx);project->Start();EXPECT_EQ("Journal",AutoSaveCall(runtime,project).at("persistence").To<std::string>());
    project->Stop();project->Settings().Set("units",std::string("millimeter"));project->Start();EXPECT_EQ("Snapshot",AutoSaveCall(runtime,project).at("persistence").To<std::string>());project->Stop();project->GetMainScene().SceneSettings().Set("camera",1);project->Start();EXPECT_EQ("Snapshot",AutoSaveCall(runtime,project).at("persistence").To<std::string>());
    std::atomic_int serializations=0;project->Stop();auto& resources=project->MainSceneResources();iCAX::Resource::CResourceVersionCodec codec;codec.Serialize=[&serializations](const std::shared_ptr<void>& value)->std::optional<std::vector<uint8_t>>{++serializations;return std::static_pointer_cast<AutoSaveTestPayload>(value)->Bytes;};codec.Deserialize=[](std::span<const uint8_t> bytes)->std::shared_ptr<void>{auto value=std::make_shared<AutoSaveTestPayload>();value->Bytes.assign(bytes.begin(),bytes.end());return value;};resources.RegisterPersistenceCodec<AutoSaveTestPayload>("test.autosave.binary",std::move(codec));
    const auto url=resources.MakeNamedResourceURL("checkpoint/large-payload");iCAX::Resource::CResourceInfo info;info.Persistence=iCAX::Resource::EResourcePersistenceMode::Embedded;info.ResourceTypeID="test.autosave.binary";info.nSchemaVersion=1;info.nMinimumReaderVersion=1;info.nVersion=1;auto value=std::make_shared<AutoSaveTestPayload>();value->Bytes.assign(4*1024*1024,42);resources.Set(url,value,info);project->Start();EXPECT_EQ("Snapshot",AutoSaveCall(runtime,project).at("persistence").To<std::string>());const auto afterSnapshot=serializations.load();EXPECT_EQ("Journal",AutoSaveCall(runtime,project).at("persistence").To<std::string>());EXPECT_EQ(afterSnapshot,serializations.load());
    project->Stop();info.nVersion=2;auto changed=std::make_shared<AutoSaveTestPayload>(*value);changed->Bytes[0]=43;resources.Set(url,changed,info);project->Start();EXPECT_EQ("Snapshot",AutoSaveCall(runtime,project).at("persistence").To<std::string>());EXPECT_GT(serializations.load(),afterSnapshot);project->Stop();auto metadata=*resources.GetInfo(url);metadata.Metadata["meaning"]="same-version metadata change";ASSERT_TRUE(resources.UpdateInfo(url,metadata));project->Start();EXPECT_EQ("Snapshot",AutoSaveCall(runtime,project).at("persistence").To<std::string>());
    project->Stop();auto descriptor=*resources.GetInfo(url);descriptor.Name="Changed presentation";descriptor.MediaType="application/test";descriptor.ContentHash="changed-descriptor-hash";descriptor.nFlags=19;descriptor.nMinimumReaderVersion=2;ASSERT_TRUE(resources.UpdateInfo(url,descriptor));project->Start();EXPECT_EQ("Snapshot",AutoSaveCall(runtime,project).at("persistence").To<std::string>());EXPECT_EQ("Journal",AutoSaveCall(runtime,project).at("persistence").To<std::string>());
    // Same-version metadata on a dependency must remain part of the exact
    // comparison even when root count, root URL and root version do not change.
    project->Stop();const auto childUrl=resources.MakeNamedResourceURL("checkpoint/dependency");auto childInfo=info;childInfo.nVersion=1;resources.Set(childUrl,std::make_shared<AutoSaveTestPayload>(),childInfo);info.nVersion=3;info.Dependencies={{childUrl,1}};resources.Set(url,changed,info);project->Start();EXPECT_EQ("Snapshot",AutoSaveCall(runtime,project).at("persistence").To<std::string>());project->Stop();childInfo=*resources.GetInfo(childUrl);childInfo.Metadata["closure-child"]="changed";ASSERT_TRUE(resources.UpdateInfo(childUrl,childInfo));project->Start();const auto closureSaved=AutoSaveCall(runtime,project);EXPECT_EQ("Snapshot",closureSaved.at("persistence").To<std::string>());EXPECT_GE(closureSaved.at("checkpointMilliseconds").To<double>(),0);EXPECT_EQ("Journal",AutoSaveCall(runtime,project).at("persistence").To<std::string>());
    project->Stop();project->CloseQuickSaveLog();project->Start();EXPECT_EQ("Snapshot",AutoSaveCall(runtime,project).at("persistence").To<std::string>());runtime->Stop();runtime->CloseProjectCatalog(catalog->GetCatalogID());RemoveProjectFiles(path);
}

