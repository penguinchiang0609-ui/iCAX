<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'TubeDesignerTest'">
    <ICAXInspectionBridgeSource>$(MSBuildProjectDirectory)\TubeCadStepAcceptance.cpp</ICAXInspectionBridgeSource>
    <ICAXInspectionBridgeOutputRoot>$(SolutionDir)..\output\tests\tube-cad-step\native</ICAXInspectionBridgeOutputRoot>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)SecurityWindowFramesBridge.targets" />
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'TubeDesignerTest'">
    <TargetName>TubeCadStepAcceptance</TargetName>
    <TargetPath>$(OutDir)$(TargetName)$(TargetExt)</TargetPath>
  </PropertyGroup>
  <ItemGroup><ClCompile Update="$(ICAXInspectionBridgeSource)"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile></ItemGroup>
</Project>
