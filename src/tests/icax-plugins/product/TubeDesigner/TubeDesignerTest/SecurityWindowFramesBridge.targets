<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'TubeDesignerTest'">
    <TargetName>SecurityWindowFramesBridge</TargetName>
    <OutDir>$(SolutionDir)..\tmp\security-window-frames-native\</OutDir>
    <IntDir>$(SolutionDir)..\tmp\security-window-frames-native\obj\</IntDir>
    <OutDir Condition="'$(ICAXInspectionBridgeOutputRoot)' != ''">$(ICAXInspectionBridgeOutputRoot)\</OutDir>
    <IntDir Condition="'$(ICAXInspectionBridgeOutputRoot)' != ''">$(ICAXInspectionBridgeOutputRoot)\obj\</IntDir>
    <ICAXInspectionBridgeSource Condition="'$(ICAXInspectionBridgeSource)' == ''">$(MSBuildProjectDirectory)\SecurityWindowFramesBridge.cpp</ICAXInspectionBridgeSource>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'TubeDesignerTest'">
    <ClCompile Remove="@(ClCompile)" />
    <ClCompile Include="$(MSBuildProjectDirectory)\..\..\..\..\pch.cpp"><PrecompiledHeader>Create</PrecompiledHeader></ClCompile>
    <ClCompile Include="$(ICAXInspectionBridgeSource)">
      <AdditionalIncludeDirectories>$(MSBuildProjectDirectory)\..\..\..\..\..\iCAX-Plugins\render;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- This source embeds the real SDO fixtures and their inline component
           metadata. Match the optimized Debug settings used by TubeDesignerTest
           so unoptimized EXE registrations cannot replace the DLL handlers. -->
      <Optimization Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">MaxSpeed</Optimization>
      <InlineFunctionExpansion Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">AnySuitable</InlineFunctionExpansion>
      <BasicRuntimeChecks Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">Default</BasicRuntimeChecks>
      <DebugInformationFormat Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">ProgramDatabase</DebugInformationFormat>
      <SupportJustMyCode Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">false</SupportJustMyCode>
      <PrecompiledHeader Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">NotUsing</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>
</Project>
