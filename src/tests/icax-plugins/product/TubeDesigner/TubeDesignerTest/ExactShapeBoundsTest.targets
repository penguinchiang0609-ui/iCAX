<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'TubeDesignerTest'">
    <ICAXInspectionBridgeSource>$(MSBuildProjectDirectory)\ExactShapeBoundsTest.cpp</ICAXInspectionBridgeSource>
    <ICAXInspectionBridgeOutputRoot>$(SolutionDir)..\output\tests\cad-shape-bounds\native</ICAXInspectionBridgeOutputRoot>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)SecurityWindowFramesBridge.targets" />
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'TubeDesignerTest'">
    <TargetName>ExactShapeBoundsTest</TargetName>
    <TargetPath>$(OutDir)$(TargetName)$(TargetExt)</TargetPath>
  </PropertyGroup>
  <ItemGroup><ClCompile Update="$(ICAXInspectionBridgeSource)"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile></ItemGroup>
  <ItemDefinitionGroup><PostBuildEvent><Command></Command></PostBuildEvent></ItemDefinitionGroup>
</Project>
