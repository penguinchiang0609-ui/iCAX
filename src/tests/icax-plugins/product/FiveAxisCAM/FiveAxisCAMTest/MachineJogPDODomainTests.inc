namespace {
    Map JogStart(Scene& scene,const ProductPlanMachine& machine,const Text& token,ID joint={},double direction=1,double speed=10){return Invoke(&scene,"CamSimulation","StartMachineJog",{{"token",token},{"expected",Read(scene).at("expected")},{"setupId",Read(scene).at("activeSetupId")},{"jointId",iCAX::Data::to_string(joint.is_nil()?machine.X:joint)},{"direction",direction},{"speed",speed}});}
    Map JogStop(Scene& scene,const Text& token){return Invoke(&scene,"CamSimulation","StopMachineJog",{{"token",token}});}
    void JogWrite(Scene& scene,const Map& begin,UInt seq,bool held,const Text& overrideEpoch={}){
        flatbuffers::FlatBufferBuilder b;const auto token=begin.at("token").To<Text>(),epoch=overrideEpoch.empty()?begin.at("epoch").To<Text>():overrideEpoch;const auto record=CreateMachineJogControlDirect(b,1,token.c_str(),epoch.c_str(),seq,held);FinishMachineJogControlBuffer(b,record);
        auto lease=iCAX::PDO::CPDOWriteLease::TryBeginIfNewer(scene.PDOHub().GetSlot(PDOIDOf(begin,"controlPDO")),seq);if(!lease)throw std::runtime_error("Jog control busy");std::memcpy(lease->Data(),b.GetBufferPointer(),b.GetSize());lease->Commit(b.GetSize());
    }
    Map JogRead(Scene& scene,const Map& begin){
        iCAX::PDO::CPDOReadLease lease(scene.PDOHub().GetSlot(PDOIDOf(begin,"resultPDO")));flatbuffers::Verifier v(static_cast<const std::uint8_t*>(lease.Data()),lease.PayloadSize());if(!VerifyMachineJogResultBuffer(v))throw std::runtime_error("Jog result invalid");const auto r=GetMachineJogResult(lease.Data());return {{"status",r->status()->str()},{"sequence",std::to_string(r->result_sequence())},{"processed",std::to_string(r->processed_sequence())},{"positions",PDONumbers(*r->positions())},{"world",PDONumbers(*r->world_matrices())},{"ticks",std::to_string(r->ticks())},{"collisionMs",r->collision_ms()},{"tickMs",r->tick_ms()},{"intervalMs",r->interval_ms()}};
    }
    Map JogTick(Scene& scene,const Map& begin,double dt=.016){scene.PDOHub().SwapInSlot();PumpMachineJog(scene,dt);scene.PDOHub().SwapOutSlot();return JogRead(scene,begin);}
    auto JogRuntime(Scene& scene){return std::dynamic_pointer_cast<CFiveAxisSceneComponent>(scene.Database().GetMetaEntity()->GetComponent(CFiveAxisSceneComponent::S_ClassName))->Runtime;}
}
TEST(FiveAxisMachineJogPDO, NoMotionBeforeFirstHeldAndLatestReleaseWinsWithoutAHistoryEntry)
{
    Scene scene(iCAX::Data::GenerateNewUUID(),iCAX::Data::GenerateNewUUID(),true,false,true);PrepareProductPlanPaths(scene);const auto machine=CreateProductPlanMachine(scene);const auto history=scene.Database().GetUndoArray().size();const auto token=PDOEditToken();const auto begin=JogStart(scene,machine,token);ASSERT_EQ("Running",begin.at("status").To<Text>());scene.PDOHub().SwapOutSlot();
    for(int i=0;i<3;++i){EXPECT_EQ("Running",JogTick(scene,begin).at("status").To<Text>());EXPECT_DOUBLE_EQ(0,PDOJoint(scene,machine.X));}
    JogWrite(scene,begin,1,true);JogWrite(scene,begin,2,true);JogWrite(scene,begin,3,false);const auto stopped=JogTick(scene,begin);EXPECT_EQ("Stopped",stopped.at("status").To<Text>());EXPECT_EQ("3",stopped.at("processed").To<Text>());EXPECT_DOUBLE_EQ(0,PDOJoint(scene,machine.X));const auto end=JogStop(scene,token);EXPECT_FALSE(end.at("changed").To<bool>());EXPECT_EQ(end,JogStop(scene,token));EXPECT_EQ(history,scene.Database().GetUndoArray().size());EXPECT_FALSE(scene.PDOHub().HasSlot(PDOIDOf(begin,"controlPDO")));EXPECT_FALSE(scene.PDOHub().HasSlot(PDOIDOf(begin,"resultPDO")));EXPECT_THROW(Invoke(&scene,"CamSimulation","KeepMachineJog",{{"token",token}}),std::exception);
}
TEST(FiveAxisMachineJogPDO, HeldStateDrivesExactNativeFramesOneHistoryAndReopenAndFollowingSupport)
{
    const auto id=iCAX::Data::GenerateNewUUID();Scene scene(id,id,true,false,true);PrepareProductPlanPaths(scene);const auto machine=CreateProductPlanMachine(scene);auto& moveSupport=scene.Database().BeginTransaction("Moving support");moveSupport.ModifyComponent(machine.Support,"CTransformComponent",{{"ParentEntityID",machine.X}});ASSERT_TRUE(scene.Database().CommitTransaction(moveSupport));const auto history=scene.Database().GetUndoArray().size();const auto token=PDOEditToken();const auto begin=JogStart(scene,machine,token);scene.PDOHub().SwapOutSlot();JogWrite(scene,begin,1,true);
    Map last;for(int i=0;i<5;++i){last=JogTick(scene,begin);ASSERT_EQ("Running",last.at("status").To<Text>());}const auto q=PDOJoint(scene,machine.X);EXPECT_NEAR(.8,q,1e-12);EXPECT_EQ("5",last.at("ticks").To<Text>());EXPECT_EQ("1",last.at("processed").To<Text>());EXPECT_GE(last.at("tickMs").To<double>(),0);EXPECT_GE(last.at("collisionMs").To<double>(),0);
    const auto ids=begin.at("jointIds").To<Array>(),worldIDs=begin.at("worldIds").To<Array>(),world=last.at("world").To<Array>(),initial=begin.at("worldMatrices").To<Array>();ASSERT_GT(worldIDs.size(),ids.size());ASSERT_EQ(worldIDs.size()*16,world.size());for(std::size_t i=0;i<worldIDs.size();++i)if(worldIDs[i].To<Text>()==iCAX::Data::to_string(machine.Support)||i>=ids.size())EXPECT_NEAR(initial[i*16+3].To<double>()+q,world[i*16+3].To<double>(),1e-12);
    JogWrite(scene,begin,2,false);EXPECT_EQ("Stopped",JogTick(scene,begin).at("status").To<Text>());EXPECT_DOUBLE_EQ(q,PDOJoint(scene,machine.X));const auto end=JogStop(scene,token);EXPECT_TRUE(end.at("changed").To<bool>());EXPECT_EQ(last.at("positions"),end.at("positions"));EXPECT_EQ(last.at("world"),end.at("worldMatrices"));EXPECT_EQ(history+1,scene.Database().GetUndoArray().size());ASSERT_TRUE(scene.Database().Undo());EXPECT_DOUBLE_EQ(0,PDOJoint(scene,machine.X));ASSERT_TRUE(scene.Database().Redo());EXPECT_DOUBLE_EQ(q,PDOJoint(scene,machine.X));
    const auto path=std::filesystem::path("C:/icax-machine-kinematics/ik-pdo-native/jog-committed.i5cam");SaveProductPlanFixture(scene,path);iCAX::ProjectFile::CProjectFile file({.Magic="ICAX_FIVE_AXIS_CAM",.ProductID="icax.five-axis-cam",.CurrentFormatVersion="0.1",.nCurrentFormatRevision=1});Scene reopened(id,id,false);file.Open(path,reopened.Database(),reopened.Resources());InitializeScene(reopened);EXPECT_DOUBLE_EQ(q,PDOJoint(reopened,machine.X));
}
TEST(FiveAxisMachineJogPDO, RepeatedHeldVersionCannotRenewDeadManLeaseAndStopKeepsFinalActualFacts)
{
    Scene scene(iCAX::Data::GenerateNewUUID(),iCAX::Data::GenerateNewUUID(),true,false,true);PrepareProductPlanPaths(scene);const auto machine=CreateProductPlanMachine(scene);const auto token=PDOEditToken();const auto history=scene.Database().GetUndoArray().size();const auto begin=JogStart(scene,machine,token);scene.PDOHub().SwapOutSlot();JogWrite(scene,begin,1,true);JogTick(scene,begin);const auto q=PDOJoint(scene,machine.X);std::this_thread::sleep_for(std::chrono::milliseconds(330));const auto expired=JogTick(scene,begin);EXPECT_EQ("Expired",expired.at("status").To<Text>());EXPECT_DOUBLE_EQ(q,PDOJoint(scene,machine.X));EXPECT_EQ(history+1,scene.Database().GetUndoArray().size());EXPECT_EQ("Expired",JogTick(scene,begin).at("status").To<Text>());const auto end=JogStop(scene,token);EXPECT_TRUE(end.at("changed").To<bool>());EXPECT_EQ("Expired",end.at("status").To<Text>());EXPECT_EQ(expired.at("positions"),end.at("positions"));EXPECT_EQ(expired.at("world"),end.at("worldMatrices"));EXPECT_EQ(end,JogStart(scene,machine,token));EXPECT_EQ(history+1,scene.Database().GetUndoArray().size());
}
TEST(FiveAxisMachineJogPDO, ActualCollisionAndJointLimitStopBeforeUnsafeStepAndCommitOnlyAcceptedTicks)
{
    Scene scene(iCAX::Data::GenerateNewUUID(),iCAX::Data::GenerateNewUUID(),true,false,true);PrepareProductPlanPaths(scene);const auto machine=CreateProductPlanMachine(scene);ASSERT_EQ("Ready",NumericMachineIK(scene,machine,10).at("status").To<Text>());const auto history=scene.Database().GetUndoArray().size();const auto token=PDOEditToken();const auto begin=JogStart(scene,machine,token,machine.Tool,-1,100);ASSERT_EQ("Running",begin.at("status").To<Text>());scene.PDOHub().SwapOutSlot();Map last;
    for(UInt i=1;i<=30;++i){JogWrite(scene,begin,i,true);last=JogTick(scene,begin,.02);if(last.at("status").To<Text>()!="Running")break;}EXPECT_EQ("Blocked",last.at("status").To<Text>());const auto q=PDOJoint(scene,machine.Tool);EXPECT_GT(q,-6);const auto end=JogStop(scene,token);EXPECT_TRUE(end.at("changed").To<bool>());EXPECT_EQ(last.at("positions"),end.at("positions"));EXPECT_EQ("Blocked",end.at("collisionStatus").To<Text>());ASSERT_TRUE(end.contains("collisionPairs"));EXPECT_FALSE(end.at("collisionPairs").To<Array>().empty());EXPECT_EQ(end,JogStop(scene,token));EXPECT_EQ(history+1,scene.Database().GetUndoArray().size());ASSERT_TRUE(scene.Database().Undo());EXPECT_DOUBLE_EQ(30,PDOJoint(scene,machine.Tool));
    auto& tx=scene.Database().BeginTransaction("Near X limit");tx.ModifyComponent(machine.X,"CMachineJointComponent",{{"UpperLimit",PDOJoint(scene,machine.X)+.25}});ASSERT_TRUE(scene.Database().CommitTransaction(tx));const auto limitToken=PDOEditToken();const auto limited=JogStart(scene,machine,limitToken);scene.PDOHub().SwapOutSlot();JogWrite(scene,limited,1,true);EXPECT_EQ("Running",JogTick(scene,limited,.02).at("status").To<Text>());const auto stopped=JogTick(scene,limited,.02);EXPECT_EQ("Limit",stopped.at("status").To<Text>());EXPECT_EQ("Limit",JogStop(scene,limitToken).at("status").To<Text>());
}
TEST(FiveAxisMachineJogPDO, ForeignStopIsIsolatedInvalidEpochEndsOnceAndLeasedSlotsRetireWithoutBlocking)
{
    Scene scene(iCAX::Data::GenerateNewUUID(),iCAX::Data::GenerateNewUUID(),true,false,true);PrepareProductPlanPaths(scene);const auto machine=CreateProductPlanMachine(scene);const auto token=PDOEditToken(),foreign=PDOEditToken();const auto begin=JogStart(scene,machine,token);scene.PDOHub().SwapOutSlot();const auto retired=JogStop(scene,foreign);EXPECT_FALSE(retired.at("changed").To<bool>());EXPECT_EQ(retired,JogStart(scene,machine,foreign));EXPECT_TRUE(scene.PDOHub().HasSlot(PDOIDOf(begin,"controlPDO")));JogWrite(scene,begin,1,true);EXPECT_EQ("Running",JogTick(scene,begin).at("status").To<Text>());const auto q=PDOJoint(scene,machine.X);JogWrite(scene,begin,2,true,PDOEditToken());const auto error=JogTick(scene,begin);EXPECT_EQ("Error",error.at("status").To<Text>());EXPECT_DOUBLE_EQ(q,PDOJoint(scene,machine.X));
    iCAX::PDO::CPDOReadLease held(scene.PDOHub().GetSlot(PDOIDOf(begin,"resultPDO")));EXPECT_TRUE(JogStop(scene,token).at("changed").To<bool>());EXPECT_TRUE(scene.PDOHub().HasSlot(PDOIDOf(begin,"resultPDO")));held.Release();PumpMachineJog(scene,.016);EXPECT_FALSE(scene.PDOHub().HasSlot(PDOIDOf(begin,"resultPDO")));
}
TEST(FiveAxisMachineJogPDO, InitialCollisionStartsNoScopeAndSceneReleaseEndsActiveJogAndRetiresBothSlots)
{
    Scene scene(iCAX::Data::GenerateNewUUID(),iCAX::Data::GenerateNewUUID(),true,false,true);PrepareProductPlanPaths(scene);const auto machine=CreateProductPlanMachine(scene);const auto token=PDOEditToken();const auto begin=JogStart(scene,machine,token);scene.PDOHub().SwapOutSlot();
    EXPECT_THROW(PDOBegin(scene,machine,PDOEditToken()),std::exception);
    EXPECT_THROW(NumericMachineIK(scene,machine,1),std::exception);
    JogWrite(scene,begin,1,true);JogTick(scene,begin);const auto q=PDOJoint(scene,machine.X);ReleaseMachineJog(scene,JogRuntime(scene));EXPECT_DOUBLE_EQ(q,PDOJoint(scene,machine.X));EXPECT_FALSE(scene.PDOHub().HasSlot(PDOIDOf(begin,"controlPDO")));EXPECT_FALSE(scene.PDOHub().HasSlot(PDOIDOf(begin,"resultPDO")));ASSERT_TRUE(scene.Database().Undo());EXPECT_DOUBLE_EQ(0,PDOJoint(scene,machine.X));
    auto& tx=scene.Database().BeginTransaction("Initial material collision");tx.ModifyComponent(machine.Tool,"CMachineCollisionComponent",{{"Collisions",PlanBox(0,0,0,.1)}});ASSERT_TRUE(scene.Database().CommitTransaction(tx));const auto history=scene.Database().GetUndoArray().size();const auto badToken=PDOEditToken();const auto blocked=JogStart(scene,machine,badToken);EXPECT_EQ("Blocked",blocked.at("status").To<Text>());EXPECT_FALSE(blocked.at("active").To<bool>());EXPECT_FALSE(blocked.contains("controlPDO"));EXPECT_EQ(blocked.at("jointIds").To<Array>().size(),blocked.at("positions").To<Array>().size());EXPECT_FALSE(JogStop(scene,badToken).at("changed").To<bool>());EXPECT_EQ(history,scene.Database().GetUndoArray().size());
}
