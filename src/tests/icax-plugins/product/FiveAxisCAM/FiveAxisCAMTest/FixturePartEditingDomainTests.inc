namespace fixture_part_edit_tests {
namespace G=iCAX::GeometryData;
namespace J=iCAX::CAD::TubeCadJson;
using Profile=G::Tube::CPlanarRegion2;
Map Unit(Scene& scene,const Variant& id){for(const auto& value:Read(scene).at("fixtureUnits").To<Array>())if(value.To<Map>().at("id")==id)return value.To<Map>();throw std::runtime_error("Fixture editing test unit missing");}
Map Part(Scene& scene,const Variant& id){for(const auto& value:Read(scene).at("fixtures").To<Array>())if(value.To<Map>().at("id")==id)return value.To<Map>();throw std::runtime_error("Fixture editing test part missing");}
Map AssemblyPart(Scene& scene,const Variant& unitID,const Variant& partID){for(const auto& value:Unit(scene,unitID).at("design").To<Map>().at("assembly").To<Map>().at("parts").To<Array>())if(value.To<Map>().at("partId")==partID)return value.To<Map>();throw std::runtime_error("Fixture editing test assembly part missing");}
Map Request(Scene& scene,const Variant& unitID,const Variant& partID,const Variant& geometryRef={}){auto request=FixtureRequest(scene);request["unitId"]=unitID;request["partId"]=partID;if(!geometryRef.Is<std::monostate>())request["geometryRef"]=geometryRef;return request;}
Map Prepare(Scene& scene,bool joined=true,bool cutting=false){
    File source(cutting?RecognitionPart():BRepBuilderAPI_MakeFace(gp_Pln(gp_Pnt(0,0,0),gp_Dir(0,0,1)),-60,60,-60,60).Shape());const auto placement=Imported(scene,source);Variant cut;
    if(cutting){cut=ConfirmWithPolicies(scene,0.,&placement,0).at("createdIntentIds").To<Array>().front();ZeroGenerationPolicies(scene,{cut});}
    auto recipe=joined?JointRecipe(scene):PlateRecipe(scene);recipe["baseDrop"]=80.;recipe["windowMode"]=Text("Automatic");recipe["windowWeb"]=8.;recipe["cutClearanceMode"]=Text("None");
    if(!joined){Array stations;for(double x:{-12.,12.})stations.emplace_back(Map{{"id",iCAX::Data::to_string(iCAX::Data::GenerateNewUUID())},{"coordinate",x}});recipe["stations"]=stations;}
    SetPlateRecipe(scene,recipe);const auto candidate=GeneratePlates(scene);AdoptPlates(scene,candidate);const auto unit=Read(scene).at("fixtureUnits").To<Array>().front().To<Map>();
    Variant base,support;for(const auto& value:unit.at("design").To<Map>().at("assembly").To<Map>().at("parts").To<Array>()){const auto part=value.To<Map>();if(part.at("role").To<Text>()=="Base")base=part.at("partId");else if(support.Is<std::monostate>())support=part.at("partId");}
    return {{"unitId",unit.at("id")},{"baseId",base},{"supportId",support},{"cutId",cut}};
}
Text Bytes(const std::filesystem::path& path){std::ifstream file(path,std::ios::binary);if(!file)throw std::runtime_error("Fixture editing output missing: "+path.string());return {(std::istreambuf_iterator<char>(file)),{}};}
std::filesystem::path Folder(){const auto path=std::filesystem::current_path()/("fixture-part-edit-"+iCAX::Data::to_string(iCAX::Data::GenerateNewUUID()));std::filesystem::create_directory(path);return path;}
std::uint64_t Version(const Map& ref){const auto& value=ref.at("version");return value.Is<Text>()?std::stoull(value.To<Text>()):value.To<UInt>();}
TopoDS_Shape Solid(Scene& scene,const Map& part){const auto ref=part.at("geometryRef").To<Map>();const auto model=scene.Resources().Get<G::BRepModel>(ref.at("url").To<Text>(),Version(ref));if(!model)throw std::runtime_error("Edited fixture BRep missing");const auto built=iCAX::OpenCascade::BuildOpenCascadeShape(*model);if(!built.bOK)throw std::runtime_error("Edited fixture BRep invalid");return built.Shape;}
double Volume(const TopoDS_Shape& shape){GProp_GProps mass;BRepGProp::VolumeProperties(shape,mass);return std::abs(mass.Mass());}
void Preview(Scene& scene,const Map& part){
    const auto ref=part.at("previewRef").To<Map>();const auto resource=scene.Resources().Get<iCAX::Resource::CFlatBufferResource>(ref.at("url").To<Text>(),Version(ref));ASSERT_TRUE(resource);const auto bytes=resource->Bytes();ASSERT_GE(bytes.size(),8u);EXPECT_EQ(Text(reinterpret_cast<const char*>(bytes.data()+4),4),"ICRG");
    using namespace state_transport_tests;const auto root=U32(bytes,0);const auto positions=Target(bytes,Field(bytes,root,5)),indices=Target(bytes,Field(bytes,root,9));const auto values=U32(bytes,positions),count=U32(bytes,indices);ASSERT_GT(values,0u);ASSERT_EQ(values%3,0u);ASSERT_GT(count,0u);ASSERT_LE(positions+4+values*4,bytes.size());ASSERT_LE(indices+4+count*4,bytes.size());for(size_t i=0;i<count;++i)EXPECT_LT(U32(bytes,indices+4+i*4),values/3);
}
void Reopen(Scene& scene,const std::filesystem::path& path){
    const auto before=Read(scene);iCAX::ProjectFile::CProjectFile file({.Magic="ICAX_FIVE_AXIS_CAM",.ProductID="icax.five-axis-cam",.CurrentFormatVersion="0.1",.nCurrentFormatRevision=1});iCAX::ProjectFile::CProjectDocumentInfo info;info.ProjectID=scene.Project;info.MainSceneID=scene.GetSceneID();info.ProjectName="单板编辑原生验收";file.Save(path,info,scene.Database(),scene.Resources());
    Scene reopened(scene.Project,scene.GetSceneID(),false);file.Open(path,reopened.Database(),reopened.Resources());InitializeScene(reopened);const auto after=Read(reopened);EXPECT_EQ(before.at("fixtures"),after.at("fixtures"));EXPECT_EQ(before.at("fixtureUnits"),after.at("fixtureUnits"));EXPECT_EQ(before.at("setups"),after.at("setups"));for(const auto& value:after.at("fixtures").To<Array>())Preview(reopened,value.To<Map>());
}
void Reject(Scene& scene,const Map& request,const Text& code={},const Text& method="PartUpdate"){
    const auto before=Read(scene);const auto resources=scene.Resources().Count();const auto undo=scene.Database().GetUndoArray(),redo=scene.Database().GetRedoArray();
    try{Invoke(&scene,"CamFixture",method,request);FAIL()<<"Invalid single-plate edit was accepted";}catch(const std::exception& error){if(!code.empty())EXPECT_NE(Text(error.what()).find(code),Text::npos)<<error.what();}
    EXPECT_EQ(before,Read(scene));EXPECT_EQ(resources,scene.Resources().Count());EXPECT_EQ(undo,scene.Database().GetUndoArray());EXPECT_EQ(redo,scene.Database().GetRedoArray());
}
G::Tube::SRegionLoop2 Circle(const Text& id,double x,double y,double radius){G::Circle2 circle;circle.Placement.Location={x,y};circle.Radius=radius;return {id,{{id+"/circle",{circle,{0.,2*std::numbers::pi,true}}}}};}
struct Window {size_t Index=0;double X=0,Y=0,Radius=0,Area=0,Width=0,Height=0;};
Window EditableWindow(const Map& part,size_t ordinal=0){const auto indices=part.at("windowHoleIndices").To<Array>();if(ordinal>=indices.size())throw std::runtime_error("Generated fixture needs an editable automatic window");const auto index=static_cast<size_t>(indices[ordinal].To<UInt>());const auto points=part.at("holes").To<Array>()[index].To<Array>();double x0=1e100,y0=1e100,x1=-1e100,y1=-1e100;for(const auto& value:points){const auto point=value.To<Array>();x0=std::min(x0,point[0].To<double>());y0=std::min(y0,point[1].To<double>());x1=std::max(x1,point[0].To<double>());y1=std::max(y1,point[1].To<double>());}return {index,(x0+x1)/2,(y0+y1)/2,std::min(x1-x0,y1-y0)/4,JointArea(points),x1-x0,y1-y0};}
G::Tube::SRegionLoop2 ExpandedRectangle(const Text& id,const Window& window,double outward){
    const double x0=window.X-window.Width/2-outward,y0=window.Y-window.Height/2-outward,x1=window.X+window.Width/2+outward,y1=window.Y+window.Height/2+outward;
    const std::array<G::Point2,4> points{{{x0,y0},{x0,y1},{x1,y1},{x1,y0}}};G::Tube::SRegionLoop2 result;result.ID=id;for(size_t i=0;i<4;++i)result.Curves.push_back({id+"/expanded/"+std::to_string(i),{G::Segment2{points[i],points[(i+1)%4]},{0,1,false}}});return result;
}
Map ReadProfile(Scene& scene,const Map& ids){return FixtureProfileDetails(scene,Request(scene,ids.at("unitId"),ids.at("baseId")));}
void CheckProtected(const Map& original,const Map& after){const auto old=J::Decode<Profile>(original.at("profile")),now=J::Decode<Profile>(after.at("profile"));for(const auto& value:original.at("protectedBoundaryIds").To<Array>()){const auto id=value.To<Text>();const auto a=std::find_if(old.Boundaries.begin(),old.Boundaries.end(),[&](const auto& loop){return loop.ID==id;}),b=std::find_if(now.Boundaries.begin(),now.Boundaries.end(),[&](const auto& loop){return loop.ID==id;});ASSERT_NE(a,old.Boundaries.end());ASSERT_NE(b,now.Boundaries.end());EXPECT_EQ(J::Encode(*a),J::Encode(*b))<<id;}}
Map Edit(Scene& scene,const Map& ids,const Profile& profile,const Variant& geometryRef){auto request=Request(scene,ids.at("unitId"),ids.at("baseId"),geometryRef);request["profile"]=J::Encode(profile);const auto result=Invoke(&scene,"CamFixture","PartUpdate",request);const auto resources=scene.Resources().Count();EXPECT_EQ(result,Invoke(&scene,"CamFixture","PartUpdate",request));EXPECT_EQ(resources,scene.Resources().Count());return result;}
}

TEST(FiveAxisFixturePartEditing, OneSupportTogglePreservesAssemblyAndFiltersRenderingAndManufacturing){
    using namespace fixture_part_edit_tests;Scene scene;const auto ids=Prepare(scene,false,true),before=Read(scene);const auto unitID=ids.at("unitId"),partID=ids.at("supportId");const auto original=Part(scene,partID),assembly=Unit(scene,unitID).at("design").To<Map>().at("assembly").To<Map>();
    Reject(scene,FixtureRequest(scene,partID.To<Text>()),"CAM_FIXTURE_GENERATED_PART_DISABLE_ONLY","Remove");
    auto off=FixtureRequest(scene,partID.To<Text>());off["enabled"]=false;Invoke(&scene,"CamFixture","Update",off);const auto disabled=Read(scene);ASSERT_EQ(before.at("fixtures").To<Array>().size(),disabled.at("fixtures").To<Array>().size());const auto hidden=Part(scene,partID);EXPECT_FALSE(hidden.at("enabled").To<bool>());EXPECT_EQ(original.at("geometryRef"),hidden.at("geometryRef"));EXPECT_EQ(original.at("previewRef"),hidden.at("previewRef"));EXPECT_EQ(original.at("transform"),hidden.at("transform"));
    const auto entity=scene.Database().GetEntity(*ID::from_string(partID.To<Text>()));ASSERT_TRUE(entity);const auto render=entity->GetComponent("CRenderInstanceComponent");ASSERT_TRUE(render);EXPECT_FALSE(render->GetProperty("Visible").To<bool>());
    for(const auto& value:before.at("fixtures").To<Array>()){const auto old=value.To<Map>();if(old.at("id")!=partID)EXPECT_EQ(old,Part(scene,old.at("id")));}EXPECT_EQ(assembly.at("joinery"),Unit(scene,unitID).at("design").To<Map>().at("assembly").To<Map>().at("joinery"));
    ASSERT_TRUE(scene.Database().Undo());PumpTasks(scene);EXPECT_EQ(before.at("fixtures"),Read(scene).at("fixtures"));ASSERT_TRUE(scene.Database().Redo());PumpTasks(scene);EXPECT_EQ(disabled.at("fixtures"),Read(scene).at("fixtures"));const auto folder=Folder();Reopen(scene,folder/"disabled.i5cam");
    auto manufacture=FixtureRequest(scene);manufacture["unitId"]=unitID;const auto list=FixtureBreakdownDetails(scene,manufacture);ASSERT_EQ(list.at("parts").To<Array>().size(),before.at("fixtures").To<Array>().size()-1);Text omitted;for(const auto& value:assembly.at("parts").To<Array>())if(value.To<Map>().at("partId")==partID)omitted=value.To<Map>().at("number").To<Text>();
    manufacture=FixtureRequest(scene);manufacture["unitId"]=unitID;manufacture["destination"]=folder.string();const auto delivery=Invoke(&scene,"CamFixture","Export",manufacture);const auto directory=std::filesystem::path(delivery.at("directory").To<Text>());EXPECT_FALSE(std::filesystem::exists(directory/(omitted+".dxf")));const auto manifest=iCAX::TemplateRuntime::CStandardJsonCodec::Parse(Bytes(directory/"manifest.json")).To<Map>();EXPECT_EQ(manifest.at("parts").To<Array>().size(),list.at("parts").To<Array>().size());std::set<Text> actualIDs,expectedIDs;for(const auto& value:manifest.at("parts").To<Array>()){EXPECT_NE(value.To<Map>().at("partId"),partID);actualIDs.insert(value.To<Map>().at("partId").To<Text>());}for(const auto& value:list.at("parts").To<Array>())expectedIDs.insert(value.To<Map>().at("partId").To<Text>());EXPECT_EQ(actualIDs,expectedIDs);
    EXPECT_EQ(Bytes(directory/"parts.csv").find(","+partID.To<Text>()+","),Text::npos);EXPECT_EQ(Bytes(directory/"assembly.svg").find(">"+omitted+" ·"),Text::npos);EXPECT_EQ(Bytes(directory/"assembly.pdf").find("Fixture assembly - "+omitted+")"),Text::npos);EXPECT_EQ(Bytes(directory/"assembly.pdf").find("("+omitted+") Tj"),Text::npos);
    EXPECT_NE(Bytes(directory/"assembly.pdf").find("/Type /Pages /Count "+std::to_string(expectedIDs.size())),Text::npos);
    auto unitOff=FixtureRequest(scene);unitOff["unitId"]=unitID;unitOff["enabled"]=false;Invoke(&scene,"CamFixture","UnitUpdate",unitOff);for(const auto& value:Read(scene).at("fixtures").To<Array>())EXPECT_FALSE(value.To<Map>().at("enabled").To<bool>());
    auto unitOn=FixtureRequest(scene);unitOn["unitId"]=unitID;unitOn["enabled"]=true;Invoke(&scene,"CamFixture","UnitUpdate",unitOn);for(const auto& value:Read(scene).at("fixtures").To<Array>()){const auto part=value.To<Map>();EXPECT_EQ(part.at("enabled").To<bool>(),part.at("id")!=partID);}
    auto on=FixtureRequest(scene,partID.To<Text>());on["enabled"]=true;Invoke(&scene,"CamFixture","Update",on);EXPECT_TRUE(Part(scene,partID).at("enabled").To<bool>());EXPECT_EQ(original.at("geometryRef"),Part(scene,partID).at("geometryRef"));EXPECT_EQ(original.at("previewRef"),Part(scene,partID).at("previewRef"));EXPECT_TRUE(render->GetProperty("Visible").To<bool>());Reopen(scene,folder/"enabled.i5cam");RecordProperty("enabled_manufacturing_parts",static_cast<int>(list.at("parts").To<Array>().size()));
}

TEST(FiveAxisFixturePartEditing, ExactCircleWindowEditsReplaceOnlyOnePlateAndSurviveHistoryReopenAndDXF){
    using namespace fixture_part_edit_tests;Scene scene;const auto ids=Prepare(scene);const auto unitID=ids.at("unitId"),partID=ids.at("baseId");const auto before=Read(scene),original=AssemblyPart(scene,unitID,partID),source=ReadProfile(scene,ids);const auto originalParts=Unit(scene,unitID).at("design").To<Map>().at("assembly").To<Map>().at("parts").To<Array>();auto profile=J::Decode<Profile>(source.at("profile"));const auto windows=original.at("windowHoleIndices").To<Array>();ASSERT_GE(windows.size(),2u);const auto first=EditableWindow(original),last=EditableWindow(original,windows.size()-1);ASSERT_NE(first.Index,last.Index);ASSERT_GT(first.Radius,0.5);const double thickness=original.at("thickness").To<double>(),initialVolume=Volume(Solid(scene,original));
    // Eight millimetres is the automatic layout choice. A manual edit may
    // expand that opening while retaining the recipe's five millimetre band.
    ASSERT_NEAR(first.Area,first.Width*first.Height,1e-7);auto expanded=profile;expanded.Boundaries[first.Index+1]=ExpandedRectangle(expanded.Boundaries[first.Index+1].ID,first,.5);Edit(scene,ids,expanded,source.at("geometryRef"));const auto expandedPart=AssemblyPart(scene,unitID,partID);
    EXPECT_NEAR(Volume(Solid(scene,expandedPart)),initialVolume-((first.Width+1)*(first.Height+1)-first.Area)*thickness,1e-5);const auto expandedWire=WindowWire(expandedPart,expandedPart.at("holes").To<Array>()[first.Index].To<Array>()),outerWire=WindowWire(expandedPart,expandedPart.at("outline").To<Array>());BRepExtrema_DistShapeShape border(expandedWire,outerWire);ASSERT_TRUE(border.IsDone());double retainedBand=border.Value();EXPECT_GE(retainedBand,5-1e-7);
    for(size_t i=0;i<expandedPart.at("holes").To<Array>().size();++i)if(i!=first.Index){BRepExtrema_DistShapeShape distance(expandedWire,WindowWire(expandedPart,expandedPart.at("holes").To<Array>()[i].To<Array>()));ASSERT_TRUE(distance.IsDone());retainedBand=std::min(retainedBand,distance.Value());EXPECT_GE(distance.Value(),5-1e-7);}RecordProperty("manual_expansion_each_side_mm","0.5");RecordProperty("manual_remaining_band_mm",std::to_string(retainedBand));
    ASSERT_TRUE(scene.Database().Undo());PumpTasks(scene);EXPECT_EQ(before.at("fixtures"),Read(scene).at("fixtures"));EXPECT_EQ(before.at("fixtureUnits"),Read(scene).at("fixtureUnits"));
    profile.Boundaries[first.Index+1]=Circle(profile.Boundaries[first.Index+1].ID,first.X,first.Y,first.Radius);profile.Boundaries.erase(profile.Boundaries.begin()+last.Index+1);Edit(scene,ids,profile,source.at("geometryRef"));const auto once=Read(scene),edited=AssemblyPart(scene,unitID,partID);EXPECT_NE(original.at("geometryRef"),edited.at("geometryRef"));EXPECT_NE(original.at("previewRef"),edited.at("previewRef"));EXPECT_EQ(original.at("frame"),edited.at("frame"));EXPECT_EQ(original.at("thickness"),edited.at("thickness"));CheckProtected(source,ReadProfile(scene,ids));Preview(scene,Part(scene,partID));
    EXPECT_NEAR(Volume(Solid(scene,edited)),initialVolume+(first.Area+last.Area-std::numbers::pi*first.Radius*first.Radius)*thickness,1e-5);for(const auto& value:before.at("fixtures").To<Array>()){const auto old=value.To<Map>();if(old.at("id")!=partID)EXPECT_EQ(old,Part(scene,old.at("id")));}
    for(const auto& value:originalParts){const auto sibling=value.To<Map>();if(sibling.at("partId")!=partID)EXPECT_EQ(sibling,AssemblyPart(scene,unitID,sibling.at("partId")));}
    auto current=ReadProfile(scene,ids);auto enlarged=J::Decode<Profile>(current.at("profile"));size_t circleIndex=enlarged.Boundaries.size();for(size_t i=1;i<enlarged.Boundaries.size();++i)for(const auto& curve:enlarged.Boundaries[i].Curves)if(const auto* circle=std::get_if<G::Circle2>(&curve.Segment.Curve);circle&&std::abs(circle->Radius-first.Radius)<1e-9)circleIndex=i;ASSERT_LT(circleIndex,enlarged.Boundaries.size());const double radius=first.Radius*1.25;enlarged.Boundaries[circleIndex]=Circle(enlarged.Boundaries[circleIndex].ID,first.X,first.Y,radius);Edit(scene,ids,enlarged,current.at("geometryRef"));const auto final=Read(scene),finalPart=AssemblyPart(scene,unitID,partID);CheckProtected(source,ReadProfile(scene,ids));EXPECT_NEAR(Volume(Solid(scene,finalPart)),Volume(Solid(scene,edited))-std::numbers::pi*(radius*radius-first.Radius*first.Radius)*thickness,1e-5);EXPECT_TRUE(BRepCheck_Analyzer(Solid(scene,finalPart)).IsValid());
    const auto design=Unit(scene,unitID).at("design").To<Map>(),assembly=design.at("assembly").To<Map>();EXPECT_EQ(assembly.at("supportCheck").To<Map>().at("status").To<Text>(),"Unchecked");EXPECT_EQ(assembly.at("cutClearance").To<Map>().at("status").To<Text>(),"Unchecked");EXPECT_EQ(assembly.at("openingPreclearance").To<Map>().at("status").To<Text>(),"Unchecked");EXPECT_TRUE(assembly.at("manualReviewRequired").To<bool>());
    for(const auto& value:originalParts){const auto sibling=value.To<Map>();if(sibling.at("partId")!=partID)EXPECT_EQ(sibling,AssemblyPart(scene,unitID,sibling.at("partId")));}
    ASSERT_TRUE(scene.Database().Undo());PumpTasks(scene);EXPECT_EQ(once.at("fixtures"),Read(scene).at("fixtures"));ASSERT_TRUE(scene.Database().Undo());PumpTasks(scene);EXPECT_EQ(before.at("fixtures"),Read(scene).at("fixtures"));ASSERT_TRUE(scene.Database().Redo());ASSERT_TRUE(scene.Database().Redo());PumpTasks(scene);EXPECT_EQ(final.at("fixtures"),Read(scene).at("fixtures"));EXPECT_EQ(final.at("fixtureUnits"),Read(scene).at("fixtureUnits"));
    const auto folder=Folder();Reopen(scene,folder/"exact-circle.i5cam");auto request=FixtureRequest(scene);request["unitId"]=unitID;Invoke(&scene,"CamFixture","Breakdown",request);request=FixtureRequest(scene);request["unitId"]=unitID;request["destination"]=folder.string();const auto delivery=Invoke(&scene,"CamFixture","Export",request);const auto path=std::filesystem::path(delivery.at("directory").To<Text>())/(finalPart.at("number").To<Text>()+".dxf");EXPECT_NE(Bytes(path).find("\nCIRCLE\n"),Text::npos);RecordProperty("circle_radius_mm",std::to_string(radius));RecordProperty("deleted_automatic_windows",1);
}

TEST(FiveAxisFixturePartEditing, ManualHoleSpacingDoesNotDependOnFrozenGeneratorParameters){
    using namespace fixture_part_edit_tests;Scene scene;auto ids=Prepare(scene,false);const auto unitID=ids.at("unitId"),partID=ids.at("supportId");ids["baseId"]=partID;
    const auto before=Read(scene),original=AssemblyPart(scene,unitID,partID),source=ReadProfile(scene,ids);
    auto profile=J::Decode<Profile>(source.at("profile"));const auto protectedValues=source.at("protectedBoundaryIds").To<Array>();std::set<Text> protectedIDs;for(const auto& value:protectedValues)protectedIDs.insert(value.To<Text>());
    std::erase_if(profile.Boundaries,[&](const auto& loop){return !protectedIDs.contains(loop.ID);});
    double left=1e100;for(const auto& value:original.at("outline").To<Array>())left=std::min(left,value.To<Array>()[0].To<double>());
    profile.Boundaries.push_back(Circle("manual-narrow-spacing",left+5.79,20,4));Edit(scene,ids,profile,source.at("geometryRef"));
    const auto edited=AssemblyPart(scene,unitID,partID),after=Read(scene);EXPECT_TRUE(BRepCheck_Analyzer(Solid(scene,edited)).IsValid());
    const auto design=Unit(scene,unitID).at("design").To<Map>();EXPECT_EQ(design.at("recipe"),before.at("fixtureUnits").To<Array>().front().To<Map>().at("design").To<Map>().at("recipe"));EXPECT_EQ(design.at("assembly").To<Map>().at("geometryValidity").To<Text>(),"Current");
    for(const auto& value:before.at("fixtures").To<Array>()){const auto sibling=value.To<Map>();if(sibling.at("id")!=partID)EXPECT_EQ(sibling,Part(scene,sibling.at("id")));}
    const auto current=ReadProfile(scene,ids);CheckProtected(source,current);const auto exact=J::Decode<Profile>(current.at("profile"));const auto circle=std::get<G::Circle2>(exact.Boundaries.back().Curves.front().Segment.Curve);EXPECT_NEAR(circle.Placement.Location.X-circle.Radius-left,1.79,1e-8);
    const auto folder=Folder();Reopen(scene,folder/"manual-spacing.i5cam");auto request=FixtureRequest(scene);request["unitId"]=unitID;const auto list=FixtureBreakdownDetails(scene,request);EXPECT_EQ(list.at("parts").To<Array>().size(),after.at("fixtures").To<Array>().size());RecordProperty("manual_hole_to_edge_mm",Text("1.79"));
}

TEST(FiveAxisFixturePartEditing, OutlineMortisesAndInvalidHoleGeometryRejectWithoutResourcesOrHistoryChanges){
    using namespace fixture_part_edit_tests;Scene scene;const auto ids=Prepare(scene),source=ReadProfile(scene,ids);const auto original=J::Decode<Profile>(source.at("profile"));auto outer=original;ASSERT_FALSE(outer.Boundaries.front().Curves.empty());std::get<G::Segment2>(outer.Boundaries.front().Curves.front().Segment.Curve).Start.X+=.1;auto request=Request(scene,ids.at("unitId"),ids.at("baseId"),source.at("geometryRef"));request["profile"]=J::Encode(outer);Reject(scene,request,"CAM_FIXTURE_PART_OUTLINE_FIXED");
    const auto protectedIDs=source.at("protectedBoundaryIds").To<Array>();ASSERT_GT(protectedIDs.size(),1u);auto missing=original;const auto protectedID=protectedIDs[1].To<Text>();const auto hole=std::find_if(missing.Boundaries.begin()+1,missing.Boundaries.end(),[&](const auto& loop){return loop.ID==protectedID;});ASSERT_NE(hole,missing.Boundaries.end());missing.Boundaries.erase(hole);request=Request(scene,ids.at("unitId"),ids.at("baseId"),source.at("geometryRef"));request["profile"]=J::Encode(missing);Reject(scene,request,"CAM_FIXTURE_PART_PROTECTED_HOLE");
    auto outside=original;const auto window=EditableWindow(AssemblyPart(scene,ids.at("unitId"),ids.at("baseId")));outside.Boundaries[window.Index+1]=Circle(outside.Boundaries[window.Index+1].ID,10000,10000,4);request=Request(scene,ids.at("unitId"),ids.at("baseId"),source.at("geometryRef"));request["profile"]=J::Encode(outside);Reject(scene,request,"PLATE_EDIT_HOLE_OUTSIDE");
    auto duplicate=original;duplicate.Boundaries.back().ID=duplicate.Boundaries.front().ID;request=Request(scene,ids.at("unitId"),ids.at("baseId"),source.at("geometryRef"));request["profile"]=J::Encode(duplicate);Reject(scene,request,"CAM_FIXTURE_PART_BOUNDARY_ID_INVALID");
    for(const auto* key:{"frame","transform","thickness"}){request=Request(scene,ids.at("unitId"),ids.at("baseId"),source.at("geometryRef"));request["profile"]=source.at("profile");request[key]=Text(key)=="thickness"?Variant(9.):source.at("frame");Reject(scene,request,Text(key)=="thickness"?"CAM_FIXTURE_PART_THICKNESS_FIXED":"CAM_FIXTURE_GENERATED_TRANSFORM_FIXED");}
}

TEST(FiveAxisFixturePartEditing, StaleCommandsAndCrossSceneOrUnitOwnershipCannotWritePlateGeometry){
    using namespace fixture_part_edit_tests;Scene scene;const auto ids=Prepare(scene),source=ReadProfile(scene,ids);auto stale=Request(scene,ids.at("unitId"),ids.at("baseId"),source.at("geometryRef"));stale["profile"]=source.at("profile");auto rename=FixtureRequest(scene,ids.at("supportId").To<Text>());rename["name"]=Text("仍由原单元管理的支撑");Invoke(&scene,"CamFixture","Update",rename);Reject(scene,stale,"CAM_REVISION_CONFLICT");
    const auto window=EditableWindow(AssemblyPart(scene,ids.at("unitId"),ids.at("baseId")));auto edited=J::Decode<Profile>(source.at("profile"));edited.Boundaries[window.Index+1]=Circle(edited.Boundaries[window.Index+1].ID,window.X,window.Y,window.Radius);Edit(scene,ids,edited,source.at("geometryRef"));
    auto staleGeometry=Request(scene,ids.at("unitId"),ids.at("baseId"),source.at("geometryRef"));staleGeometry["profile"]=source.at("profile");Reject(scene,staleGeometry,"CAM_FIXTURE_PART_GEOMETRY_STALE");
    File support(BRepPrimAPI_MakeBox(8,9,10).Shape());const auto imported=ImportedFixture(scene,support);auto wrongUnit=Request(scene,ids.at("unitId"),Text(imported),source.at("geometryRef"));wrongUnit["profile"]=source.at("profile");Reject(scene,wrongUnit,"CAM_SETUP_MISMATCH");
    Scene other;File work(BRepPrimAPI_MakeBox(40,60,20).Shape());Imported(other,work);auto cross=Request(other,ids.at("unitId"),ids.at("baseId"),source.at("geometryRef"));cross["profile"]=source.at("profile");Reject(other,cross);
    const auto before=Read(scene);EXPECT_THROW(Invoke(nullptr,"CamFixture","PartUpdate",Request(scene,ids.at("unitId"),ids.at("baseId"))),std::exception);EXPECT_EQ(before,Read(scene));
}
TEST(FiveAxisFixturePartEditing, CircularEdgeNotchExportsAnExactOuterArcAndReopens){
    using namespace fixture_part_edit_tests;Scene scene;const auto ids=Prepare(scene,false),source=ReadProfile(scene,ids);auto profile=J::Decode<Profile>(source.at("profile"));const auto before=AssemblyPart(scene,ids.at("unitId"),ids.at("baseId"));
    double left=1e100,low=1e100,high=-1e100;for(const auto& value:before.at("outline").To<Array>()){const auto p=value.To<Array>();left=std::min(left,p[0].To<double>());low=std::min(low,p[1].To<double>());high=std::max(high,p[1].To<double>());}
    const auto protectedValues=source.at("protectedBoundaryIds").To<Array>();std::set<Text> protectedIDs;for(const auto& value:protectedValues)protectedIDs.insert(value.To<Text>());std::erase_if(profile.Boundaries,[&](const auto& loop){return !protectedIDs.contains(loop.ID);});
    profile.Boundaries.push_back(Circle("edge-notch",left,(low+high)/2,6));Edit(scene,ids,profile,source.at("geometryRef"));const auto edited=AssemblyPart(scene,ids.at("unitId"),ids.at("baseId"));EXPECT_NE(before.at("outline"),edited.at("outline"));EXPECT_EQ(before.at("frame"),edited.at("frame"));EXPECT_EQ(before.at("joints"),edited.at("joints"));
    const auto folder=Folder();Reopen(scene,folder/"round-edge-notch.i5cam");auto request=FixtureRequest(scene);request["unitId"]=ids.at("unitId");Invoke(&scene,"CamFixture","Breakdown",request);request=FixtureRequest(scene);request["unitId"]=ids.at("unitId");request["destination"]=folder.string();const auto delivery=Invoke(&scene,"CamFixture","Export",request);const auto dxf=Bytes(std::filesystem::path(delivery.at("directory").To<Text>())/(edited.at("number").To<Text>()+".dxf"));
    EXPECT_NE(dxf.find("\nCUT_OUTER\n"),Text::npos);EXPECT_NE(dxf.find("\n42\n"),Text::npos);RecordProperty("notch_radius_mm",6);RecordProperty("dxf_arc_encoding","exact polyline bulge");
}
