// CAD classification preserves every real boundary not generated by the
// nominal extrusion skin. Accessibility and supported tool types are CAM data.
int GeometricMachiningBoundaryRegression(const fs::path& directory)
{
    fs::create_directories(directory);VariantArray checks,cases;
    const auto save=[&](const char* status="running"){Save(directory/"checks.json",{{"status",std::string(status)},{"checks",checks},{"cases",cases}});};
    const auto check=[&](bool passed,const std::string& name){checks.emplace_back(ObjectMap{{"name",name},{"passed",passed}});save();if(!passed)throw std::runtime_error(name);};
    try {
        R::CExtrudeRecognizesService service;
        const auto outer=BRepPrimAPI_MakeBox(gp_Pnt(0,0,0),100,20,20).Shape();
        const auto inner=BRepPrimAPI_MakeBox(gp_Pnt(-1,3,3),102,14,14).Shape();
        const auto stock=BRepAlgoAPI_Cut(outer,inner).Shape();
        const auto section=service.ExtractSectionWires(O::ConvertOpenCascadeShapeToBRep(stock,"","",.001));
        check(section.bSuccess&&section.Wires.size()==2,"independent stock supplies outer and inner material contours");
        const auto skin=[](const TopoDS_Face& face){
            const BRepAdaptor_Surface surface(face,true);if(surface.GetType()!=GeomAbs_Plane)return false;
            const auto plane=surface.Plane();const auto normal=plane.Axis().Direction();
            const bool alongY=normal.IsParallel(gp_Dir(0,1,0),1e-10),alongZ=normal.IsParallel(gp_Dir(0,0,1),1e-10);
            if(!alongY&&!alongZ)return false;
            for(const double station:{0.,3.,17.,20.}){
                const gp_Pnt point=alongY?gp_Pnt(0,station,0):gp_Pnt(0,0,station);
                if(plane.Distance(point)<=1e-9)return true;
            }
            return false;
        };
        const auto cut=[](const TopoDS_Shape& body,const TopoDS_Shape& tool){BRepAlgoAPI_Cut operation(body,tool);
            if(!operation.IsDone()||operation.Shape().IsNull())throw std::runtime_error("Cannot construct independent cut fixture");return operation.Shape();};
        const auto blind=cut(stock,BRepPrimAPI_MakeBox(gp_Pnt(25,7,18),20,6,3).Shape());
        const auto openBlind=cut(stock,BRepPrimAPI_MakeBox(gp_Pnt(-1,7,18),31,6,3).Shape());
        const auto through=cut(stock,BRepPrimAPI_MakeBox(gp_Pnt(25,7,16),20,6,5).Shape());
        BRepBuilderAPI_MakePolygon polygon;
        for(const auto point:std::array<gp_Pnt,4>{{{79.75,-1,-1},{110,-1,-1},{110,-1,21},{85.25,-1,21}}})polygon.Add(point);
        polygon.Close();const auto endTool=BRepPrimAPI_MakePrism(BRepBuilderAPI_MakeFace(polygon.Wire()).Face(),gp_Vec(0,22,0)).Shape();
        const auto oblique=cut(stock,endTool);
        const auto run=[&](const std::string& name,const TopoDS_Shape& shape,bool hasFloor,double floorArea,bool single){
            check(BRepCheck_Analyzer(shape,true).IsValid(),name+" source is a valid closed solid");
            const auto model=O::ConvertOpenCascadeShapeToBRep(shape,"","",.001);const auto before=G::Persistence::Serialize(model);
            R::SFeatureToolpathOptions options;options.bSingleExtrudedStock=single;
            const auto classified=service.ClassifySectionFaces(model,section,options);
            check(classified.bSuccess,name+" public Classify succeeds");
            check(before==G::Persistence::Serialize(model),name+" original CAD is byte-identical");
            const auto machining=Build(classified.MachiningGeometry),nonMachining=Build(classified.NonMachiningGeometry),split=Build(classified.SplitGeometry);
            check(BRepCheck_Analyzer(split,true).IsValid(),name+" complete split remains valid");
            check(Relative(Area(split),Area(shape))<1e-9&&Relative(Area(machining)+Area(nonMachining),Area(shape))<1e-9,name+" complete boundary area forms an exhaustive partition");
            double expectedMachiningArea=0,expectedSkinArea=0;
            int expectedMachiningFaces=0,expectedSkinFaces=0;
            for(TopExp_Explorer faces(shape,TopAbs_FACE);faces.More();faces.Next()){
                const auto face=TopoDS::Face(faces.Current());const double area=Area(face);const bool isSkin=skin(face);
                if(isSkin){expectedSkinArea+=area;++expectedSkinFaces;}else{expectedMachiningArea+=area;++expectedMachiningFaces;}
                BRepAlgoAPI_Common covered(face,isSkin?nonMachining:machining);check(covered.IsDone(),name+" exact source-face coverage succeeds");
                check(Relative(Area(covered.Shape()),area)<1e-8,name+(isSkin?" complete source skin is classified as skin":" complete non-skin source face is retained for machining"));
            }
            check(Relative(Area(machining),expectedMachiningArea)<1e-8&&Relative(Area(nonMachining),expectedSkinArea)<1e-8,name+" only nominal extrusion skin is omitted from machining geometry");
            double retainedFloorArea=0;
            for(TopExp_Explorer faces(machining,TopAbs_FACE);faces.More();faces.Next()){
                const auto face=TopoDS::Face(faces.Current());const BRepAdaptor_Surface surface(face,true);if(surface.GetType()!=GeomAbs_Plane)continue;
                const auto plane=surface.Plane();if(plane.Axis().Direction().IsParallel(gp_Dir(0,0,1),1e-10)&&plane.Distance(gp_Pnt(0,0,18))<1e-9)retainedFloorArea+=Area(face);
            }
            check(hasFloor?std::abs(retainedFloorArea-floorArea)<1e-8:retainedFloorArea==0,name+(hasFloor?" retains the complete blind-cut floor":" does not invent a blind-cut floor"));
            check(std::none_of(classified.Diagnostics.begin(),classified.Diagnostics.end(),[](const auto& text){return text.find("Excluded open-ended recess floor")!=std::string::npos||text.find("recess floors with two transverse walls")!=std::string::npos;}),name+" contains no tool-dependent floor exclusion");
            cases.emplace_back(ObjectMap{{"name",name},{"singleExtrudedStock",single},{"sourceFaces",Count(shape,TopAbs_FACE)},
                {"machiningFaces",int(classified.MachiningGeometry.Faces.size())},{"skinFaces",int(classified.NonMachiningGeometry.Faces.size())},
                {"expectedNonSkinSourceFaces",expectedMachiningFaces},{"expectedSkinSourceFaces",expectedSkinFaces},
                {"machiningAreaMm2",Area(machining)},{"expectedMachiningAreaMm2",expectedMachiningArea},{"retainedFloorAreaMm2",retainedFloorArea},{"sourceUnchanged",true}});save();
        };
        run("closed-blind-pocket",blind,true,120,true);
        run("open-ended-blind-slot",openBlind,true,180,true);
        run("through-wall-opening",through,false,0,true);
        run("oblique-end-truncation",oblique,false,0,true);
        run("blind-pocket-without-single-stock-declaration",blind,true,120,false);
        save("passed");return 0;
    }catch(const std::exception& error){Save(directory/"checks.json",{{"status",std::string("failed")},{"error",std::string(error.what())},{"checks",checks},{"cases",cases}});return 1;}
}
