<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Build against the existing runtime, with isolated outputs. Do not rebuild
       unrelated products or replace a running desktop's DLLs. -->
  <ItemGroup><ProjectReference Remove="@(ProjectReference)" /></ItemGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalOptions>/bigobj /wd4996 %(AdditionalOptions)</AdditionalOptions>
      <Optimization>MaxSpeed</Optimization><BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat><SupportJustMyCode>false</SupportJustMyCode>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(OutDir);$(SolutionDir)x64\$(Configuration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>Data.lib;Services.lib;TemplateRuntime.lib;Task.lib;Resources.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ExtrusionRecognitionTest' and '$(TubeStageProbe)' == 'true'">
    <TargetName>TubeStageProbe</TargetName>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ExtrusionRecognitionTest' and '$(TubeStageProbe)' == 'true'">
    <ClCompile Remove="@(ClCompile)" />
    <ClCompile Include="$(MSBuildThisFileDirectory)TubeStageProbe.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
  </ItemGroup>
  <ItemDefinitionGroup Condition="'$(MSBuildProjectName)' == 'ExtrusionRecognitionTest'">
    <Link><AdditionalDependencies>$(OutDir)ExtrusionRecognition.lib;$(OutDir)OpenCascadeResourceImport.lib;%(AdditionalDependencies)</AdditionalDependencies></Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(MSBuildProjectName)' == 'ExtrusionRecognition'">
    <Link><AdditionalDependencies>OpenCascadeResourceImport.lib;%(AdditionalDependencies)</AdditionalDependencies></Link>
  </ItemDefinitionGroup>
</Project>
