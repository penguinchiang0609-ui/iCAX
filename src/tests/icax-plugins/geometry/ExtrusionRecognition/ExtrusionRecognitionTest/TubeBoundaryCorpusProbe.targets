<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup><TargetName>TubeBoundaryCorpusProbe</TargetName></PropertyGroup>
  <ItemGroup><ProjectReference Remove="@(ProjectReference)"/><ClCompile Remove="@(ClCompile)"/>
    <ClCompile Include="$(MSBuildThisFileDirectory)TubeBoundaryCorpusProbe.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
  </ItemGroup>
  <ItemDefinitionGroup>
    <ClCompile><AdditionalOptions>/bigobj /wd4996 %(AdditionalOptions)</AdditionalOptions><Optimization>MaxSpeed</Optimization><BasicRuntimeChecks>Default</BasicRuntimeChecks><SupportJustMyCode>false</SupportJustMyCode></ClCompile>
    <Link><AdditionalLibraryDirectories>$(OutDir);$(SolutionDir)x64\$(Configuration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories><AdditionalDependencies>$(OutDir)OpenCascadeResourceImport.lib;$(OutDir)ExtrusionRecognition.lib;Data.lib;Services.lib;TemplateRuntime.lib;Task.lib;Resources.lib;%(AdditionalDependencies)</AdditionalDependencies></Link>
  </ItemDefinitionGroup>
</Project>
