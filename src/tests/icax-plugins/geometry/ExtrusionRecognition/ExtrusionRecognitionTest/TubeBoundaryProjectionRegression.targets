<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup><TargetName>TubeBoundaryProjectionRegression</TargetName></PropertyGroup>
  <ItemGroup>
    <ProjectReference Remove="@(ProjectReference)" />
    <ClCompile Remove="@(ClCompile)" />
    <ClCompile Include="$(MSBuildProjectDirectory)\TubeBoundaryProjectionRegression.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
  </ItemGroup>
  <ItemDefinitionGroup>
    <ClCompile><AdditionalOptions>/wd4996 %(AdditionalOptions)</AdditionalOptions><Optimization>MaxSpeed</Optimization><BasicRuntimeChecks>Default</BasicRuntimeChecks><SupportJustMyCode>false</SupportJustMyCode></ClCompile>
    <Link><AdditionalLibraryDirectories>$(OutDir);$(SolutionDir)x64\$(Configuration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories><AdditionalDependencies>ExtrusionRecognition.lib;OpenCascadeResourceImport.lib;Data.lib;Services.lib;TemplateRuntime.lib;Task.lib;Resources.lib;%(AdditionalDependencies)</AdditionalDependencies></Link>
  </ItemDefinitionGroup>
</Project>
