#include <winver.h>

// Product resource files supply the branding; the launcher owns the version layout.
101 ICON ICAX_APPLICATION_ICON

1 VERSIONINFO
 FILEVERSION ICAX_APPLICATION_VERSION
 PRODUCTVERSION ICAX_APPLICATION_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", ICAX_APPLICATION_NAME
            VALUE "FileVersion", ICAX_APPLICATION_FILE_VERSION
            VALUE "InternalName", ICAX_APPLICATION_NAME
            VALUE "OriginalFilename", ICAX_APPLICATION_FILENAME
            VALUE "ProductName", ICAX_APPLICATION_NAME
            VALUE "ProductVersion", ICAX_APPLICATION_PRODUCT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
