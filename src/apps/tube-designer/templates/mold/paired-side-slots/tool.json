      "max": 4,
      "options": [
        {
          "value": 2,
          "label": "2 个（对应短管对边）"
        },
        {
          "value": 4,
          "label": "4 个（对应短管四边）"
        }
      ]
    },
    {
      "key": "tabWidth",
      "displayName": "插舌宽度（mm）",
      "valueType": "number",
      "defaultValue": 8,
      "min": 0.1,
      "max": 1000,
      "step": 0.1
    },
    {
      "key": "tabLength",
      "displayName": "插舌伸出长度（mm）",
      "valueType": "number",
      "defaultValue": 12,
      "min": 0.1,
      "max": 1000,
      "step": 0.1
    },
    {
      "key": "sideClearance",
