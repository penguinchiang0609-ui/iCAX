{
  "schema": "icax.punch-tool",
  "schemaVersion": 1,
  "id": "circle",
  "version": "1.0.0",
  "displayName": "圆孔",
  "kind": "programmatic",
  "target": "side",
  "category": "孔型",
  "inputs": [
    { "key": "targetSection", "displayName": "目标管型截面", "valueType": "profile", "required": true }
  ],
  "operationParameters": [
    { "key": "blindHole", "displayName": "盲孔", "valueType": "boolean", "defaultValue": false },
    { "key": "cutDepth", "displayName": "孔深", "valueType": "number", "defaultValue": 5, "min": 0.1, "max": 100000, "step": 0.1, "unit": "mm", "visibleWhen": { "op": "eq", "parameter": "blindHole", "value": true } },
    { "key": "opposite", "displayName": "对冲孔", "valueType": "boolean", "defaultValue": false }
  ],
  "parameters": [
    {
      "key": "diameter",
      "displayName": "直径",
      "valueType": "number",
      "defaultValue": 10,
      "min": 0.1,
      "max": 100000,
      "step": 0.1
    }
  ],
  "parameterDiagram": {
    "schemaVersion": 2,
    "viewBox": "0 0 160 120",
    "circles": [{ "cx": 80, "cy": 60, "r": 38, "className": "tool-diagram-profile" }],
    "annotations": [
      { "parameter": "diameter", "kind": "linear", "axis": "x", "side": "bottom", "from": [42, 60], "to": [118, 60], "description": "成品圆孔直径" }
    ]
  }
}
