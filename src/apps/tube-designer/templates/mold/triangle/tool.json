{
  "schema": "icax.punch-tool",
  "schemaVersion": 1,
  "id": "triangle",
  "version": "1.0.0",
  "displayName": "三角孔",
  "kind": "programmatic",
  "target": "side",
  "category": "孔型",
  "parameters": [
    {
      "key": "spanAlong",
      "displayName": "底边尺寸",
      "valueType": "number",
      "defaultValue": 14,
      "min": 0.1,
      "max": 100000,
      "step": 0.1
    },
    {
      "key": "spanAcross",
      "displayName": "高度",
      "valueType": "number",
      "defaultValue": 12,
      "min": 0.1,
      "max": 100000,
      "step": 0.1
    }
  ],
  "parameterDiagram": {
    "schemaVersion": 2,
    "viewBox": "0 0 180 130",
    "paths": ["M20 105 L90 20 L160 105 Z"],
    "annotations": [
      { "parameter": "spanAlong", "kind": "linear", "axis": "x", "side": "bottom", "from": [20, 105], "to": [160, 105], "description": "三角孔底边长度" },
      { "parameter": "spanAcross", "kind": "linear", "axis": "y", "side": "left", "from": [90, 20], "to": [90, 105], "description": "底边到顶点的高度" }
    ]
  }
}
