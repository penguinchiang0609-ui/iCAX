{
  "schema": "icax.punch-tool",
  "schemaVersion": 1,
  "id": "ellipse",
  "version": "1.0.0",
  "displayName": "椭圆孔",
  "kind": "programmatic",
  "target": "side",
  "category": "孔型",
  "parameters": [
    {
      "key": "spanAlong",
      "displayName": "沿长度尺寸",
      "valueType": "number",
      "defaultValue": 30,
      "min": 0.1,
      "max": 100000,
      "step": 0.1
    },
    {
      "key": "spanAcross",
      "displayName": "横向尺寸",
      "valueType": "number",
      "defaultValue": 10,
      "min": 0.1,
      "max": 100000,
      "step": 0.1
    }
  ],
  "parameterDiagram": {
    "schemaVersion": 2,
    "viewBox": "0 0 180 120",
    "paths": ["M20 60 A70 34 0 1 0 160 60 A70 34 0 1 0 20 60 Z"],
    "annotations": [
      { "parameter": "spanAlong", "kind": "linear", "axis": "x", "side": "bottom", "from": [20, 60], "to": [160, 60], "description": "沿主管轴线方向的孔长" },
      { "parameter": "spanAcross", "kind": "linear", "axis": "y", "side": "left", "from": [90, 26], "to": [90, 94], "description": "环向展开方向的孔宽" }
    ]
  }
