    {"key":"reliefHeight","displayName":"释放孔高度（mm）","valueType":"number","defaultValue":0.5,"min":0,"max":10000,"visibleWhen":{"op":"eq","parameter":"bottomStrategy","value":"relief"}},
    {"key":"reliefRadius","displayName":"释放孔圆角 R（mm）","valueType":"number","defaultValue":0.1,"min":0,"max":10000,"visibleWhen":{"op":"eq","parameter":"bottomStrategy","value":"relief"}},
