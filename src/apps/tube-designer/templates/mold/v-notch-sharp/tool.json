    {"key":"bottomStrategy","displayName":"底部策略","valueType":"string","defaultValue":"sharp","options":[{"value":"sharp","label":"尖底"},{"value":"flat","label":"平底"},{"value":"rounded","label":"圆角"},{"value":"relief","label":"释放孔"}]},
    {"key":"flatWidth","displayName":"平底宽度（mm）","valueType":"number","defaultValue":0,"min":0,"max":10000,"visibleWhen":{"op":"eq","parameter":"bottomStrategy","value":"flat"}},
    {"key":"roundRadius","displayName":"刀口圆角 R（非成形半径，mm）","valueType":"number","defaultValue":2,"min":0,"max":10000,"visibleWhen":{"op":"eq","parameter":"bottomStrategy","value":"rounded"}},
