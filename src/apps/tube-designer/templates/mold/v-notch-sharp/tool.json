  "parameters": [
    {
      "key": "segmentedBend",
      "displayName": "多槽分段折弯（对称尖角槽）",
      "valueType": "boolean",
      "defaultValue": false
    },
    {
      "key": "segmentCount",
      "displayName": "折弯槽数",
      "valueType": "number",
      "defaultValue": 6,
      "min": 2,
      "max": 64,
      "visibleWhen": {
        "op": "eq",
        "parameter": "segmentedBend",
        "value": true
      }
    },
    {
      "key": "centerlineRadius",
