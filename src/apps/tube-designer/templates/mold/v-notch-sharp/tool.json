  "parameters": [
    {
      "key": "segmentedBend",
      "level": "advanced",
      "displayName": "多槽分段槽口（对称尖角槽）",
      "valueType": "boolean",
      "defaultValue": false
    },
    {
      "key": "segmentCount",
      "level": "advanced",
      "displayName": "折弯槽数",
      "valueType": "number",
      "defaultValue": 6,
      "min": 2,
      "max": 64,
      "visibleWhen": {
        "op": "eq",
        "parameter": "segmentedBend",
        "value": true
      }
    },
    {
      "key": "centerlineRadius",
      "displayName": "目标中心线半径（非内半径，mm）",
      "valueType": "number",
      "defaultValue": 50,
      "min": 0.01,
      "visibleWhen": {
        "op": "eq",
        "parameter": "segmentedBend",
        "value": true
      }
    },
    {
      "key": "bendCompensation",
      "level": "advanced",
      "displayName": "启用 K 因子展开补偿（圆角策略）",
      "valueType": "boolean",
      "defaultValue": false,
      "visibleWhen": {
        "op": "all",
        "conditions": [
          {
            "op": "eq",
            "parameter": "segmentedBend",
            "value": false
          },
          {
            "op": "eq",
            "parameter": "bottomStrategy",
            "value": "rounded"
          }
        ]
      }
    },
    {
      "key": "kFactor",
      "level": "advanced",
      "displayName": "K 因子（建议 0.6～1）",
      "valueType": "number",
      "defaultValue": 0.62,
      "min": 0,
      "max": 1,
      "visibleWhen": {
        "op": "any",
        "conditions": [
          {
            "op": "all",
            "conditions": [
              { "op": "eq", "parameter": "segmentedBend", "value": false },
              { "op": "eq", "parameter": "bottomStrategy", "value": "rounded" },
              { "op": "eq", "parameter": "bendCompensation", "value": true }
            ]
          },
          {
            "op": "all",
            "conditions": [
              { "op": "eq", "parameter": "bottomStrategy", "value": "relief" },
              { "op": "eq", "parameter": "reliefShape", "value": "circleWrap" }
            ]
          }
        ]
      }
    },
    {
      "key": "angle",
      "displayName": "折弯开口角 β（多槽时为总角度，°）",
      "valueType": "number",
      "defaultValue": 90,
      "min": 1,
      "max": 170,
      "visibleWhen": {
        "op": "any",
        "conditions": [
          {
            "op": "eq",
            "parameter": "segmentedBend",
            "value": true
          },
          {
            "op": "all",
            "conditions": [
              { "op": "eq", "parameter": "bottomStrategy", "value": "relief" },
              { "op": "eq", "parameter": "reliefShape", "value": "circleWrap" }
            ]
          },
          {
            "op": "eq",
            "parameter": "asymmetric",
            "value": false
          }
        ]
      }
    },
    {
      "key": "asymmetric",
