    "paths": ["M48 27 H132 A33 33 0 0 1 132 93 H48 A33 33 0 0 1 48 27 Z"],
    "annotations": [
      { "parameter": "spanAlong", "kind": "linear", "axis": "x", "side": "bottom", "from": [15, 60], "to": [165, 60], "description": "总长包含两端半圆" },
      { "parameter": "spanAcross", "kind": "linear", "axis": "y", "side": "left", "from": [90, 27], "to": [90, 93], "description": "孔宽等于端部半圆直径" }
