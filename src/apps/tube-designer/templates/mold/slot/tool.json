      "max": 100000,
      "step": 0.1
    },
    {
      "key": "spanAcross",
      "displayName": "宽度 W（端圆直径，mm）",
      "valueType": "number",
      "defaultValue": 10,
      "min": 0.1,
      "max": 100000,
      "step": 0.1
    }
  ],
  "parameterDiagram": {
    "schemaVersion": 2,
