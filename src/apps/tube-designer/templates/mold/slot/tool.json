{
  "schema": "icax.punch-tool",
  "schemaVersion": 1,
  "id": "slot",
  "version": "1.0.0",
  "displayName": "腰形孔",
  "kind": "programmatic",
  "target": "side",
  "category": "孔型",
  "description": "总长 L 包含两端半圆，宽度 W 为端圆直径，直线段长为 L−W。属于封闭孔型，不是折弯槽口。",
  "parameters": [
    {
      "key": "spanAlong",
      "displayName": "总长 L（含端圆，mm）",
      "valueType": "number",
      "defaultValue": 30,
      "min": 0.1,
      "max": 100000,
      "step": 0.1
    },
    {
      "key": "spanAcross",
      "displayName": "宽度 W（端圆直径，mm）",
      "valueType": "number",
      "defaultValue": 10,
      "min": 0.1,
      "max": 100000,
      "step": 0.1
    }
  ]
}
