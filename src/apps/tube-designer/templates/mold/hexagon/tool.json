{
  "schema": "icax.punch-tool",
  "schemaVersion": 1,
  "id": "hexagon",
  "version": "1.0.0",
  "displayName": "六角孔",
  "kind": "programmatic",
  "target": "side",
  "category": "孔型",
  "inputs": [
    { "key": "targetSection", "displayName": "目标管型截面", "valueType": "profile", "required": true }
  ],
  "operationParameters": [
    { "key": "blindHole", "displayName": "盲孔", "valueType": "boolean", "defaultValue": false },
    { "key": "cutDepth", "displayName": "孔深", "valueType": "number", "defaultValue": 5, "min": 0.1, "max": 100000, "step": 0.1, "unit": "mm", "visibleWhen": { "op": "eq", "parameter": "blindHole", "value": true } },
    { "key": "opposite", "displayName": "对冲孔", "valueType": "boolean", "defaultValue": false }
  ],
  "parameters": [
    {
      "key": "acrossFlats",
      "displayName": "对边尺寸",
      "valueType": "number",
      "defaultValue": 12,
      "min": 0.1,
      "max": 100000,
      "step": 0.1
    }
  ],
  "parameterDiagram": {
    "schemaVersion": 2,
    "viewBox": "0 0 160 140",
    "polygons": [{ "points": "45,20 115,20 145,70 115,120 45,120 15,70", "className": "tool-diagram-profile" }],
    "annotations": [
      { "parameter": "acrossFlats", "kind": "linear", "axis": "y", "side": "left", "from": [80, 20], "to": [80, 120], "description": "两条相对平边之间的距离" }
    ]
  }
}
