{
  "schema": "icax.punch-tool",
  "schemaVersion": 1,
  "id": "end-cope",
  "version": "1.0.0",
  "displayName": "圆柱凹口 / 相贯口",
  "kind": "programmatic",
  "target": "end",
  "category": "端面",
  "processCode": "cope",
  "parameters": [
    {
      "key": "diameter",
      "displayName": "圆柱直径",
