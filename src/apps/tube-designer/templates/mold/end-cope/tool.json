    {
      "key": "clearance",
      "displayName": "配合间隙",
      "valueType": "number",
      "defaultValue": 0,
      "min": 0,
      "max": 1000,
      "step": 0.1
    }
  ],
  "parameterDiagram": {
    "schemaVersion": 2,
    "viewBox": "0 0 190 130",
    "paths": ["M18 25 H150 V105 H18 Z", "M150 25 A40 40 0 0 0 150 105"],
    "lines": [{ "x1": 18, "y1": 65, "x2": 168, "y2": 65, "className": "tool-diagram-centerline" }],
    "annotations": [
      { "parameter": "diameter", "kind": "linear", "axis": "y", "side": "right", "from": [150, 25], "to": [150, 105], "description": "相贯目标圆柱直径" },
      { "parameter": "clearance", "kind": "leader", "side": "bottom", "point": [151, 65], "description": "正值扩大凹口以留装配间隙" }
    ]
  }
