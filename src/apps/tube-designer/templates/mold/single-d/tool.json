      "displayName": "基准圆直径 D（mm）",
      "valueType": "number",
      "defaultValue": 20,
      "min": 0.1,
      "max": 100000,
      "step": 0.1
    },
    {
      "key": "flatOffset",
      "displayName": "圆心到平边 c（mm）",
      "valueType": "number",
      "defaultValue": 6,
      "min": 0,
      "max": 100000,
      "step": 0.1
    }
  ],
