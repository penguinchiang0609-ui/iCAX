        "labels": [
          {"x": 150, "y": 18, "text": "总折弯角 β", "parameter": "angle", "unit": "°"},
          {"x": 210, "y": 90, "text": "槽数按误差自动计算"},
          {"x": 85, "y": 158, "text": "槽距 p（自动计算）"},
          {"x": 183, "y": 190, "text": "目标半径", "parameter": "bendRadius", "unit": " mm"},
          {"x": 180, "y": 213, "text": "最大弓高误差", "parameter": "maximumChordError", "unit": " mm"}
        ]
      }
    ],
    "labels": [
      {
        "x": 150,
        "y": 18,
        "text": "总折弯角 β",
        "parameter": "angle",
        "unit": "°"
      },
      {
        "x": 225,
        "y": 90,
        "text": "槽数 n",
        "parameter": "segmentCount"
      },
      {
        "x": 85,
        "y": 158,
        "text": "槽距 p（自动计算）"
      },
      {
        "x": 183,
        "y": 190,
        "text": "目标半径",
        "parameter": "bendRadius",
        "unit": " mm"
      },
      {
        "x": 180,
        "y": 213,
        "text": "δ=β/n · p=2Rc·sin(δ/2)"
      }
    ]
  },
  "parameters": [
    {
      "key": "angle",
      "displayName": "总折弯角 β（°）",
      "valueType": "number",
      "defaultValue": 90,
      "min": 1,
      "max": 170
    },
    {
      "key": "radiusDatum",
      "displayName": "半径基准",
      "valueType": "string",
      "defaultValue": "inner",
      "options": [
        {
          "value": "inner",
          "label": "内侧半径 Ri"
        },
        {
          "value": "centerline",
          "label": "截面中心线半径 Rc"
        }
      ]
    },
    {
      "key": "bendRadius",
      "displayName": "目标弯曲半径（mm，按所选基准）",
      "valueType": "number",
      "defaultValue": 40,
      "min": 0.01,
      "max": 100000
    },
    {
      "key": "countMode",
      "displayName": "槽数确定方式",
      "valueType": "string",
      "defaultValue": "count",
      "options": [
        {
          "value": "count",
          "label": "指定槽数"
        },
        {
          "value": "tolerance",
          "label": "按最大弓高误差"
        }
      ]
    },
    {
      "key": "segmentCount",
      "displayName": "分段槽数 n",
      "valueType": "integer",
      "defaultValue": 6,
      "min": 2,
      "max": 64,
      "visibleWhen": {
        "op": "eq",
        "parameter": "countMode",
        "value": "count"
      }
    },
    {
      "key": "maximumChordError",
      "displayName": "最大弓高误差（mm）",
      "valueType": "number",
      "defaultValue": 0.5,
      "min": 0.000001,
      "max": 1000,
      "visibleWhen": {
        "op": "eq",
        "parameter": "countMode",
        "value": "tolerance"
      }
    },
    {
      "key": "rootClearance",
      "displayName": "槽根到内底面距离（mm）",
      "valueType": "number",
      "defaultValue": 1,
      "min": 0,
      "max": 10000
    },
    {
      "key": "minimumLand",
      "displayName": "相邻槽最小剩余间隔（mm）",
      "valueType": "number",
      "defaultValue": 1,
      "min": 0.01,
      "max": 10000
    },
    {
      "key": "bendCompensation",
      "displayName": "启用每槽 K 因子补偿",
      "valueType": "boolean",
      "defaultValue": false
    },
    {
      "key": "kFactor",
      "displayName": "K 因子（需按材料和工艺标定）",
      "valueType": "number",
      "defaultValue": 0.62,
      "min": 0,
      "max": 1,
      "visibleWhen": {
        "op": "eq",
        "parameter": "bendCompensation",
        "value": true
      }
    },
    {
      "key": "wallThickness",
      "displayName": "截面实测壁厚（mm）",
      "valueType": "number",
      "defaultValue": 0,
      "min": 0,
      "max": 10000,
      "derived": true
    }
  ]
}
