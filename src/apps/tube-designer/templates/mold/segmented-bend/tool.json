  "preview": {"profileRef": {"scope": "system", "id": "rect"}},
  "kind": "programmatic",
  "target": "part",
  "category": "槽口",
  "id": "segmented-bend",
  "displayName": "分段折弯槽口",
  "description": "多个小角度 V 槽沿管长排列形成的槽口工艺。支持内接弦与外切折线两种明确区分的槽距模型、内侧/中心线半径、手动槽数或误差自动分段、K 补偿及最小槽间隔检查。它生成下料槽形，实际成形仍需装配层与试样验证。",
  "illustration": {
    "viewBox": "0 0 48 48",
    "paths": [
      "M3 12 H8 L12 34 L16 12 H20 L24 34 L28 12 H32 L36 34 L40 12 H45 V39 H3 Z"
    ]
  },
  "parameterDiagram": {
    "schemaVersion": 2,
    "viewBox": "0 0 300 230",
    "paths": [
      { "d": "M15 40 H35 L50 110 L65 40 H105 L120 110 L135 40 H175 L190 110 L205 40 H280", "className": "tool-diagram-profile" },
      { "d": "M15 125 H280", "className": "tool-diagram-reference" },
      { "d": "M50 132 V144 M120 132 V144 M50 138 H120", "className": "tool-diagram-detail" },
      { "d": "M32 185 A85 85 0 0 1 117 100", "className": "tool-diagram-profile" },
      { "d": "M32 185 H117 V100", "className": "tool-diagram-reference" }
    ],
    "variants": [
      {
        "visibleWhen": {"op": "eq", "parameter": "countMode", "value": "tolerance"},
        "labels": [
          {"x": 150, "y": 18, "text": "总折弯角 β", "parameter": "angle", "unit": "°"},
          {"x": 210, "y": 90, "text": "槽数按误差自动计算"},
          {"x": 85, "y": 158, "text": "槽距 p（按离散模型）"},
          {"x": 183, "y": 190, "text": "目标半径", "parameter": "bendRadius", "unit": " mm"},
          {"x": 180, "y": 213, "text": "最大弓高误差", "parameter": "maximumChordError", "unit": " mm"}
        ]
      }
    ],
    "labels": [
      {
        "x": 150,
        "y": 18,
        "text": "总折弯角 β",
        "parameter": "angle",
        "unit": "°"
      },
      {
        "x": 225,
        "y": 90,
        "text": "槽数 n",
        "parameter": "segmentCount"
      },
      { "x": 85, "y": 158, "text": "槽距 p（按离散模型）" },
      {
        "x": 183,
        "y": 190,
        "text": "目标半径",
        "parameter": "bendRadius",
        "unit": " mm"
      },
      {
        "x": 180,
        "y": 213,
        "text": "内接弦 / 外切折线分开计算"
      }
    ],
    "annotations": [
      { "parameter": "angle", "kind": "leader", "side": "top", "point": [117, 100], "description": "全部分段槽折弯后形成的总角度" },
      { "parameter": "radiusDatum", "kind": "leader", "side": "right", "point": [76, 145], "description": "目标半径按内侧或截面中心线解释" },
      { "parameter": "bendRadius", "kind": "leader", "side": "right", "point": [70, 142], "description": "分段折弯逼近的目标圆弧半径" },
      { "parameter": "spacingModel", "kind": "leader", "side": "bottom", "point": [85, 138], "description": "内接弦使用 2R·sin(δ/2)，外切折线使用 2R·tan(δ/2)" },
      { "parameter": "countMode", "kind": "leader", "side": "top", "point": [120, 76], "description": "按指定槽数或最大弓高误差确定分段数" },
      { "parameter": "segmentCount", "kind": "leader", "side": "top", "point": [190, 82], "visibleWhen": { "op": "eq", "parameter": "countMode", "value": "count" }, "description": "沿展开长度布置的 V 槽数量" },
      { "parameter": "maximumChordError", "kind": "leader", "side": "top", "point": [190, 82], "visibleWhen": { "op": "eq", "parameter": "countMode", "value": "tolerance" }, "description": "圆弧与分段弦之间允许的最大误差" },
      { "parameter": "rootClearance", "kind": "linear", "axis": "y", "side": "left", "from": [50, 110], "to": [50, 125], "description": "每道槽根到目标管型内底面的距离" },
      { "parameter": "minimumLand", "kind": "linear", "axis": "x", "side": "bottom", "from": [50, 138], "to": [120, 138], "description": "相邻两槽之间必须保留的最小材料" },
      { "parameter": "bendCompensation", "kind": "leader", "side": "bottom", "point": [120, 110], "description": "决定每槽展开是否采用 K 因子补偿" },
      { "parameter": "kFactor", "kind": "leader", "side": "bottom", "point": [120, 110], "visibleWhen": { "op": "eq", "parameter": "bendCompensation", "value": true }, "description": "中性层位置系数" },
      { "parameter": "wallThickness", "kind": "leader", "side": "left", "point": [35, 40], "description": "由目标管型截面测得并用于分段计算" }
    ]
  },
  "parameters": [
    {
      "key": "angle",
      "displayName": "总折弯角 β（°）",
      "valueType": "number",
      "defaultValue": 90,
      "min": 1,
      "max": 170
    },
    {
      "key": "radiusDatum",
      "level": "advanced",
      "displayName": "半径基准",
      "valueType": "string",
      "defaultValue": "inner",
      "options": [
        {
          "value": "inner",
          "label": "内侧半径 Ri"
        },
        {
          "value": "centerline",
          "label": "截面中心线半径 Rc"
        }
      ]
    },
    {
      "key": "bendRadius",
      "displayName": "目标弯曲半径（mm，按所选基准）",
      "valueType": "number",
      "defaultValue": 40,
      "min": 0.01,
      "max": 100000
    },
    {
      "key": "spacingModel",
      "displayName": "分段间距模型",
      "valueType": "string",
      "defaultValue": "chord",
      "options": [
        { "value": "chord", "label": "内接弦（圆弧内侧）" },
        { "value": "tangent", "label": "外切折线（圆弧外侧）" }
      ]
    },
    {
      "key": "countMode",
      "displayName": "槽数确定方式",
      "valueType": "string",
      "defaultValue": "count",
      "options": [
        {
          "value": "count",
          "label": "指定槽数"
        },
        {
          "value": "tolerance",
          "label": "按最大弓高误差"
        }
      ]
    },
    {
      "key": "segmentCount",
      "displayName": "分段槽数 n",
      "valueType": "integer",
      "defaultValue": 6,
      "min": 2,
      "max": 64,
      "visibleWhen": {
        "op": "eq",
        "parameter": "countMode",
        "value": "count"
      }
    },
    {
      "key": "maximumChordError",
      "displayName": "最大弓高误差（mm）",
      "valueType": "number",
      "defaultValue": 0.5,
      "min": 0.000001,
      "max": 1000,
      "visibleWhen": {
        "op": "eq",
        "parameter": "countMode",
        "value": "tolerance"
      }
    },
    {
      "key": "rootClearance",
      "displayName": "槽根到内底面距离（mm）",
      "valueType": "number",
      "defaultValue": 1,
      "min": 0,
      "max": 10000
    },
    {
      "key": "minimumLand",
      "displayName": "相邻槽最小剩余间隔（mm）",
      "valueType": "number",
      "defaultValue": 1,
      "min": 0.01,
      "max": 10000
    },
    {
      "key": "bendCompensation",
      "level": "advanced",
      "displayName": "启用每槽 K 因子补偿",
      "valueType": "boolean",
      "defaultValue": false
    },
    {
      "key": "kFactor",
      "level": "advanced",
      "displayName": "K 因子（需按材料和工艺标定）",
      "valueType": "number",
      "defaultValue": 0.62,
      "min": 0,
      "max": 1,
      "visibleWhen": {
        "op": "eq",
        "parameter": "bendCompensation",
        "value": true
      }
    },
    {
      "key": "wallThickness",
      "displayName": "截面实测壁厚（mm）",
      "valueType": "number",
      "defaultValue": 0,
      "min": 0,
      "max": 10000,
      "derived": true,
      "readOnly": true
    }
  ]
}
