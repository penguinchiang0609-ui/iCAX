      "defaultValue": 0,
      "min": 0,
      "max": 10000
    },
    {
      "key": "reliefLift",
      "displayName": "附加释放孔中心上移（mm）",
      "valueType": "number",
      "defaultValue": 0,
      "min": 0,
      "max": 10000
