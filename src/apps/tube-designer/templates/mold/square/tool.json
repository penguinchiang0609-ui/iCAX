{
  "schema": "icax.punch-tool",
  "schemaVersion": 1,
  "id": "square",
  "version": "1.0.0",
  "displayName": "方孔",
  "kind": "programmatic",
  "target": "side",
  "category": "孔型",
  "inputs": [
    { "key": "targetSection", "displayName": "目标管型截面", "valueType": "profile", "required": true }
  ],
  "operationParameters": [
    { "key": "blindHole", "displayName": "盲孔", "valueType": "boolean", "defaultValue": false },
    { "key": "cutDepth", "displayName": "孔深", "valueType": "number", "defaultValue": 5, "min": 0.1, "max": 100000, "step": 0.1, "unit": "mm", "visibleWhen": { "op": "eq", "parameter": "blindHole", "value": true } },
    { "key": "opposite", "displayName": "对冲孔", "valueType": "boolean", "defaultValue": false }
  ],
  "parameters": [
    {
      "key": "size",
      "displayName": "边长",
      "valueType": "number",
      "defaultValue": 10,
      "min": 0.1,
      "max": 100000,
      "step": 0.1
    }
  ],
  "parameterDiagram": {
    "schemaVersion": 2,
    "viewBox": "0 0 140 120",
    "paths": ["M30 20 H110 V100 H30 Z"],
    "annotations": [
      { "parameter": "size", "kind": "linear", "axis": "x", "side": "bottom", "from": [30, 60], "to": [110, 60], "description": "方孔四边等长" }
    ]
  }
}
