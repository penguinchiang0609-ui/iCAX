        "x": 120,
        "y": 110,
        "text": "大圆直径 D",
        "parameter": "headDiameter",
        "unit": " mm"
      },
      {
        "x": 120,
        "y": 135,
        "text": "颈部宽度 W",
        "parameter": "neckWidth",
        "unit": " mm"
      },
      {
        "x": 120,
        "y": 160,
        "text": "圆心至颈端圆心距 C",
        "parameter": "centerDistance",
        "unit": " mm"
      }
