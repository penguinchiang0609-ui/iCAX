{
  "schema": "icax.punch-tool",
  "schemaVersion": 1,
  "id": "keyhole",
  "version": "1.0.0",
  "displayName": "钥匙孔",
  "kind": "programmatic",
  "target": "side",
  "category": "孔型",
  "description": "圆头连接圆端颈部，颈端半径为 W/2；C 从大圆圆心量至颈端圆心。当前为圆端颈，不包含平端或双圆相交变体。",
  "inputs": [
    { "key": "targetSection", "displayName": "目标管型截面", "valueType": "profile", "required": true }
  ],
  "operationParameters": [
    { "key": "blindHole", "displayName": "盲孔", "valueType": "boolean", "defaultValue": false },
    { "key": "cutDepth", "displayName": "孔深", "valueType": "number", "defaultValue": 5, "min": 0.1, "max": 100000, "step": 0.1, "unit": "mm", "visibleWhen": { "op": "eq", "parameter": "blindHole", "value": true } },
    { "key": "opposite", "displayName": "对冲孔", "valueType": "boolean", "defaultValue": false }
  ],
  "illustration": {
    "viewBox": "0 0 48 48",
    "paths": [
      "M26.39 18 H36 A6 6 0 0 1 36 30 H26.39 A12 12 0 1 1 26.39 18 Z"
    ]
  },
  "parameters": [
    {
      "key": "headDiameter",
      "displayName": "大圆直径 D（mm）",
      "valueType": "number",
      "defaultValue": 20,
      "min": 0.1,
      "max": 100000,
      "step": 0.1
    },
    {
      "key": "neckWidth",
      "displayName": "颈部宽度 W（mm）",
      "valueType": "number",
      "defaultValue": 8,
      "min": 0.1,
      "max": 100000,
      "step": 0.1
    },
    {
      "key": "centerDistance",
      "displayName": "圆心至颈端圆心距 C（mm）",
      "valueType": "number",
      "defaultValue": 18,
      "min": 0.1,
      "max": 100000,
      "step": 0.1
    }
  ],
  "parameterDiagram": {
    "schemaVersion": 2,
    "viewBox": "0 0 240 180",
    "paths": [
      "M122.913 40 H145 A10 10 0 0 1 145 60 H122.913 A25 25 0 1 1 122.913 40 Z"
    ],
    "labels": [
      {"x": 52, "y": 54, "text": "D"},
      {"x": 181, "y": 54, "text": "W"},
      {"x": 123, "y": 80, "text": "C"},
