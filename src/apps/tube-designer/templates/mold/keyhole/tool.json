    "annotations": [
      { "parameter": "headDiameter", "kind": "linear", "axis": "y", "side": "left", "from": [100, 25], "to": [100, 75], "description": "钥匙孔头部大圆直径" },
      { "parameter": "neckWidth", "kind": "linear", "axis": "y", "side": "right", "from": [145, 40], "to": [145, 60], "description": "颈部两条平边之间的宽度" },
      { "parameter": "centerDistance", "kind": "linear", "axis": "x", "side": "bottom", "from": [100, 50], "to": [145, 50], "description": "大圆圆心至颈端圆心的距离" }
