    { "key": "floorHeight", "displayName": { "zh-CN": "层高" }, "valueType": "number", "quantity": "length", "unit": "mm", "defaultValue": 3000.0, "constraints": { "minimum": 500.0, "maximum": 10000.0, "step": 1.0 }, "group": "overall", "order": 20 },
    { "key": "stairWidth", "displayName": { "zh-CN": "梯段净宽" }, "valueType": "number", "quantity": "length", "unit": "mm", "defaultValue": 1100.0, "constraints": { "minimum": 400.0, "maximum": 3000.0, "step": 1.0 }, "group": "overall", "order": 30 },
