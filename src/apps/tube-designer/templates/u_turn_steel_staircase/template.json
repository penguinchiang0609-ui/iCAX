        { "value": "reinforced_outdoor", "values": { "stringerWidth": 120.0, "stringerDepth": 60.0, "stringerCornerRadius": 4.0, "stringerWallThickness": 4.0, "treadWidth": 50.0, "treadDepthProfile": 50.0, "treadCornerRadius": 3.0, "treadWallThickness": 3.0, "handrailWidth": 50.0, "handrailDepth": 40.0, "handrailCornerRadius": 2.0, "handrailWallThickness": 2.0, "postWidth": 50.0, "postDepth": 40.0, "postCornerRadius": 2.0, "postWallThickness": 2.0 } }
      ]
    }
  },
