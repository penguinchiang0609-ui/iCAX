    { "key": "flight", "displayName": { "zh-CN": "双跑与平台" }, "order": 20 },
    { "key": "railing", "displayName": { "zh-CN": "护栏布置" }, "order": 30 },
    { "key": "preset", "displayName": { "zh-CN": "常用型材配套" }, "order": 40 },
    { "key": "profiles", "displayName": { "zh-CN": "型材规格" }, "order": 50 },
    { "key": "process", "displayName": { "zh-CN": "装配与加工" }, "order": 60 }
