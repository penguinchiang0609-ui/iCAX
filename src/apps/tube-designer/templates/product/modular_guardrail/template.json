        "zh-CN": "第 2 边长度"
      },
      "valueType": "number",
      "defaultValue": 1500,
      "group": "basic",
      "order": 40,
      "quantity": "length",
      "unit": "mm",
      "constraints": {
        "minimum": 100,
        "maximum": 30000,
        "step": 1
      },
      "visibleWhen": {
        "op": "ne",
        "parameter": "layout",
        "value": "straight"
      }
    },
    {
      "key": "sideLength3",
      "displayName": {
        "zh-CN": "第 3 边长度"
      },
      "valueType": "number",
      "defaultValue": 1500,
      "group": "basic",
      "order": 50,
      "quantity": "length",
      "unit": "mm",
      "constraints": {
        "minimum": 100,
        "maximum": 30000,
        "step": 1
      },
      "visibleWhen": {
        "op": "eq",
        "parameter": "layout",
        "value": "u"
      }
    },
    {
      "key": "guardHeight",
      "displayName": {
        "zh-CN": "主防护框架高度"
      },
      "valueType": "number",
      "defaultValue": 1200,
      "group": "basic",
      "order": 60,
      "quantity": "length",
      "unit": "mm",
      "constraints": {
        "minimum": 300,
        "maximum": 2500,
        "step": 1
