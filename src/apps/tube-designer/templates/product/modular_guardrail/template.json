{
  "schema": "icax.template-descriptor",
  "schemaVersion": 1,
  "id": "modular-guardrail",
  "version": "1.1.0",
  "displayName": {
    "zh-CN": "三横档直式"
  },
  "description": "三横档直式。由独立产品模板定义，参数和真实加工零件共用同一套生成规则。",
  "extensions": {
    "parameterRules": [
      {
        "when": { "guardrailUse": "wall" },
        "set": { "infillType": "bars" },
        "description": "围墙出头竖杆仅支持竖杆填充。"
      }
    ],
    "catalog": {
      "groupOrder": 20,
      "templateOrder": 5,
      "categoryPath": [
        "护栏",
        "竖杆护栏"
      ]
    },
    "productIdentity": {
      "codeParameter": "productCode"
    },
    "primaryDimensions": {
      "widthParameter": "sideLength1",
      "heightParameter": "guardHeight",
      "depthParameter": "sideLength2"
    },
    "modelResources": {
      "post-cap": {
        "path": "resource/post-cap.icaxmodel.json",
        "name": "模板示例：80方柱平盖",
        "category": "护栏/柱帽",
        "sourcing": "purchased",
        "material": "Q235B",
        "description": "模板内声明的真实固定尺寸柱帽模型；XY居中、底面Z=0，80方柱顶面焊接用。"
      }
    }
  },
  "groups": [
    {
      "key": "basic",
      "displayName": {
        "zh-CN": "形状与尺寸"
      },
      "order": 10
    },
    {
      "key": "layout",
      "displayName": {
        "zh-CN": "横档与立柱"
      },
      "order": 20
    },
    {
      "key": "infill",
      "displayName": {
        "zh-CN": "竖杆与封板"
      },
      "order": 30
    },
    {
      "key": "profiles",
      "displayName": {
        "zh-CN": "管材规格"
      },
      "order": 40
    },
    {
      "key": "process",
      "displayName": {
        "zh-CN": "安装底板"
      },
      "order": 50
    },
    {
      "key": "components",
      "displayName": {
        "zh-CN": "真实配件模型"
      },
      "order": 60
    }
