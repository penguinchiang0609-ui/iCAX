      "order": 0,
      "constraints": {
        "minimumLength": 1,
        "maximumLength": 80
      }
    },
    {
      "key": "layout",
      "displayName": {
        "zh-CN": "平面形状"
      },
      "valueType": "enum",
      "defaultValue": "straight",
      "group": "basic",
      "order": 10,
      "choices": [
        {
          "value": "straight",
          "displayName": {
            "zh-CN": "直式"
          }
        },
        {
          "value": "left_l",
          "displayName": {
            "zh-CN": "左转 L 型"
          }
        },
        {
          "value": "right_l",
          "displayName": {
            "zh-CN": "右转 L 型"
          }
        },
        {
          "value": "u",
          "displayName": {
            "zh-CN": "U 型"
          }
        }
      ],
      "description": "沿第 1 边正向行进判断左、右；U 型依次左转两次。"
    },
    {
      "key": "dimensionMode",
