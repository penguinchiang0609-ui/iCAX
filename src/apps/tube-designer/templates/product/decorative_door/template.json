{
  "schema": "icax.template-descriptor",
  "schemaVersion": 1,
  "id": "decorative-door",
  "version": "1.0.0",
  "displayName": {
    "zh-CN": "雕花装饰门"
  },
  "description": "参数化门扇与门面装饰：铣线格栅、几何圆景、菱形／八角花格、直壁池板扣线及玻璃门花。包含加工几何与板件拆单，不包含艺术浮雕、门框五金选型或雕刻机NC刀路。",
  "extensions": {
    "catalog": {
      "categoryPath": [
        "门"
      ],
      "groupOrder": 20,
      "templateOrder": 10
    },
    "productIdentity": {
      "codeParameter": "productCode"
    },
    "primaryDimensions": {
      "widthParameter": "width",
      "heightParameter": "height"
    },
    "parameterLayout": {
      "sections": [
        { "key": "product", "displayName": { "zh-CN": "产品规格" }, "order": 10, "defaultOpen": true, "groups": ["door", "design", "array"] },
        { "key": "materials", "displayName": { "zh-CN": "管材与材料" }, "order": 20, "allowPresets": true, "groups": ["material"] },
        { "key": "process", "displayName": { "zh-CN": "加工与装配工艺" }, "order": 30, "allowPresets": true, "groups": ["process", "safe"] }
      ]
    }
  },
  "groups": [
    {
      "key": "door",
      "displayName": {
        "zh-CN": "门体"
      }
    },
    {
      "key": "design",
      "displayName": {
        "zh-CN": "花型与版式"
      }
    },
    {
      "key": "array",
      "displayName": {
        "zh-CN": "阵列"
      }
    },
    {
      "key": "process",
      "displayName": {
        "zh-CN": "加工几何"
      }
    },
    {
      "key": "safe",
      "displayName": {
        "zh-CN": "边界与五金避让"
      }
    },
    {
      "key": "material",
      "displayName": {
        "zh-CN": "材料与表面备注"
      }
    }
  ],
  "parameters": [
    {
      "key": "productCode",
      "displayName": {
        "zh-CN": "产品编号"
