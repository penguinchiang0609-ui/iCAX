        "zh-CN": "扇间门缝"
      },
      "valueType": "number",
      "defaultValue": 4,
      "group": "door",
      "constraints": {
        "minimum": 1,
        "maximum": 30
      },
      "quantity": "length",
      "unit": "mm",
      "visibleWhen": {
        "op": "ne",
        "parameter": "doorType",
        "value": "single"
