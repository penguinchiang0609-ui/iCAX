      "displayName": {
        "zh-CN": "门体结构"
      },
      "valueType": "enum",
      "defaultValue": "double",
      "group": "door",
      "choices": [
        {
          "value": "single",
          "displayName": {
            "zh-CN": "单开"
          }
        },
        {
          "value": "double",
          "displayName": {
            "zh-CN": "双开"
          }
        },
        {
          "value": "mother",
          "displayName": {
            "zh-CN": "子母"
          }
        },
        {
          "value": "multi",
          "displayName": {
            "zh-CN": "多扇"
          }
        }
      ]
    },
    {
      "key": "width",
      "displayName": {
        "zh-CN": "门扇组合总宽"
      },
      "valueType": "number",
      "defaultValue": 1800,
      "group": "door",
      "constraints": {
        "minimum": 300,
        "maximum": 10000
      },
      "quantity": "length",
      "unit": "mm"
    },
    {
      "key": "height",
      "displayName": {
        "zh-CN": "门扇高度"
      },
      "valueType": "number",
      "defaultValue": 2200,
      "group": "door",
      "constraints": {
        "minimum": 300,
        "maximum": 4000
      },
      "quantity": "length",
      "unit": "mm"
