    {"key":"leftWidth","displayName":{"zh-CN":"左侧外飘深度"},"valueType":"number","quantity":"length","unit":"mm","defaultValue":600,"constraints":{"minimum":150,"maximum":20000,"step":1},"group":"overall","order":40},
