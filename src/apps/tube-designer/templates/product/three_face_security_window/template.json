  "parameters": [
    {"key":"sideMaximumVerticalClearGap","displayName":{"zh-CN":"侧面最大竖杆净间距"},"description":"自动净距模式下按各侧面实际净宽独立计算根数；默认110 mm是设计布置值，不是通用验收结论。","valueType":"number","quantity":"length","unit":"mm","defaultValue":110,"constraints":{"minimum":20,"maximum":500,"step":1},"group":"side_grid","order":30,"visibleWhen":{"op":"eq","parameter":"verticalLayoutMode","value":"maximum_clear_gap"}},
    {"key":"sideVerticalCount","displayName":{"zh-CN":"侧面竖杆数量"},"valueType":"integer","quantity":"count","defaultValue":4,"constraints":{"minimum":0,"maximum":100,"step":1},"group":"side_grid","order":20,"visibleWhen":{"op":"eq","parameter":"verticalLayoutMode","value":"manual_count"}},
    {"key":"sideHorizontalCount","displayName":{"zh-CN":"侧面横杆数量"},"description":"左右侧面共用此数量，按各自侧深分别布置。","valueType":"integer","quantity":"count","defaultValue":4,"constraints":{"minimum":0,"maximum":100,"step":1},"group":"side_grid","order":10},
    {"key":"frameCornerJoin","displayName":{"zh-CN":"外框转角连接"},"description":"拼角方案由分段直管焊成，不是整根管连续折弯。目前上下框45°拼角要求方形外框截面；显示为未切角原管装配，生产零件含实际斜切。","valueType":"enum","defaultValue":"post_butt","choices":[{"value":"post_butt","displayName":{"zh-CN":"立柱通长，横梁直拼"}},{"value":"rail_miter","displayName":{"zh-CN":"上下框45°拼角，立柱夹接"}}],"group":"assembly","order":2},
    {"key":"mainHorizontalConnection","displayName":{"zh-CN":"横杆与外框连接"},"description":"插接用于定位，插入后仍需焊接；贴合焊接采用平切端面，须匹配外框平直接触面。开启口边框处均直拼，竖杆仍穿过横杆。","valueType":"enum","defaultValue":"insert","choices":[{"value":"insert","displayName":{"zh-CN":"插入定位后焊接"}},{"value":"weld","displayName":{"zh-CN":"贴合焊接"}}],"group":"assembly","order":1},
    {"key":"doorUse","displayName":{"zh-CN":"开启口用途"},"valueType":"enum","defaultValue":"escape","choices":[{"value":"escape","displayName":{"zh-CN":"应急开启口"}},{"value":"maintenance","displayName":{"zh-CN":"检修口（不作逃生口）"}}],"group":"door_position","order":3,"visibleWhen":{"op":"eq","parameter":"accessDoorEnabled","value":true}},
    {"key":"doorClearWidth","displayName":{"zh-CN":"目标通行净宽"},"description":"应急用途采用800×1000 mm设计目标，不代替当地规定或现场开启验证。","valueType":"number","quantity":"length","unit":"mm","defaultValue":800,"constraints":{"minimum":1,"maximum":20000,"step":1},"group":"door_position","order":31,"visibleWhen":{"op":"eq","parameter":"accessDoorEnabled","value":true}},
    {"key":"doorClearHeight","displayName":{"zh-CN":"目标通行净高"},"description":"应急用途采用800×1000 mm设计目标，不代替当地规定或现场开启验证。","valueType":"number","quantity":"length","unit":"mm","defaultValue":1000,"constraints":{"minimum":1,"maximum":20000,"step":1},"group":"door_position","order":32,"visibleWhen":{"op":"eq","parameter":"accessDoorEnabled","value":true}},
    {"key":"doorHardwareClearance","displayName":{"zh-CN":"五金额外占宽预留"},"description":"在窗扇厚度之外增加的五金占宽预留，实际五金和开启包络须核验。","valueType":"number","quantity":"length","unit":"mm","defaultValue":10,"constraints":{"minimum":0,"maximum":20000,"step":1},"group":"door_position","order":33,"visibleWhen":{"op":"eq","parameter":"accessDoorEnabled","value":true}},
    {"key":"materialGrade","displayName":{"zh-CN":"材料牌号"},"valueType":"enum","defaultValue":"304","choices":[{"value":"unspecified","displayName":{"zh-CN":"未指定"}},{"value":"304","displayName":{"zh-CN":"304不锈钢"}},{"value":"316L","displayName":{"zh-CN":"316L不锈钢"}},{"value":"Q235B","displayName":{"zh-CN":"Q235B钢"}}],"group":"site_review","order":10},
    {"key":"surfaceTreatment","displayName":{"zh-CN":"表面及焊后处理"},"valueType":"enum","defaultValue":"passivated","choices":[{"value":"unspecified","displayName":{"zh-CN":"待确认"}},{"value":"passivated","displayName":{"zh-CN":"清理焊斑并钝化"}},{"value":"galvanized","displayName":{"zh-CN":"热浸镀锌及损伤修补"}},{"value":"coated","displayName":{"zh-CN":"防腐底漆与面层"}}],"group":"site_review","order":20},
    {"key":"productCode","displayName":{"zh-CN":"产品编号"},"valueType":"string","defaultValue":"TD-3F-001","constraints":{"minimumLength":1,"maximumLength":80},"group":"overall","order":10},
