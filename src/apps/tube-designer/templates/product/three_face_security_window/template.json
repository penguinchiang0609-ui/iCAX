    {"key":"maximumVerticalClearGap","displayName":{"zh-CN":"正面及窗扇最大竖杆净间距"},"valueType":"number","quantity":"length","unit":"mm","defaultValue":110,"constraints":{"minimum":20,"maximum":500,"step":1},"group":"grid","order":30,"visibleWhen":{"op":"eq","parameter":"verticalLayoutMode","value":"maximum_clear_gap"}},
