{
  "schema": "icax.template-descriptor",
  "schemaVersion": 1,
  "id": "single-face-security-window",
  "version": "2.5.0",
  "displayName": {
    "zh-CN": "单面防盗窗",
    "en-US": "Single-face Security Window"
  },
  "description": "由参数化外框、格栅和可选检修门组成。领域规则在 Python 中，中性建模数据由 C++ 执行。",
  "extensions": {
    "productIdentity": {
      "codeParameter": "productCode"
    },
    "primaryDimensions": {
      "widthParameter": "width",
      "heightParameter": "height"
    },
    "parameterPresets": {
      "selectorParameter": "tubeSpecificationPreset",
      "customValue": "custom",
      "presets": [
        { "value": "stainless_balanced", "values": { "frameWidth": 38.0, "frameDepth": 25.0, "frameCornerRadius": 2.0, "frameWallThickness": 1.2, "horizontalWidth": 25.0, "horizontalDepth": 25.0, "horizontalCornerRadius": 2.0, "horizontalWallThickness": 1.0, "verticalProfileType": "round", "verticalWidth": 19.0, "verticalDepth": 19.0, "verticalCornerRadius": 0.0, "verticalWallThickness": 1.0 } },
        { "value": "stainless_standard", "values": { "frameWidth": 38.0, "frameDepth": 25.0, "frameCornerRadius": 2.0, "frameWallThickness": 1.0, "horizontalWidth": 22.0, "horizontalDepth": 22.0, "horizontalCornerRadius": 2.0, "horizontalWallThickness": 1.0, "verticalProfileType": "round", "verticalWidth": 16.0, "verticalDepth": 16.0, "verticalCornerRadius": 0.0, "verticalWallThickness": 0.8 } },
        { "value": "stainless_reinforced", "values": { "frameWidth": 38.0, "frameDepth": 38.0, "frameCornerRadius": 3.0, "frameWallThickness": 1.5, "horizontalWidth": 28.0, "horizontalDepth": 28.0, "horizontalCornerRadius": 2.0, "horizontalWallThickness": 1.2, "verticalProfileType": "round", "verticalWidth": 22.0, "verticalDepth": 22.0, "verticalCornerRadius": 0.0, "verticalWallThickness": 1.0 } },
        { "value": "galvanized_square", "values": { "frameWidth": 32.0, "frameDepth": 32.0, "frameCornerRadius": 2.0, "frameWallThickness": 1.2, "horizontalWidth": 25.0, "horizontalDepth": 25.0, "horizontalCornerRadius": 2.0, "horizontalWallThickness": 1.0, "verticalProfileType": "rect", "verticalWidth": 19.0, "verticalDepth": 19.0, "verticalCornerRadius": 1.5, "verticalWallThickness": 0.8 } }
      ]
    }
  },
  "groups": [
    { "key": "structure", "displayName": { "zh-CN": "结构" }, "order": 10 },
    { "key": "overall", "displayName": { "zh-CN": "基本尺寸" }, "order": 20 },
    { "key": "main_grid", "displayName": { "zh-CN": "主格栅" }, "order": 30 },
    { "key": "door_position", "displayName": { "zh-CN": "检修门位置" }, "order": 40 },
    { "key": "door_assembly", "displayName": { "zh-CN": "检修门装配" }, "order": 50 },
    { "key": "door_grid", "displayName": { "zh-CN": "门扇格栅" }, "order": 60 },
    { "key": "outer_process", "displayName": { "zh-CN": "大外框工艺" }, "order": 70 },
    { "key": "door_frame_process", "displayName": { "zh-CN": "固定门框工艺" }, "order": 80 },
    { "key": "door_leaf_process", "displayName": { "zh-CN": "活动门扇框工艺" }, "order": 90 },
    { "key": "groove_process", "displayName": { "zh-CN": "管材转角 V 槽参数" }, "order": 100 },
    { "key": "profile_preset", "displayName": { "zh-CN": "常用管材配套" }, "order": 105 },
    { "key": "outer_profile", "displayName": { "zh-CN": "大外框矩形管" }, "order": 110 },
    { "key": "horizontal_profile", "displayName": { "zh-CN": "主横杆矩形管" }, "order": 120 },
    { "key": "vertical_profile", "displayName": { "zh-CN": "主竖杆圆管" }, "order": 130 },
    { "key": "door_frame_profile", "displayName": { "zh-CN": "固定门框矩形管" }, "order": 140 },
    { "key": "door_leaf_profile", "displayName": { "zh-CN": "活动门扇框矩形管" }, "order": 150 },
    { "key": "door_horizontal_profile", "displayName": { "zh-CN": "门内横杆矩形管" }, "order": 160 },
    { "key": "door_vertical_profile", "displayName": { "zh-CN": "门内竖杆圆管" }, "order": 170 },
    { "key": "assembly", "displayName": { "zh-CN": "装配" }, "order": 180 }
  ],
  "parameters": [
    {
      "key": "frameLayout", "displayName": { "zh-CN": "外框布置" },
      "valueType": "enum", "defaultValue": "left_right", "group": "structure", "order": 10,
      "choices": [
        { "value": "left_right", "displayName": { "zh-CN": "仅左右边框" } },
        { "value": "top_bottom", "displayName": { "zh-CN": "仅上下边框" } },
        { "value": "four_sides", "displayName": { "zh-CN": "四边边框" } }
      ]
    },
    {
      "key": "accessDoorEnabled", "displayName": { "zh-CN": "检修门" },
      "valueType": "boolean", "defaultValue": false, "group": "structure", "order": 20
    },
    {
      "key": "productCode", "displayName": { "zh-CN": "产品编号" },
      "valueType": "string", "defaultValue": "TD-SF-001", "group": "overall", "order": 10,
      "constraints": { "minimumLength": 1, "maximumLength": 80 }
    },
    {
      "key": "height", "displayName": { "zh-CN": "产品高度" },
      "description": "产品外包高度。", "valueType": "number", "quantity": "length", "unit": "mm",
      "defaultValue": 1800.0, "constraints": { "minimum": 1.0, "maximum": 20000.0, "step": 1.0 },
      "group": "overall", "order": 20
    },
    {
      "key": "width", "displayName": { "zh-CN": "产品宽度" },
      "description": "产品外包宽度。", "valueType": "number", "quantity": "length", "unit": "mm",
      "defaultValue": 1200.0, "constraints": { "minimum": 1.0, "maximum": 20000.0, "step": 1.0 },
      "group": "overall", "order": 30
    },
    {
      "key": "horizontalCount", "displayName": { "zh-CN": "主横杆数量" },
      "valueType": "integer", "quantity": "count", "defaultValue": 4,
      "constraints": { "minimum": 0, "maximum": 100, "step": 1 }, "group": "main_grid", "order": 10
    },
    {
      "key": "verticalLayoutMode", "displayName": { "zh-CN": "竖杆布置" },
      "valueType": "enum", "defaultValue": "maximum_clear_gap",
      "choices": [
        { "value": "maximum_clear_gap", "displayName": { "zh-CN": "按最大净间距自动计算" } },
        { "value": "manual_count", "displayName": { "zh-CN": "手动指定数量" } }
      ], "group": "main_grid", "order": 20
    },
    {
      "key": "maximumVerticalClearGap", "displayName": { "zh-CN": "最大竖杆净间距" },
      "valueType": "number", "quantity": "length", "unit": "mm", "defaultValue": 110.0,
      "constraints": { "minimum": 20.0, "maximum": 500.0, "step": 1.0 }, "group": "main_grid", "order": 30,
      "visibleWhen": { "op": "eq", "parameter": "verticalLayoutMode", "value": "maximum_clear_gap" }
    },
    {
      "key": "middleVerticalCount", "displayName": { "zh-CN": "主竖杆数量" },
      "valueType": "integer", "quantity": "count", "defaultValue": 9,
      "constraints": { "minimum": 0, "maximum": 100, "step": 1 }, "group": "main_grid", "order": 40,
      "visibleWhen": { "op": "eq", "parameter": "verticalLayoutMode", "value": "manual_count" }
    },
    {
      "key": "firstHorizontalTopOffset", "displayName": { "zh-CN": "首横杆距顶部" },
      "valueType": "number", "quantity": "length", "unit": "mm", "defaultValue": 200.0,
      "constraints": { "minimum": 0, "step": 1 }, "group": "main_grid", "order": 50
    },
    {
      "key": "lastHorizontalBottomOffset", "displayName": { "zh-CN": "末横杆距底部" },
      "valueType": "number", "quantity": "length", "unit": "mm", "defaultValue": 200.0,
      "constraints": { "minimum": 0, "step": 1 }, "group": "main_grid", "order": 60
    },

    {
      "key": "doorLeft", "displayName": { "zh-CN": "门框左边距" },
      "valueType": "number", "quantity": "length", "unit": "mm", "defaultValue": 450.0,
      "constraints": { "minimum": 0, "step": 1 }, "group": "door_position", "order": 10,
      "visibleWhen": { "op": "eq", "parameter": "accessDoorEnabled", "value": true }
    },
    {
      "key": "doorBottom", "displayName": { "zh-CN": "门框底边距" },
      "valueType": "number", "quantity": "length", "unit": "mm", "defaultValue": 700.0,
      "constraints": { "minimum": 0, "step": 1 }, "group": "door_position", "order": 20,
      "visibleWhen": { "op": "eq", "parameter": "accessDoorEnabled", "value": true }
    },
    {
      "key": "doorWidth", "displayName": { "zh-CN": "门框宽度" },
      "valueType": "number", "quantity": "length", "unit": "mm", "defaultValue": 300.0,
      "constraints": { "minimum": 1, "step": 1 }, "group": "door_position", "order": 30,
      "visibleWhen": { "op": "eq", "parameter": "accessDoorEnabled", "value": true }
    },
    {
      "key": "doorHeight", "displayName": { "zh-CN": "门框高度" },
      "valueType": "number", "quantity": "length", "unit": "mm", "defaultValue": 360.0,
      "constraints": { "minimum": 1, "step": 1 }, "group": "door_position", "order": 40,
      "visibleWhen": { "op": "eq", "parameter": "accessDoorEnabled", "value": true }
    },
    {
      "key": "doorGap", "displayName": { "zh-CN": "门扇与门框间隙" },
      "valueType": "number", "quantity": "length", "unit": "mm", "defaultValue": 6.0,
      "constraints": { "minimum": 0, "step": 0.1 }, "group": "door_assembly", "order": 10,
      "visibleWhen": { "op": "eq", "parameter": "accessDoorEnabled", "value": true }
    },
    {
      "key": "doorHingeSide", "displayName": { "zh-CN": "铰链侧" },
      "valueType": "enum", "defaultValue": "left", "group": "door_assembly", "order": 20,
      "visibleWhen": { "op": "eq", "parameter": "accessDoorEnabled", "value": true },
      "choices": [
        { "value": "left", "displayName": { "zh-CN": "左侧" } },
        { "value": "right", "displayName": { "zh-CN": "右侧" } }
      ]
    },
    {
      "key": "doorHingeCount", "displayName": { "zh-CN": "铰链数量" },
      "valueType": "integer", "quantity": "count", "defaultValue": 2,
      "constraints": { "minimum": 1, "maximum": 10, "step": 1 }, "group": "door_assembly", "order": 30,
      "visibleWhen": { "op": "eq", "parameter": "accessDoorEnabled", "value": true }
    },
    {
      "key": "doorHorizontalCount", "displayName": { "zh-CN": "门内横杆数量" },
      "valueType": "integer", "quantity": "count", "defaultValue": 1,
      "constraints": { "minimum": 0, "maximum": 100, "step": 1 }, "group": "door_grid", "order": 10,
      "visibleWhen": { "op": "eq", "parameter": "accessDoorEnabled", "value": true }
    },
    {
      "key": "doorVerticalCount", "displayName": { "zh-CN": "门内竖杆数量" },
      "valueType": "integer", "quantity": "count", "defaultValue": 1,
      "constraints": { "minimum": 0, "maximum": 100, "step": 1 }, "group": "door_grid", "order": 20,
      "visibleWhen": { "op": "eq", "parameter": "accessDoorEnabled", "value": true }
    },

    {
      "key": "frameJoinType", "displayName": { "zh-CN": "大外框连接工艺" },
      "valueType": "enum", "defaultValue": "v_groove_90:sharp_v", "group": "outer_process", "order": 10,
      "visibleWhen": { "op": "eq", "parameter": "frameLayout", "value": "four_sides" },
      "choices": [
        { "value": "v_groove_90:sharp_v", "displayName": { "zh-CN": "连续折弯 · 尖角 V 槽" } },
        { "value": "v_groove_90:rounded_v", "displayName": { "zh-CN": "连续折弯 · 圆角 V 槽" } },
        { "value": "v_groove_90:left_arc", "displayName": { "zh-CN": "连续折弯 · 左圆弧 V 槽" } },
        { "value": "v_groove_90:right_arc", "displayName": { "zh-CN": "连续折弯 · 右圆弧 V 槽" } },
        { "value": "miter_45", "displayName": { "zh-CN": "45° 斜拼（四根管）" } },
        { "value": "butt_90", "displayName": { "zh-CN": "90° 直拼（四根管）" } }
      ]
    },
    {
      "key": "frameButtWrapMode", "displayName": { "zh-CN": "直拼包边方向" },
      "valueType": "enum", "defaultValue": "side_wraps_horizontal", "group": "outer_process", "order": 20,
      "visibleWhen": { "op": "all", "conditions": [
        { "op": "eq", "parameter": "frameLayout", "value": "four_sides" },
        { "op": "eq", "parameter": "frameJoinType", "value": "butt_90" }
      ] },
      "choices": [
        { "value": "side_wraps_horizontal", "displayName": { "zh-CN": "左右框包上下框" } },
        { "value": "horizontal_wraps_side", "displayName": { "zh-CN": "上下框包左右框" } }
      ]
    },
    {
      "key": "doorFrameJoinType", "displayName": { "zh-CN": "固定门框连接工艺" },
      "valueType": "enum", "defaultValue": "v_groove_90:sharp_v", "group": "door_frame_process", "order": 10,
      "visibleWhen": { "op": "eq", "parameter": "accessDoorEnabled", "value": true },
      "choices": [
        { "value": "v_groove_90:sharp_v", "displayName": { "zh-CN": "连续折弯 · 尖角 V 槽" } },
        { "value": "v_groove_90:rounded_v", "displayName": { "zh-CN": "连续折弯 · 圆角 V 槽" } },
        { "value": "v_groove_90:left_arc", "displayName": { "zh-CN": "连续折弯 · 左圆弧 V 槽" } },
        { "value": "v_groove_90:right_arc", "displayName": { "zh-CN": "连续折弯 · 右圆弧 V 槽" } },
        { "value": "miter_45", "displayName": { "zh-CN": "45° 斜拼（四根管）" } },
        { "value": "butt_90", "displayName": { "zh-CN": "90° 直拼（四根管）" } }
      ]
    },
    {
      "key": "doorFrameButtWrapMode", "displayName": { "zh-CN": "直拼包边方向" },
      "valueType": "enum", "defaultValue": "side_wraps_horizontal", "group": "door_frame_process", "order": 20,
      "visibleWhen": { "op": "all", "conditions": [
        { "op": "eq", "parameter": "accessDoorEnabled", "value": true },
        { "op": "eq", "parameter": "doorFrameJoinType", "value": "butt_90" }
      ] },
      "choices": [
        { "value": "side_wraps_horizontal", "displayName": { "zh-CN": "左右框包上下框" } },
        { "value": "horizontal_wraps_side", "displayName": { "zh-CN": "上下框包左右框" } }
      ]
    },
    {
      "key": "doorLeafFrameJoinType", "displayName": { "zh-CN": "活动门扇框连接工艺" },
      "valueType": "enum", "defaultValue": "v_groove_90:sharp_v", "group": "door_leaf_process", "order": 10,
      "visibleWhen": { "op": "eq", "parameter": "accessDoorEnabled", "value": true },
      "choices": [
        { "value": "v_groove_90:sharp_v", "displayName": { "zh-CN": "连续折弯 · 尖角 V 槽" } },
        { "value": "v_groove_90:rounded_v", "displayName": { "zh-CN": "连续折弯 · 圆角 V 槽" } },
        { "value": "v_groove_90:left_arc", "displayName": { "zh-CN": "连续折弯 · 左圆弧 V 槽" } },
        { "value": "v_groove_90:right_arc", "displayName": { "zh-CN": "连续折弯 · 右圆弧 V 槽" } },
        { "value": "miter_45", "displayName": { "zh-CN": "45° 斜拼（四根管）" } },
        { "value": "butt_90", "displayName": { "zh-CN": "90° 直拼（四根管）" } }
      ]
    },
    {
      "key": "doorLeafFrameButtWrapMode", "displayName": { "zh-CN": "直拼包边方向" },
      "valueType": "enum", "defaultValue": "side_wraps_horizontal", "group": "door_leaf_process", "order": 20,
      "visibleWhen": { "op": "all", "conditions": [
        { "op": "eq", "parameter": "accessDoorEnabled", "value": true },
        { "op": "eq", "parameter": "doorLeafFrameJoinType", "value": "butt_90" }
      ] },
      "choices": [
        { "value": "side_wraps_horizontal", "displayName": { "zh-CN": "左右框包上下框" } },
        { "value": "horizontal_wraps_side", "displayName": { "zh-CN": "上下框包左右框" } }
      ]
    },

    {
      "key": "vGrooveBottomDistance", "displayName": { "zh-CN": "槽底距外侧底面" },
      "valueType": "number", "quantity": "length", "unit": "mm", "defaultValue": 2.0,
      "constraints": { "minimum": 0, "step": 0.1 }, "group": "groove_process", "order": 10
    },
    {
      "key": "vGrooveRadius", "displayName": { "zh-CN": "圆角 V 槽 R 半径" },
      "valueType": "number", "quantity": "length", "unit": "mm", "defaultValue": 18.0,
      "constraints": { "minimum": 0, "step": 0.1 }, "group": "groove_process", "order": 20
    },
    {
      "key": "vGrooveKFactor", "displayName": { "zh-CN": "展开 K 因子" },
      "valueType": "number", "quantity": "ratio", "defaultValue": 0.62,
      "constraints": { "minimum": 0, "maximum": 1, "step": 0.01 }, "group": "groove_process", "order": 30
    },
    {
      "key": "vGrooveMaleFemale", "displayName": { "zh-CN": "斜切公母" },
      "valueType": "boolean", "defaultValue": false, "group": "groove_process", "order": 40
    },
    {
      "key": "vGrooveBottomCut", "displayName": { "zh-CN": "底部切除" },
      "valueType": "boolean", "defaultValue": false, "group": "groove_process", "order": 50
    },
    {
      "key": "vGrooveReliefHole", "displayName": { "zh-CN": "释放孔" },
      "valueType": "boolean", "defaultValue": false, "group": "groove_process", "order": 60
    },
    {
      "key": "vGrooveWallOvercut", "displayName": { "zh-CN": "壁厚过切" },
      "valueType": "boolean", "defaultValue": false, "group": "groove_process", "order": 70
    },
    {
      "key": "vGrooveReliefDiameter", "displayName": { "zh-CN": "释放孔直径" },
      "valueType": "number", "quantity": "length", "unit": "mm", "defaultValue": 10.0,
      "constraints": { "minimum": 0, "step": 0.1 }, "group": "groove_process", "order": 80,
      "visibleWhen": { "op": "eq", "parameter": "vGrooveReliefHole", "value": true }
    },
    {
      "key": "vGrooveReliefNoThrough", "displayName": { "zh-CN": "释放孔不过切" },
      "valueType": "boolean", "defaultValue": false, "group": "groove_process", "order": 90,
      "visibleWhen": { "op": "eq", "parameter": "vGrooveReliefHole", "value": true }
    },

    { "key": "tubeSpecificationPreset", "displayName": { "zh-CN": "规格组合" }, "valueType": "enum", "defaultValue": "stainless_balanced", "choices": [{ "value": "stainless_balanced", "displayName": { "zh-CN": "304不锈钢·38×25 / 25×25 / Φ19（推荐）" } }, { "value": "stainless_standard", "displayName": { "zh-CN": "不锈钢轻型·38×25 / 22×22 / Φ16" } }, { "value": "stainless_reinforced", "displayName": { "zh-CN": "不锈钢加强·38×38 / 28×28 / Φ22" } }, { "value": "galvanized_square", "displayName": { "zh-CN": "镀锌方管·32×32 / 25×25 / 19×19" } }, { "value": "custom", "displayName": { "zh-CN": "自定义" } }], "group": "profile_preset", "order": 10 },

    { "key": "frameProfileType", "displayName": { "zh-CN": "截面类型" }, "valueType": "enum", "defaultValue": "rect", "readOnly": true, "choices": [{ "value": "rect", "displayName": { "zh-CN": "矩形管" } }], "group": "outer_profile", "order": 10 },
    { "key": "frameWidth", "displayName": { "zh-CN": "截面宽度" }, "valueType": "number", "quantity": "length", "unit": "mm", "defaultValue": 38.0, "constraints": { "minimum": 1 }, "group": "outer_profile", "order": 20 },
    { "key": "frameDepth", "displayName": { "zh-CN": "截面深度" }, "valueType": "number", "quantity": "length", "unit": "mm", "defaultValue": 25.0, "constraints": { "minimum": 1 }, "group": "outer_profile", "order": 30 },
    { "key": "frameCornerRadius", "displayName": { "zh-CN": "外圆角 R" }, "valueType": "number", "quantity": "length", "unit": "mm", "defaultValue": 2.0, "constraints": { "minimum": 0 }, "group": "outer_profile", "order": 40 },
    { "key": "frameWallThickness", "displayName": { "zh-CN": "壁厚" }, "valueType": "number", "quantity": "length", "unit": "mm", "defaultValue": 1.2, "constraints": { "minimum": 0.1 }, "group": "outer_profile", "order": 50 },

    { "key": "horizontalProfileType", "displayName": { "zh-CN": "截面类型" }, "valueType": "enum", "defaultValue": "rect", "readOnly": true, "choices": [{ "value": "rect", "displayName": { "zh-CN": "矩形管" } }], "group": "horizontal_profile", "order": 10 },
    { "key": "horizontalWidth", "displayName": { "zh-CN": "截面宽度" }, "valueType": "number", "quantity": "length", "unit": "mm", "defaultValue": 25.0, "constraints": { "minimum": 1 }, "group": "horizontal_profile", "order": 20 },
    { "key": "horizontalDepth", "displayName": { "zh-CN": "截面深度" }, "description": "必须容纳贯穿横杆的竖杆截面并保留连续管壁。", "valueType": "number", "quantity": "length", "unit": "mm", "defaultValue": 25.0, "constraints": { "minimum": 1 }, "group": "horizontal_profile", "order": 30 },
