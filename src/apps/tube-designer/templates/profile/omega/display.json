        "legThickness": { "label": { "zh-CN": "直腿厚度 t₂" }, "group": "advanced", "order": 60, "editable": true, "suffix": " mm", "visibleWhen": { "op": "eq", "parameter": "useHotRolled", "value": true } },
        "flangeThickness": { "label": { "zh-CN": "平腿厚度 t₃" }, "group": "advanced", "order": 70, "editable": true, "suffix": " mm", "visibleWhen": { "op": "eq", "parameter": "useHotRolled", "value": true } },
