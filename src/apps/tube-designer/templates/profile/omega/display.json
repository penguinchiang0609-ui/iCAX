    "section": {
      "parameterDiagram": {
        "schemaVersion": 1,
        "annotations": [
          { "parameter": "width", "kind": "linear", "from": [ "-width/2", "depth/2" ], "to": [ "width/2", "depth/2" ], "axis": "x", "side": "top", "description": "帽顶中心线宽 B", "visibleWhen": { "op": "eq", "parameter": "useHotRolled", "value": false } },
          { "parameter": "depth", "kind": "linear", "from": [ "-width/2", "-depth/2" ], "to": [ "-width/2", "depth/2" ], "axis": "y", "side": "left", "description": "冷弯帽钢理论中心线高度 H", "visibleWhen": { "op": "eq", "parameter": "useHotRolled", "value": false } },
          { "parameter": "flangeWidth", "kind": "linear", "from": [ "width/2", "-depth/2" ], "to": [ "width/2+flangeWidth", "-depth/2" ], "axis": "x", "side": "bottom", "description": "单侧平腿中心线长度 F", "visibleWhen": { "op": "eq", "parameter": "useHotRolled", "value": false } },
          { "parameter": "wallThickness", "kind": "linear", "from": [ 0, "depth/2-wallThickness/2" ], "to": [ 0, "depth/2+wallThickness/2" ], "axis": "y", "side": "right", "description": "冷弯板厚 t", "visibleWhen": { "op": "eq", "parameter": "useHotRolled", "value": false } },
          { "parameter": "bendRadius", "kind": "leader", "point": [ "-width/2+bendRadius", "-depth/2+bendRadius" ], "side": "right", "description": "冷弯内弯 R", "visibleWhen": { "op": "eq", "parameter": "useHotRolled", "value": false } },
          { "parameter": "hotHeight", "kind": "linear", "from": [ "-(innerWidth/2+legThickness)", "-hotHeight/2" ], "to": [ "-(innerWidth/2+legThickness)", "hotHeight/2" ], "axis": "y", "side": "left", "description": "热轧总高 h", "visibleWhen": { "op": "eq", "parameter": "useHotRolled", "value": true } },
          { "parameter": "innerWidth", "kind": "linear", "from": [ "-innerWidth/2", "hotHeight/2" ], "to": [ "innerWidth/2", "hotHeight/2" ], "axis": "x", "side": "top", "description": "直腿内宽 b₁", "visibleWhen": { "op": "eq", "parameter": "useHotRolled", "value": true } },
          { "parameter": "hotFlangeWidth", "kind": "linear", "from": [ "innerWidth/2+legThickness", "-hotHeight/2" ], "to": [ "innerWidth/2+legThickness+hotFlangeWidth", "-hotHeight/2" ], "axis": "x", "side": "bottom", "description": "单侧平腿长 b₂", "visibleWhen": { "op": "eq", "parameter": "useHotRolled", "value": true } },
          { "parameter": "topThickness", "kind": "linear", "from": [ 0, "hotHeight/2-topThickness" ], "to": [ 0, "hotHeight/2" ], "axis": "y", "side": "right", "description": "顶部腰部厚度 t₁", "visibleWhen": { "op": "eq", "parameter": "useHotRolled", "value": true } },
          { "parameter": "legThickness", "kind": "linear", "from": [ "innerWidth/2", 0 ], "to": [ "innerWidth/2+legThickness", 0 ], "axis": "x", "side": "bottom", "description": "直腿厚度 t₂", "visibleWhen": { "op": "eq", "parameter": "useHotRolled", "value": true } },
          { "parameter": "flangeThickness", "kind": "linear", "from": [ "innerWidth/2+legThickness+hotFlangeWidth/2", "-hotHeight/2" ], "to": [ "innerWidth/2+legThickness+hotFlangeWidth/2", "-hotHeight/2+flangeThickness" ], "axis": "y", "side": "right", "description": "平腿厚度 t₃", "visibleWhen": { "op": "eq", "parameter": "useHotRolled", "value": true } },
          { "parameter": "rootRadius1", "kind": "leader", "point": [ "innerWidth/2+legThickness-rootRadius1", "hotHeight/2-topThickness+rootRadius1" ], "side": "right", "description": "腰部过渡 R₁", "visibleWhen": { "op": "eq", "parameter": "useHotRolled", "value": true } },
          { "parameter": "rootRadius2", "kind": "leader", "point": [ "innerWidth/2+legThickness-rootRadius2", "-hotHeight/2+flangeThickness+rootRadius2" ], "side": "right", "description": "直腿过渡 R₂", "visibleWhen": { "op": "eq", "parameter": "useHotRolled", "value": true } },
          { "parameter": "freeEndRadiusUpper", "kind": "leader", "point": [ "innerWidth/2+legThickness+hotFlangeWidth-freeEndRadiusUpper", "-hotHeight/2+flangeThickness-freeEndRadiusUpper" ], "side": "right", "description": "自由端上侧 R₃", "visibleWhen": { "op": "eq", "parameter": "useHotRolled", "value": true } },
          { "parameter": "freeEndRadiusLower", "kind": "leader", "point": [ "innerWidth/2+legThickness+hotFlangeWidth-freeEndRadiusLower", "-hotHeight/2+freeEndRadiusLower" ], "side": "right", "description": "自由端下侧 R₄", "visibleWhen": { "op": "eq", "parameter": "useHotRolled", "value": true } }
        ]
      }
