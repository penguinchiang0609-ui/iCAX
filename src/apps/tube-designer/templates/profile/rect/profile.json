      "defaultValue": ""
    },
    {
      "key": "innerCorners",
      "displayName": "内四角定义 JSON（左下起逆时针；留空沿用圆角参数）",
      "valueType": "string",
      "defaultValue": ""
    }
  ],
  "catalog": {
    "groupOrder": 1,
    "order": 1
  },
  "parameterDiagram": {
    "schemaVersion": 1,
    "annotations": [
