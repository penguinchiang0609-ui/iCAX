            {
              "op": "eq",
              "parameter": "innerDepth",
              "value": 0
            },
            {
              "op": "eq",
              "parameter": "innerOffsetX",
              "value": 0
            },
            {
              "op": "eq",
              "parameter": "innerOffsetY",
              "value": 0
            }
          ]
        }
      },
      {
        "parameter": "cornerRadius",
        "kind": "leader",
        "point": [
          "width/2-cornerRadius*(1-0.7071067811865476)",
          "depth/2-cornerRadius*(1-0.7071067811865476)"
        ],
        "side": "right",
        "description": "默认外角半径；逐角设置优先",
        "visibleWhen": {
          "op": "all",
          "conditions": [
            {
              "op": "eq",
              "parameter": "outerRadii",
              "value": ""
            },
            {
              "op": "eq",
              "parameter": "outerCorners",
              "value": ""
            }
          ]
        }
      }
    ]
