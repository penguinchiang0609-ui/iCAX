    "section": {
      "parameterDiagram": {
        "schemaVersion": 1,
        "annotations": [
          { "parameter": "depth", "kind": "linear", "from": [0, "-depth/2"], "to": [0, "depth/2"], "axis": "y", "side": "left", "description": "总高度 H" },
          { "parameter": "flangeWidth", "kind": "linear", "from": [0, "(depth-wallThickness)/2"], "to": ["flangeWidth", "(depth-wallThickness)/2"], "axis": "x", "side": "top", "description": "翼缘宽度 B" },
          { "parameter": "lipLength", "kind": "leader", "point": ["flangeWidth-lipLength*cos(lipAngle*0.0174532925199433)", "(depth-wallThickness)/2-lipLength*sin(lipAngle*0.0174532925199433)"], "side": "right", "description": "卷边长度 C" },
          { "parameter": "wallThickness", "kind": "linear", "from": ["-wallThickness/2", 0], "to": ["wallThickness/2", 0], "axis": "x", "side": "bottom", "description": "板厚 t" },
          { "parameter": "bendRadius", "kind": "leader", "point": ["wallThickness/2+bendRadius", "(depth-wallThickness)/2-wallThickness/2-bendRadius"], "side": "right", "description": "折弯内 R" },
          { "parameter": "centerWebOffset", "kind": "linear", "from": [0, 0], "to": ["centerWebOffset", 0], "axis": "x", "side": "bottom", "description": "中央腹板偏移 e" },
          { "parameter": "outerWebHeight", "kind": "linear", "from": [0, "(depth-wallThickness)/2-outerWebHeight"], "to": [0, "(depth-wallThickness)/2"], "axis": "y", "side": "left", "description": "外腹板直段 a" },
          { "parameter": "transitionRise", "kind": "linear", "from": [0, "(depth-wallThickness)/2-outerWebHeight-transitionRise"], "to": [0, "(depth-wallThickness)/2-outerWebHeight"], "axis": "y", "side": "left", "description": "斜过渡竖高 q" },
          { "parameter": "lipAngle", "kind": "leader", "point": ["flangeWidth", "(depth-wallThickness)/2"], "side": "right", "description": "卷边角度 θ" },
          { "parameter": "topFlangeWidth", "kind": "linear", "from": [0, "(depth-wallThickness)/2"], "to": ["topFlangeWidth", "(depth-wallThickness)/2"], "axis": "x", "side": "top", "description": "上翼缘 Bt", "visibleWhen": { "op": "eq", "parameter": "useIndependentSides", "value": true } },
          { "parameter": "bottomFlangeWidth", "kind": "linear", "from": [0, "-(depth-wallThickness)/2"], "to": ["bottomFlangeWidth", "-(depth-wallThickness)/2"], "axis": "x", "side": "bottom", "description": "下翼缘 Bb", "visibleWhen": { "op": "eq", "parameter": "useIndependentSides", "value": true } },
          { "parameter": "topLipLength", "kind": "leader", "point": ["topFlangeWidth-topLipLength*cos(topLipAngle*0.0174532925199433)", "(depth-wallThickness)/2-topLipLength*sin(topLipAngle*0.0174532925199433)"], "side": "right", "description": "上卷边 Ct", "visibleWhen": { "op": "eq", "parameter": "useIndependentSides", "value": true } },
          { "parameter": "bottomLipLength", "kind": "leader", "point": ["bottomFlangeWidth-bottomLipLength*cos(bottomLipAngle*0.0174532925199433)", "-(depth-wallThickness)/2+bottomLipLength*sin(bottomLipAngle*0.0174532925199433)"], "side": "right", "description": "下卷边 Cb", "visibleWhen": { "op": "eq", "parameter": "useIndependentSides", "value": true } },
          { "parameter": "topOuterWebHeight", "kind": "linear", "from": [0, "(depth-wallThickness)/2-topOuterWebHeight"], "to": [0, "(depth-wallThickness)/2"], "axis": "y", "side": "left", "description": "上外腹板 at", "visibleWhen": { "op": "eq", "parameter": "useIndependentSides", "value": true } },
          { "parameter": "bottomOuterWebHeight", "kind": "linear", "from": [0, "-(depth-wallThickness)/2"], "to": [0, "-(depth-wallThickness)/2+bottomOuterWebHeight"], "axis": "y", "side": "left", "description": "下外腹板 ab", "visibleWhen": { "op": "eq", "parameter": "useIndependentSides", "value": true } },
          { "parameter": "upperTransitionRise", "kind": "linear", "from": [0, "(depth-wallThickness)/2-topOuterWebHeight-upperTransitionRise"], "to": [0, "(depth-wallThickness)/2-topOuterWebHeight"], "axis": "y", "side": "left", "description": "上过渡 qt", "visibleWhen": { "op": "eq", "parameter": "useIndependentSides", "value": true } },
          { "parameter": "lowerTransitionRise", "kind": "linear", "from": [0, "-(depth-wallThickness)/2+bottomOuterWebHeight"], "to": [0, "-(depth-wallThickness)/2+bottomOuterWebHeight+lowerTransitionRise"], "axis": "y", "side": "left", "description": "下过渡 qb", "visibleWhen": { "op": "eq", "parameter": "useIndependentSides", "value": true } },
          { "parameter": "topLipAngle", "kind": "leader", "point": ["topFlangeWidth", "(depth-wallThickness)/2"], "side": "right", "description": "上卷边角 θt", "visibleWhen": { "op": "eq", "parameter": "useIndependentSides", "value": true } },
          { "parameter": "bottomLipAngle", "kind": "leader", "point": ["bottomFlangeWidth", "-(depth-wallThickness)/2"], "side": "right", "description": "下卷边角 θb", "visibleWhen": { "op": "eq", "parameter": "useIndependentSides", "value": true } },
          { "parameter": "bendRadius1", "kind": "leader", "point": ["flangeWidth", "(depth-wallThickness)/2-lipLength"], "side": "right", "description": "R1", "visibleWhen": { "op": "eq", "parameter": "useIndependentRadii", "value": true } },
          { "parameter": "bendRadius2", "kind": "leader", "point": [0, "(depth-wallThickness)/2"], "side": "left", "description": "R2", "visibleWhen": { "op": "eq", "parameter": "useIndependentRadii", "value": true } },
          { "parameter": "bendRadius3", "kind": "leader", "point": [0, "(depth-wallThickness)/2-outerWebHeight"], "side": "left", "description": "R3", "visibleWhen": { "op": "eq", "parameter": "useIndependentRadii", "value": true } },
          { "parameter": "bendRadius4", "kind": "leader", "point": ["centerWebOffset", "(depth-wallThickness)/2-outerWebHeight-transitionRise"], "side": "right", "description": "R4", "visibleWhen": { "op": "eq", "parameter": "useIndependentRadii", "value": true } },
          { "parameter": "bendRadius5", "kind": "leader", "point": ["centerWebOffset", "-(depth-wallThickness)/2+outerWebHeight+transitionRise"], "side": "right", "description": "R5", "visibleWhen": { "op": "eq", "parameter": "useIndependentRadii", "value": true } },
          { "parameter": "bendRadius6", "kind": "leader", "point": [0, "-(depth-wallThickness)/2+outerWebHeight"], "side": "left", "description": "R6", "visibleWhen": { "op": "eq", "parameter": "useIndependentRadii", "value": true } },
          { "parameter": "bendRadius7", "kind": "leader", "point": [0, "-(depth-wallThickness)/2"], "side": "left", "description": "R7", "visibleWhen": { "op": "eq", "parameter": "useIndependentRadii", "value": true } },
          { "parameter": "bendRadius8", "kind": "leader", "point": ["flangeWidth", "-(depth-wallThickness)/2+lipLength"], "side": "right", "description": "R8", "visibleWhen": { "op": "eq", "parameter": "useIndependentRadii", "value": true } }
        ]
      }
    }
  }
