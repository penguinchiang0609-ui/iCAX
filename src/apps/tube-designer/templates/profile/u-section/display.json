    "section": {
      "parameterDiagram": {
        "schemaVersion": 1,
        "annotations": [
          {
            "parameter": "width",
            "kind": "linear",
            "from": [
              "-width/2",
              "depth"
            ],
            "to": [
              "width/2",
              "depth"
            ],
            "axis": "x",
            "side": "top",
            "description": "开口自由端外宽"
          },
          {
            "parameter": "bottomWidth",
            "kind": "linear",
            "from": [
              "-bottomWidth/2",
              0
            ],
            "to": [
              "bottomWidth/2",
              0
            ],
            "axis": "x",
            "side": "bottom",
            "description": "外侧直线延长交点间距，不是底部直段长度"
          },
          {
            "parameter": "depth",
            "kind": "linear",
            "from": [
              "-width/2",
              0
            ],
            "to": [
              "-width/2",
              "depth"
            ],
            "axis": "y",
            "side": "left",
            "description": "底面至开口平面的外高"
          },
          {
            "parameter": "wallThickness",
            "kind": "linear",
            "from": [
              0,
              0
            ],
            "to": [
              0,
              "wallThickness"
            ],
            "axis": "y",
            "side": "right",
            "description": "底板法向厚度，侧壁同厚"
          },
          {
            "parameter": "bendRadius",
            "kind": "leader",
            "point": [
              "bottomWidth/2-(wallThickness+bendRadius)*(sqrt(4*depth*depth+(width-bottomWidth)*(width-bottomWidth))-(width-bottomWidth))/(2*depth)",
              "wallThickness"
            ],
            "side": "right",
            "description": "底部内弯半径 R；外半径为 R+板厚"
          }
        ]
      }
    }
