{
  "schema": "icax.tube-profile-descriptor",
  "schemaVersion": 3,
  "profileForm": "parametric",
  "recognition": { "schemaVersion": 1, "entryPoint": "fitting.py" },
  "id": "angle",
  "version": "2026.9.19.3",
  "displayName": "角钢",
  "description": "通用 L 型开放截面；勾选热轧后启用热轧角钢的自由端 r1 圆角。基础定义为长、宽、壁厚和外角 R；普通模式仍保持原有几何。",
  "category": "型材",
  "provenance": {
    "document": "doc/Apps/热轧角钢与热轧槽钢参数化建模说明.md",
    "dimensionSource": "editable-example",
    "standardConformance": "not-certified",
    "familyCode": "P14"
  },
  "manufacturing": {
    "formingProcess": "参数化 L 型截面（可选热轧角钢模型）",
    "topology": "open-profile",
    "validationLevel": "parametric-geometry"
  },
  "parameters": [
    {
      "key": "width",
      "displayName": "长 / mm",
      "valueType": "number",
      "defaultValue": 50,
      "min": 1,
      "step": 1
    },
    {
      "key": "depth",
      "displayName": "宽 / mm",
      "valueType": "number",
      "defaultValue": 80,
      "min": 1,
      "step": 1
    },
    {
      "key": "wallThickness",
      "displayName": "壁厚 / mm",
      "valueType": "number",
      "defaultValue": 6,
      "min": 0.1,
      "step": 1
    },
    {
      "key": "outerRadius",
      "displayName": "外角 R / mm",
      "valueType": "number",
      "defaultValue": 9,
      "min": 0,
      "step": 1
    },
    {
      "key": "mirrorX",
      "presentation": { "advanced": true, "line": "full", "diagramVisible": false },
      "displayName": "左右镜像",
      "valueType": "boolean",
      "defaultValue": false
    },
    {
      "key": "useHotRolled",
      "presentation": { "advanced": true, "line": "full" },
      "displayName": "热轧",
      "valueType": "boolean",
      "defaultValue": false
    },
    {
      "key": "useInnerRadius",
      "presentation": { "advanced": true, "line": "full", "diagramVisible": false },
      "displayName": "启用独立内角 R",
      "valueType": "boolean",
      "defaultValue": false
    },
    {
      "key": "innerRadius",
      "presentation": { "advanced": true },
      "displayName": "内角 R / mm",
      "valueType": "number",
      "defaultValue": 3,
      "min": 0,
      "step": 1,
      "visibleWhen": { "op": "eq", "parameter": "useInnerRadius", "value": true }
    },
    {
      "key": "freeEndRadius",
      "presentation": { "advanced": true },
      "displayName": "自由端 R / mm",
      "valueType": "number",
      "defaultValue": 0,
      "min": 0,
      "step": 1,
      "visibleWhen": { "op": "all", "conditions": [
        { "op": "eq", "parameter": "useHotRolled", "value": true },
        { "op": "eq", "parameter": "useIndependentFreeEndRadii", "value": false }
      ] }
    },
    {
      "key": "useIndependentFreeEndRadii",
      "presentation": { "advanced": true, "line": "full", "diagramVisible": false },
      "displayName": "启用自由端 R 独立设置",
      "valueType": "boolean",
      "defaultValue": false,
      "visibleWhen": { "op": "eq", "parameter": "useHotRolled", "value": true }
    },
    {
      "key": "freeEndRadius1",
      "presentation": { "advanced": true },
      "displayName": "水平边自由端 R / mm",
      "valueType": "number",
      "defaultValue": 0,
      "min": 0,
      "step": 1,
      "visibleWhen": { "op": "all", "conditions": [
        { "op": "eq", "parameter": "useHotRolled", "value": true },
        { "op": "eq", "parameter": "useIndependentFreeEndRadii", "value": true }
      ] }
    },
    {
      "key": "freeEndRadius2",
      "presentation": { "advanced": true },
      "displayName": "竖直边自由端 R / mm",
      "valueType": "number",
      "defaultValue": 0,
      "min": 0,
      "step": 1,
      "visibleWhen": { "op": "all", "conditions": [
        { "op": "eq", "parameter": "useHotRolled", "value": true },
        { "op": "eq", "parameter": "useIndependentFreeEndRadii", "value": true }
      ] }
    },
    {
      "key": "innerOffsetX",
      "presentation": { "advanced": true },
      "displayName": "截面水平偏心 / mm",
      "valueType": "number",
      "defaultValue": 0,
      "min": -10000,
      "step": 1
    },
    {
      "key": "innerOffsetY",
      "presentation": { "advanced": true },
      "displayName": "截面竖直偏心 / mm",
      "valueType": "number",
      "defaultValue": 0,
      "min": -10000,
      "step": 1
    }
  ],
  "catalog": { "categoryPath": ["型材"], "groupOrder": 2, "order": 1 }
}
