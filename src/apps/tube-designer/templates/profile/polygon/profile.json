{
  "schema": "icax.tube-profile-descriptor",
  "schemaVersion": 3,
  "profileForm": "parametric",
  "recognition": {
    "schemaVersion": 1,
    "entryPoint": "fitting.py"
  },
  "id": "polygon",
  "version": "2026.9.18.5",
  "displayName": "多边形管",
  "description": "通用多边形管：外轮廓和内轮廓均由二维 path 生成。",
  "category": "管",
  "manufacturing": {
    "formingProcess": "参数化截面拉伸",
    "topology": "closed-hollow",
    "validationLevel": "parametric-geometry"
  },
  "parameters": [
    {
      "key": "sideCount",
      "displayName": "边数",
      "valueType": "integer",
      "defaultValue": 6,
      "min": 3,
      "max": 32,
      "step": 1
    },
    {
      "key": "radius",
      "displayName": "半径（外接圆） / mm",
      "valueType": "number",
      "defaultValue": 30,
      "min": 1,
      "step": 1
    },
    {
      "key": "wallThickness",
      "displayName": "壁厚 / mm",
      "valueType": "number",
      "defaultValue": 2,
      "min": 0.1,
      "step": 0.1
    },
    {
      "key": "outerRadius",
      "displayName": "外 R / mm",
      "valueType": "number",
      "defaultValue": 3,
      "min": 0,
      "step": 0.1
    },
    {
      "key": "innerOffsetX",
      "displayName": "偏心距 X / mm",
      "valueType": "number",
      "defaultValue": 0,
      "step": 0.1,
      "presentation": { "advanced": true }
    },
    {
      "key": "innerOffsetY",
      "displayName": "偏心距 Y / mm",
      "valueType": "number",
      "defaultValue": 0,
      "step": 0.1,
      "presentation": { "advanced": true }
    },
    {
      "key": "useIndependentOuterRadii",
      "displayName": "启用外 R 独立设置",
      "valueType": "boolean",
      "defaultValue": false,
      "presentation": { "advanced": true }
    },
    {
      "key": "outerRadii",
      "displayName": "各外 R / mm",
      "valueType": "string",
      "defaultValue": "",
      "presentation": { "advanced": true },
      "visibleWhen": {
        "op": "eq",
        "parameter": "useIndependentOuterRadii",
        "value": true
      }
    },
    {
      "key": "useIndependentInnerRadii",
      "displayName": "启用内 R 独立设置",
      "valueType": "boolean",
      "defaultValue": false,
      "presentation": { "advanced": true }
    },
    {
      "key": "innerRadii",
      "displayName": "各内 R / mm",
      "valueType": "string",
      "defaultValue": "",
      "presentation": { "advanced": true },
      "visibleWhen": {
        "op": "eq",
        "parameter": "useIndependentInnerRadii",
        "value": true
      }
    }
  ],
  "catalog": {
    "groupOrder": 1,
    "order": 101,
    "categoryPath": ["管"]
  },
  "parameterDiagram": {
    "schemaVersion": 1,
    "annotations": [
      {
        "parameter": "radius",
        "kind": "linear",
        "from": [0, 0],
        "to": ["radius", 0],
        "axis": "x",
        "side": "top",
        "description": "外接圆半径"
      },
      {
        "parameter": "wallThickness",
        "kind": "linear",
        "from": [0, 0],
        "to": [0, "wallThickness"],
        "axis": "y",
        "side": "right",
        "description": "名义壁厚"
      },
      {
        "parameter": "innerOffsetX",
        "kind": "linear",
        "from": [0, 0],
        "to": ["innerOffsetX", 0],
        "axis": "x",
        "side": "bottom",
        "description": "内轮廓偏心距 X",
        "visibleWhen": {
          "op": "ne",
          "parameter": "innerOffsetX",
          "value": 0
        }
      },
      {
        "parameter": "innerOffsetY",
        "kind": "linear",
        "from": [0, 0],
        "to": [0, "innerOffsetY"],
        "axis": "y",
        "side": "left",
        "description": "内轮廓偏心距 Y",
        "visibleWhen": {
          "op": "ne",
          "parameter": "innerOffsetY",
          "value": 0
        }
      }
    ]
  }
}
