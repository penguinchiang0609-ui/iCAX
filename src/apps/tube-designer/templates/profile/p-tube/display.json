{
  "schema": "icax.template-display",
  "schemaVersion": 1,
  "views": {
    "right": {
      "groups": {
        "dimensions": {
          "title": { "zh-CN": "基本尺寸" },
          "order": 20,
          "defaultOpen": true
        }
      },
      "fields": {
        "width": { "group": "dimensions", "order": 10, "title": { "zh-CN": "管体外宽" }, "help": { "zh-CN": "管体外宽 / mm" } },
        "depth": { "group": "dimensions", "order": 20, "title": { "zh-CN": "管体外高" }, "help": { "zh-CN": "管体外高 / mm" } },
        "wallThickness": { "group": "dimensions", "order": 30, "title": { "zh-CN": "管体壁厚" }, "help": { "zh-CN": "管体壁厚 / mm" } },
        "flangeLength": { "group": "dimensions", "order": 40, "title": { "zh-CN": "安装翼伸出" }, "help": { "zh-CN": "安装翼伸出 / mm" } },
        "flangeThickness": { "group": "dimensions", "order": 50, "title": { "zh-CN": "安装翼厚" }, "help": { "zh-CN": "安装翼厚 / mm" } },
        "outerRadius": { "group": "dimensions", "order": 60, "title": { "zh-CN": "管体外 R" }, "help": { "zh-CN": "管体外 R / mm" } },
        "mirrorX": { "group": "dimensions", "order": 70, "line": "full", "title": { "zh-CN": "左右镜像" } },
        "flangeRootRadius": { "group": "dimensions", "order": 80, "title": { "zh-CN": "安装翼根部 R" }, "help": { "zh-CN": "安装翼与管体连接处根部圆角 R / mm" } },
        "innerOffsetX": { "group": "dimensions", "order": 90, "title": { "zh-CN": "内轮廓水平偏心" }, "help": { "zh-CN": "内轮廓水平偏心 / mm" } },
        "innerOffsetY": { "group": "dimensions", "order": 100, "title": { "zh-CN": "内轮廓竖直偏心" }, "help": { "zh-CN": "内轮廓竖直偏心 / mm" } },
        "useIndependentOuterRadii": { "group": "dimensions", "order": 110, "line": "full", "title": { "zh-CN": "启用独立外 R" } },
        "outerRadius1": { "group": "dimensions", "order": 120, "title": { "zh-CN": "右下外 R1" }, "help": { "zh-CN": "右下外 R1 / mm" } },
        "outerRadius2": { "group": "dimensions", "order": 130, "title": { "zh-CN": "右上外 R2" }, "help": { "zh-CN": "右上外 R2 / mm" } },
        "outerRadius3": { "group": "dimensions", "order": 140, "title": { "zh-CN": "左上外 R3" }, "help": { "zh-CN": "左上外 R3 / mm" } },
        "useIndependentInnerRadii": { "group": "dimensions", "order": 150, "line": "full", "title": { "zh-CN": "启用独立内 R" } },
        "innerRadius1": { "group": "dimensions", "order": 160, "title": { "zh-CN": "左下内 r1" }, "help": { "zh-CN": "左下内 r1 / mm" } },
        "innerRadius2": { "group": "dimensions", "order": 170, "title": { "zh-CN": "右下内 r2" }, "help": { "zh-CN": "右下内 r2 / mm" } },
        "innerRadius3": { "group": "dimensions", "order": 180, "title": { "zh-CN": "右上内 r3" }, "help": { "zh-CN": "右上内 r3 / mm" } },
        "innerRadius4": { "group": "dimensions", "order": 190, "title": { "zh-CN": "左上内 r4" }, "help": { "zh-CN": "左上内 r4 / mm" } }
      }
    },
    "scene": {
      "annotationGroups": {
        "dimensions": { "title": { "zh-CN": "基本尺寸" }, "order": 20, "defaultOpen": true }
      },
      "annotations": {
        "width": { "label": { "zh-CN": "管体外宽" }, "group": "dimensions", "order": 10, "editable": true, "suffix": " mm" },
        "depth": { "label": { "zh-CN": "管体外高" }, "group": "dimensions", "order": 20, "editable": true, "suffix": " mm" },
        "wallThickness": { "label": { "zh-CN": "管体壁厚" }, "group": "dimensions", "order": 30, "editable": true, "suffix": " mm" },
        "flangeLength": { "label": { "zh-CN": "安装翼伸出" }, "group": "dimensions", "order": 40, "editable": true, "suffix": " mm" },
        "flangeThickness": { "label": { "zh-CN": "安装翼厚" }, "group": "dimensions", "order": 50, "editable": true, "suffix": " mm" },
        "outerRadius": { "label": { "zh-CN": "管体外 R" }, "group": "dimensions", "order": 60, "editable": true, "suffix": " mm" },
        "innerOffsetX": { "label": { "zh-CN": "内轮廓水平偏心" }, "group": "dimensions", "order": 70, "editable": true, "suffix": " mm" },
        "innerOffsetY": { "label": { "zh-CN": "内轮廓竖直偏心" }, "group": "dimensions", "order": 80, "editable": true, "suffix": " mm" }
      }
    },
    "section": {
      "parameterDiagram": {
        "schemaVersion": 1,
        "annotations": [
          { "parameter": "width", "kind": "linear", "from": ["-width/2", 0], "to": ["width/2", 0], "axis": "x", "side": "top", "description": "管体外宽" },
          { "parameter": "depth", "kind": "linear", "from": ["width/2", 0], "to": ["width/2", "depth"], "axis": "y", "side": "right", "description": "管体外高" },
          { "parameter": "flangeLength", "kind": "linear", "from": ["-width/2", "-flangeLength"], "to": ["-width/2", 0], "axis": "y", "side": "left", "description": "安装翼伸出" },
          { "parameter": "flangeThickness", "kind": "linear", "from": ["-width/2", "-flangeLength"], "to": ["-width/2+flangeThickness", "-flangeLength"], "axis": "x", "side": "bottom", "description": "安装翼厚" },
          { "parameter": "wallThickness", "kind": "linear", "from": ["width/2-wallThickness", "depth/2"], "to": ["width/2", "depth/2"], "axis": "x", "side": "bottom", "description": "管体壁厚" },
          { "parameter": "outerRadius", "kind": "leader", "point": ["width/2-outerRadius*(1-0.7071067811865476)", "outerRadius*(1-0.7071067811865476)"], "side": "right", "description": "管体外 R" },
          { "parameter": "flangeRootRadius", "kind": "leader", "point": ["-width/2+flangeThickness+flangeRootRadius*(1-0.7071067811865476)", "-flangeRootRadius*(1-0.7071067811865476)"], "side": "left", "description": "安装翼根部 R", "visibleWhen": { "op": "ne", "parameter": "flangeRootRadius", "value": 0 } },
          { "parameter": "innerOffsetX", "kind": "linear", "from": [0, "depth/2"], "to": ["innerOffsetX", "depth/2"], "axis": "x", "side": "bottom", "description": "内轮廓水平偏心" },
          { "parameter": "innerOffsetY", "kind": "linear", "from": ["-width/2", "depth/2"], "to": ["-width/2", "depth/2+innerOffsetY"], "axis": "y", "side": "left", "description": "内轮廓竖直偏心" },
          { "parameter": "outerRadius1", "kind": "leader", "point": ["width/2-outerRadius1*(1-0.7071067811865476)", "outerRadius1*(1-0.7071067811865476)"], "side": "right", "description": "右下外 R1", "visibleWhen": { "op": "eq", "parameter": "useIndependentOuterRadii", "value": true } },
          { "parameter": "outerRadius2", "kind": "leader", "point": ["width/2-outerRadius2*(1-0.7071067811865476)", "depth-outerRadius2*(1-0.7071067811865476)"], "side": "right", "description": "右上外 R2", "visibleWhen": { "op": "eq", "parameter": "useIndependentOuterRadii", "value": true } },
          { "parameter": "outerRadius3", "kind": "leader", "point": ["-width/2+outerRadius3*(1-0.7071067811865476)", "depth-outerRadius3*(1-0.7071067811865476)"], "side": "top", "description": "左上外 R3", "visibleWhen": { "op": "eq", "parameter": "useIndependentOuterRadii", "value": true } },
          { "parameter": "innerRadius1", "kind": "leader", "point": ["innerOffsetX-(width-2*wallThickness)/2+innerRadius1*(1-0.7071067811865476)", "innerOffsetY+depth/2-(depth-2*wallThickness)/2+innerRadius1*(1-0.7071067811865476)"], "side": "left", "description": "左下内 r1", "visibleWhen": { "op": "eq", "parameter": "useIndependentInnerRadii", "value": true } },
          { "parameter": "innerRadius2", "kind": "leader", "point": ["innerOffsetX+(width-2*wallThickness)/2-innerRadius2*(1-0.7071067811865476)", "innerOffsetY+depth/2-(depth-2*wallThickness)/2+innerRadius2*(1-0.7071067811865476)"], "side": "bottom", "description": "右下内 r2", "visibleWhen": { "op": "eq", "parameter": "useIndependentInnerRadii", "value": true } },
          { "parameter": "innerRadius3", "kind": "leader", "point": ["innerOffsetX+(width-2*wallThickness)/2-innerRadius3*(1-0.7071067811865476)", "innerOffsetY+depth/2+(depth-2*wallThickness)/2-innerRadius3*(1-0.7071067811865476)"], "side": "right", "description": "右上内 r3", "visibleWhen": { "op": "eq", "parameter": "useIndependentInnerRadii", "value": true } },
          { "parameter": "innerRadius4", "kind": "leader", "point": ["innerOffsetX-(width-2*wallThickness)/2+innerRadius4*(1-0.7071067811865476)", "innerOffsetY+depth/2+(depth-2*wallThickness)/2-innerRadius4*(1-0.7071067811865476)"], "side": "top", "description": "左上内 r4", "visibleWhen": { "op": "eq", "parameter": "useIndependentInnerRadii", "value": true } }
        ],
        "mirrorParameter": "mirrorX"
      }
    }
  }
}
