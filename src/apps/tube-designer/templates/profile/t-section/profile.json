{
  "schema": "icax.tube-profile-descriptor",
  "schemaVersion": 3,
  "profileForm": "parametric",
  "id": "t-section",
  "version": "2026.9.13.6",
  "displayName": "T型钢",
  "description": "P23 T 型钢。同族共用入口，轮廓子模型独立求解。默认值为示例，不代表标准规格或实际来料。 热轧/精密路线仅保留明确标记的理想化回退；真实轮廓可由完整材料边界输入，不由名义尺寸冒充。",
  "category": "常用型材",
  "provenance": {
    "document": "doc/Apps/管材型材市场管型及折弯槽口调研_轮廓模型修正版_2026-09-13.md",
    "surveyIds": [
      80
    ],
    "dimensionSource": "editable-example",
    "standardConformance": "not-certified",
    "familyCode": "P23"
  },
  "manufacturing": {
    "formingProcess": "以所选族内模型及生成结果的 manufacturingRoute 为准",
    "topology": "open-profile",
    "validationLevel": "parametric-geometry"
  },
  "parameters": [
    {
      "key": "sectionModel",
      "displayName": "轮廓子模型",
      "valueType": "string",
      "defaultValue": "t-split",
      "options": [
        {
          "value": "t-split",
          "displayName": "剖分 T 型钢"
        },
        {
          "value": "t-welded",
          "displayName": "焊接 T 型钢"
        }
      ]
    },
    {
