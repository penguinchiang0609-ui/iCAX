{
  "schema": "icax.tube-profile-descriptor",
  "schemaVersion": 2,
  "id": "t-section",
  "version": "2.1.0",
  "displayName": { "zh-CN": "T 型钢", "en-US": "T section" },
  "description": "等厚翼缘和腹板组成的 T 形标准拉伸型材。",
  "parameters": [
    { "key": "width", "displayName": { "zh-CN": "翼缘宽" }, "valueType": "number", "defaultValue": 50.0, "min": 1.0, "step": 1.0 },
    { "key": "depth", "displayName": { "zh-CN": "截面高" }, "valueType": "number", "defaultValue": 50.0, "min": 1.0, "step": 1.0 },
    { "key": "wallThickness", "displayName": { "zh-CN": "厚度" }, "valueType": "number", "defaultValue": 5.0, "min": 0.1, "step": 0.1 }
  ],
  "parameterDiagram": {
    "schemaVersion": 1,
    "annotations": [
      { "parameter": "width", "kind": "linear", "axis": "x", "side": "top", "from": ["-width/2", "depth/2"], "to": ["width/2", "depth/2"], "description": "顶部翼缘左右端部之间的总宽，两侧关于腹板中心对称。" },
      { "parameter": "depth", "kind": "linear", "axis": "y", "side": "left", "from": ["-wallThickness/2", "-depth/2"], "to": ["-width/2", "depth/2"], "description": "顶部翼缘顶面到腹板底端的总高，包含顶部翼缘厚度。" },
      { "parameter": "wallThickness", "kind": "leader", "side": "right", "point": [0, 0], "description": "顶部翼缘与中间腹板的共同厚度；修改时两处厚度一起变化。" }
    ]
  }
}
