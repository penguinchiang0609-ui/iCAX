{
  "schema": "icax.template-display",
  "schemaVersion": 1,
  "views": {
    "right": {
      "groups": {
        "dimensions": {
          "title": {
            "zh-CN": "基本尺寸"
          },
          "order": 20,
          "defaultOpen": true
        }
      },
      "fields": {
        "width": {
          "group": "dimensions",
          "order": 20,
          "title": {
            "zh-CN": "外宽"
          },
          "help": {
            "zh-CN": "外宽 / mm"
          },
          "width": {
            "min": 56,
            "preferred": 72,
            "max": 84
          }
        },
        "depth": {
          "group": "dimensions",
          "order": 30,
          "title": {
            "zh-CN": "外高"
          },
          "help": {
            "zh-CN": "外高 / mm"
          },
          "width": {
            "min": 56,
            "preferred": 72,
            "max": 84
          }
        },
        "wallThickness": {
          "group": "dimensions",
          "order": 40,
          "title": {
            "zh-CN": "名义壁厚"
          },
          "help": {
            "zh-CN": "名义壁厚 / mm"
          },
          "width": {
            "min": 56,
            "preferred": 72,
            "max": 84
          }
        },
        "model0InnerWidth": {
          "group": "dimensions",
          "order": 50,
          "title": {
            "zh-CN": "内长轴"
          },
          "help": {
            "zh-CN": "内长轴（0=名义壁厚）/ mm"
          },
          "width": {
            "min": 56,
            "preferred": 72,
            "max": 84
          }
        },
        "model0InnerDepth": {
          "group": "dimensions",
          "order": 60,
          "title": {
            "zh-CN": "内短轴"
          },
          "help": {
            "zh-CN": "内短轴（0=名义壁厚）/ mm"
          },
          "width": {
            "min": 56,
            "preferred": 72,
            "max": 84
          }
        },
        "innerOffsetX": {
          "group": "dimensions",
          "order": 70,
          "title": {
            "zh-CN": "内孔水平偏心"
          },
          "help": {
            "zh-CN": "内孔水平偏心 / mm"
          }
        },
        "innerOffsetY": {
          "group": "dimensions",
          "order": 80,
          "title": {
            "zh-CN": "内孔竖直偏心"
          },
          "help": {
            "zh-CN": "内孔竖直偏心 / mm"
          }
        }
      }
    },
    "scene": {
      "annotationGroups": {
        "dimensions": {
          "title": {
            "zh-CN": "基本尺寸"
          },
          "order": 20,
          "defaultOpen": true
        }
      },
      "annotations": {
        "width": {
          "label": {
            "zh-CN": "外宽"
          },
          "group": "dimensions",
          "order": 20,
          "editable": true,
          "suffix": " mm"
        },
        "depth": {
          "label": {
            "zh-CN": "外高"
          },
          "group": "dimensions",
          "order": 30,
          "editable": true,
          "suffix": " mm"
        },
        "wallThickness": {
          "label": {
            "zh-CN": "名义壁厚"
          },
          "group": "dimensions",
          "order": 40,
          "editable": true,
          "suffix": " mm"
        }
      }
    },
    "section": {
      "parameterDiagram": {
        "schemaVersion": 1,
        "annotations": [
          {
            "parameter": "width",
            "kind": "linear",
            "from": [
              "-width/2",
              "depth/2"
            ],
            "to": [
              "width/2",
              "depth/2"
            ],
            "axis": "x",
            "side": "top",
            "description": "宽度基准"
          },
          {
            "parameter": "depth",
            "kind": "linear",
            "from": [
              "-width/2",
              "-depth/2"
            ],
            "to": [
              "-width/2",
              "depth/2"
            ],
            "axis": "y",
            "side": "left",
            "description": "高度基准"
          },
          {
            "parameter": "wallThickness",
            "kind": "linear",
            "from": [
              "width/2-wallThickness",
              0
            ],
            "to": [
              "width/2",
              0
            ],
            "axis": "x",
            "side": "bottom",
            "description": "自动内轴时的X轴端点厚度，不代表整圈等距",
            "visibleWhen": {
              "op": "all",
              "conditions": [
                {
                  "op": "eq",
                  "parameter": "model0InnerWidth",
                  "value": 0
                },
                {
                  "op": "eq",
                  "parameter": "model0InnerDepth",
                  "value": 0
                }
              ]
            }
          },
          {
            "parameter": "model0InnerWidth",
            "kind": "linear",
            "from": [
              "-model0InnerWidth/2",
              0
            ],
            "to": [
              "model0InnerWidth/2",
              0
            ],
            "axis": "x",
            "side": "bottom",
            "description": "内孔长轴",
            "visibleWhen": {
              "op": "ne",
              "parameter": "model0InnerWidth",
              "value": 0
            }
          },
          {
            "parameter": "model0InnerDepth",
            "kind": "linear",
            "from": [
              0,
              "-model0InnerDepth/2"
            ],
            "to": [
              0,
              "model0InnerDepth/2"
            ],
            "axis": "y",
            "side": "right",
            "description": "内孔短轴",
            "visibleWhen": {
              "op": "ne",
              "parameter": "model0InnerDepth",
              "value": 0
            }
          },
          {
            "parameter": "innerOffsetX",
            "kind": "linear",
            "from": [
              0,
              "-depth/2"
            ],
            "to": [
              "innerOffsetX",
              "-depth/2"
            ],
            "axis": "x",
            "side": "bottom",
            "description": "内孔水平偏心"
          },
          {
            "parameter": "innerOffsetY",
            "kind": "linear",
            "from": [
              "-width/2",
              0
            ],
            "to": [
              "-width/2",
              "innerOffsetY"
            ],
            "axis": "y",
            "side": "left",
            "description": "内孔竖直偏心"
          }
        ]
      }
    }
  }
}
