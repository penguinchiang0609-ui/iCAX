{
  "schema": "icax.tube-profile-descriptor",
  "schemaVersion": 3,
  "profileForm": "parametric",
  "id": "oval",
  "version": "2026.9.13.6",
  "displayName": "椭圆管",
  "description": "真实椭圆管，内外椭圆尺寸独立；腰型/跑道管使用独立入口。",
  "category": "常用管材",
  "provenance": {
    "document": "doc/Apps/管材型材市场管型及折弯槽口调研_轮廓模型修正版_2026-09-13.md",
    "surveyIds": [
      6,
      8
    ],
    "dimensionSource": "editable-example",
    "standardConformance": "not-certified",
    "familyCode": "P03"
  },
  "manufacturing": {
    "formingProcess": "以所选族内模型及生成结果的 manufacturingRoute 为准",
    "topology": "closed-hollow",
    "validationLevel": "parametric-geometry"
  },
  "parameters": [
    {
      "key": "sectionModel",
      "displayName": "轮廓子模型",
      "valueType": "string",
      "defaultValue": "ellipse",
      "options": [
        {
          "value": "ellipse",
          "displayName": "真椭圆管"
        }
      ]
    },
    {
      "key": "width",
      "displayName": "外宽 / mm",
      "valueType": "number",
      "defaultValue": 60,
      "min": 1,
      "step": 1
    },
    {
      "key": "depth",
      "displayName": "外高 / mm",
      "valueType": "number",
      "defaultValue": 40,
      "min": 1,
      "step": 1
    },
    {
      "key": "wallThickness",
      "displayName": "名义壁厚 / mm",
      "valueType": "number",
      "defaultValue": 2,
      "min": 0.1,
      "step": 1
    },
    {
      "key": "model0InnerWidth",
      "displayName": "内长轴（0=名义壁厚）/ mm",
      "valueType": "number",
      "defaultValue": 0,
      "min": 0,
      "step": 1,
      "visibleWhen": {
        "op": "eq",
        "parameter": "sectionModel",
        "value": "ellipse"
      }
    },
    {
      "key": "model0InnerDepth",
      "displayName": "内短轴（0=名义壁厚）/ mm",
      "valueType": "number",
      "defaultValue": 0,
      "min": 0,
      "step": 1,
      "visibleWhen": {
        "op": "eq",
        "parameter": "sectionModel",
        "value": "ellipse"
      }
    }
  ],
  "catalog": {
    "groupOrder": 1,
    "order": 4
  },
  "parameterDiagram": {
    "schemaVersion": 1,
    "annotations": [
      {
        "parameter": "width",
        "kind": "linear",
        "from": [
          "-width/2",
          "depth/2"
        ],
        "to": [
          "width/2",
          "depth/2"
        ],
        "axis": "x",
        "side": "top",
        "description": "宽度基准"
      },
      {
        "parameter": "depth",
        "kind": "linear",
        "from": [
          "-width/2",
          "-depth/2"
        ],
        "to": [
          "-width/2",
          "depth/2"
        ],
        "axis": "y",
        "side": "left",
        "description": "高度基准"
      },
      {
        "parameter": "wallThickness",
        "kind": "linear",
        "from": [
          "width/2-wallThickness",
          0
        ],
        "to": [
          "width/2",
          0
        ],
        "axis": "x",
        "side": "bottom",
        "description": "自动内轴时的X轴端点厚度，不代表整圈等距",
        "visibleWhen": {
          "op": "all",
          "conditions": [
            {
              "op": "eq",
              "parameter": "model0InnerWidth",
              "value": 0
            },
            {
              "op": "eq",
              "parameter": "model0InnerDepth",
              "value": 0
            }
          ]
        }
      }
    ]
  }
}
