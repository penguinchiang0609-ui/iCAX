{
  "schema": "icax.tube-profile-descriptor",
  "schemaVersion": 2,
  "id": "channel",
  "version": "2.1.0",
  "displayName": { "zh-CN": "C/U 型槽钢", "en-US": "Channel section" },
  "description": "等厚槽钢闭合边界形成的标准拉伸型材，截面开口朝右。",
  "parameters": [
    { "key": "width", "displayName": { "zh-CN": "外宽" }, "valueType": "number", "defaultValue": 40.0, "min": 1.0, "step": 1.0 },
    { "key": "depth", "displayName": { "zh-CN": "外高" }, "valueType": "number", "defaultValue": 60.0, "min": 1.0, "step": 1.0 },
    { "key": "wallThickness", "displayName": { "zh-CN": "厚度" }, "valueType": "number", "defaultValue": 3.0, "min": 0.1, "step": 0.1 }
  ],
  "parameterDiagram": {
    "schemaVersion": 1,
    "annotations": [
      { "parameter": "width", "kind": "linear", "axis": "x", "side": "bottom", "from": ["-width/2", "-depth/2"], "to": ["width/2", "-depth/2"], "description": "从左侧腹板外边到右侧翼缘端部的总宽；槽口朝右。" },
      { "parameter": "depth", "kind": "linear", "axis": "y", "side": "left", "from": ["-width/2", "-depth/2"], "to": ["-width/2", "depth/2"], "description": "上下翼缘最外侧之间的总高。" },
      { "parameter": "wallThickness", "kind": "leader", "side": "right", "point": ["-width/2+wallThickness/2", 0], "description": "左侧腹板和上下翼缘的共同厚度；增大时槽内开口缩小。" }
    ]
  }
}
