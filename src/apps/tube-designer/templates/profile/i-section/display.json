{
  "schema": "icax.template-display",
  "schemaVersion": 1,
  "views": {
    "right": {
      "groups": {
        "dimensions": { "title": { "zh-CN": "基本尺寸" }, "order": 20, "defaultOpen": true }
      },
      "fields": {
        "width": { "group": "dimensions", "order": 10, "title": { "zh-CN": "宽" }, "help": { "zh-CN": "翼板基准宽度 / mm" } },
        "depth": { "group": "dimensions", "order": 20, "title": { "zh-CN": "高" }, "help": { "zh-CN": "工字钢总高 / mm" } },
        "rootRadius": { "group": "dimensions", "order": 30, "title": { "zh-CN": "R" }, "help": { "zh-CN": "四个根部圆角的默认半径 / mm" } },
        "wallThickness": { "group": "dimensions", "order": 40, "title": { "zh-CN": "腹板厚度" }, "help": { "zh-CN": "腹板厚度 / mm" } },
        "flangeThickness": { "group": "dimensions", "order": 50, "title": { "zh-CN": "翼板厚度" }, "help": { "zh-CN": "翼板厚度 / mm" } },
        "useHotRolled": { "group": "dimensions", "order": 60, "line": "full", "title": { "zh-CN": "热轧" } },
        "useIndependentFlangeWidths": { "group": "dimensions", "order": 70, "line": "full", "title": { "zh-CN": "启用上下翼板独立宽度" } },
        "topFlangeWidth": { "group": "dimensions", "order": 80, "title": { "zh-CN": "上翼板宽" }, "help": { "zh-CN": "上翼板宽度 / mm" } },
        "bottomFlangeWidth": { "group": "dimensions", "order": 90, "title": { "zh-CN": "下翼板宽" }, "help": { "zh-CN": "下翼板宽度 / mm" } },
        "webOffset": { "group": "dimensions", "order": 100, "title": { "zh-CN": "腹板中心偏距" }, "help": { "zh-CN": "腹板相对截面中心的水平偏距 / mm" } },
        "useIndependentRadii": { "group": "dimensions", "order": 110, "line": "full", "title": { "zh-CN": "启用四个独立 R" } },
        "rootRadius1": { "group": "dimensions", "order": 120, "title": { "zh-CN": "右下 R1" }, "help": { "zh-CN": "右下根部圆角 / mm" } },
        "rootRadius2": { "group": "dimensions", "order": 130, "title": { "zh-CN": "右上 R2" }, "help": { "zh-CN": "右上根部圆角 / mm" } },
        "rootRadius3": { "group": "dimensions", "order": 140, "title": { "zh-CN": "左上 R3" }, "help": { "zh-CN": "左上根部圆角 / mm" } },
        "rootRadius4": { "group": "dimensions", "order": 150, "title": { "zh-CN": "左下 R4" }, "help": { "zh-CN": "左下根部圆角 / mm" } },
        "legEndRadius": { "group": "dimensions", "order": 160, "title": { "zh-CN": "腿端 R1" }, "help": { "zh-CN": "热轧工字钢翼缘端部圆角 / mm" } }
      }
    },
    "scene": {
      "annotationGroups": {
        "dimensions": { "title": { "zh-CN": "基本尺寸" }, "order": 20, "defaultOpen": true }
      },
      "annotations": {
        "width": { "label": { "zh-CN": "宽" }, "group": "dimensions", "order": 10, "editable": true, "suffix": " mm" },
        "depth": { "label": { "zh-CN": "高" }, "group": "dimensions", "order": 20, "editable": true, "suffix": " mm" },
        "rootRadius": { "label": { "zh-CN": "R" }, "group": "dimensions", "order": 30, "editable": true, "suffix": " mm" },
        "wallThickness": { "label": { "zh-CN": "腹板厚度" }, "group": "dimensions", "order": 40, "editable": true, "suffix": " mm" },
        "flangeThickness": { "label": { "zh-CN": "翼板厚度" }, "group": "dimensions", "order": 50, "editable": true, "suffix": " mm" },
        "topFlangeWidth": { "label": { "zh-CN": "上翼板宽" }, "group": "dimensions", "order": 70, "editable": true, "suffix": " mm", "visibleWhen": { "op": "eq", "parameter": "useIndependentFlangeWidths", "value": true } },
        "bottomFlangeWidth": { "label": { "zh-CN": "下翼板宽" }, "group": "dimensions", "order": 80, "editable": true, "suffix": " mm", "visibleWhen": { "op": "eq", "parameter": "useIndependentFlangeWidths", "value": true } },
        "webOffset": { "label": { "zh-CN": "腹板中心偏距" }, "group": "dimensions", "order": 90, "editable": true, "suffix": " mm" },
        "rootRadius1": { "label": { "zh-CN": "右下 R1" }, "group": "dimensions", "order": 100, "editable": true, "suffix": " mm", "visibleWhen": { "op": "eq", "parameter": "useIndependentRadii", "value": true } },
        "rootRadius2": { "label": { "zh-CN": "右上 R2" }, "group": "dimensions", "order": 110, "editable": true, "suffix": " mm", "visibleWhen": { "op": "eq", "parameter": "useIndependentRadii", "value": true } },
        "rootRadius3": { "label": { "zh-CN": "左上 R3" }, "group": "dimensions", "order": 120, "editable": true, "suffix": " mm", "visibleWhen": { "op": "eq", "parameter": "useIndependentRadii", "value": true } },
        "rootRadius4": { "label": { "zh-CN": "左下 R4" }, "group": "dimensions", "order": 130, "editable": true, "suffix": " mm", "visibleWhen": { "op": "eq", "parameter": "useIndependentRadii", "value": true } },
        "legEndRadius": { "label": { "zh-CN": "腿端 R1" }, "group": "dimensions", "order": 140, "editable": true, "suffix": " mm", "visibleWhen": { "op": "eq", "parameter": "useHotRolled", "value": true } }
      }
    },
    "section": {
      "parameterDiagram": {
        "schemaVersion": 1,
        "annotations": [
          { "parameter": "width", "kind": "linear", "from": [ "-width/2", "depth/2" ], "to": [ "width/2", "depth/2" ], "axis": "x", "side": "top", "description": "宽度基准" },
          { "parameter": "depth", "kind": "linear", "from": [ "-width/2", "-depth/2" ], "to": [ "-width/2", "depth/2" ], "axis": "y", "side": "left", "description": "高度基准" },
          { "parameter": "wallThickness", "kind": "linear", "from": [ "webOffset-wallThickness/2", 0 ], "to": [ "webOffset+wallThickness/2", 0 ], "axis": "x", "side": "bottom", "description": "腹板厚度" },
          { "parameter": "flangeThickness", "kind": "linear", "from": [ "-width/2", "depth/2-flangeThickness" ], "to": [ "-width/2", "depth/2" ], "axis": "y", "side": "left", "description": "翼板厚度" },
          { "parameter": "topFlangeWidth", "kind": "linear", "from": [ "-topFlangeWidth/2", "depth/2" ], "to": [ "topFlangeWidth/2", "depth/2" ], "axis": "x", "side": "top", "description": "上翼板宽", "visibleWhen": { "op": "eq", "parameter": "useIndependentFlangeWidths", "value": true } },
          { "parameter": "bottomFlangeWidth", "kind": "linear", "from": [ "-bottomFlangeWidth/2", "-depth/2" ], "to": [ "bottomFlangeWidth/2", "-depth/2" ], "axis": "x", "side": "bottom", "description": "下翼板宽", "visibleWhen": { "op": "eq", "parameter": "useIndependentFlangeWidths", "value": true } },
          { "parameter": "webOffset", "kind": "linear", "from": [ 0, "-depth/2" ], "to": [ "webOffset", "-depth/2" ], "axis": "x", "side": "bottom", "description": "腹板中心偏距" },
          { "parameter": "rootRadius1", "kind": "leader", "point": [ "webOffset+wallThickness/2+rootRadius1", "-depth/2+flangeThickness-rootRadius1" ], "side": "right", "description": "右下 R1", "visibleWhen": { "op": "eq", "parameter": "useIndependentRadii", "value": true } },
          { "parameter": "rootRadius2", "kind": "leader", "point": [ "webOffset+wallThickness/2+rootRadius2", "depth/2-flangeThickness+rootRadius2" ], "side": "right", "description": "右上 R2", "visibleWhen": { "op": "eq", "parameter": "useIndependentRadii", "value": true } },
          { "parameter": "rootRadius3", "kind": "leader", "point": [ "webOffset-wallThickness/2-rootRadius3", "depth/2-flangeThickness+rootRadius3" ], "side": "left", "description": "左上 R3", "visibleWhen": { "op": "eq", "parameter": "useIndependentRadii", "value": true } },
          { "parameter": "rootRadius4", "kind": "leader", "point": [ "webOffset-wallThickness/2-rootRadius4", "-depth/2+flangeThickness-rootRadius4" ], "side": "left", "description": "左下 R4", "visibleWhen": { "op": "eq", "parameter": "useIndependentRadii", "value": true } },
          { "parameter": "legEndRadius", "kind": "leader", "point": [ "width/2", "-depth/2+legEndRadius" ], "side": "right", "description": "腿端 R1", "visibleWhen": { "op": "eq", "parameter": "useHotRolled", "value": true } }
        ]
      }
    }
  }
}
