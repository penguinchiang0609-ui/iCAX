{
  "schema": "icax.tube-profile-descriptor",
  "schemaVersion": 2,
  "id": "flat-oval",
  "version": "2.1.0",
  "displayName": { "zh-CN": "腰圆管", "en-US": "Flat oval hollow section" },
  "description": "两端半圆、中间直边的腰圆外轮廓和内轮廓组成的标准拉伸管型。",
  "parameters": [
    { "key": "width", "displayName": { "zh-CN": "外宽" }, "valueType": "number", "defaultValue": 60.0, "min": 1.0, "step": 1.0 },
    { "key": "depth", "displayName": { "zh-CN": "外高" }, "valueType": "number", "defaultValue": 30.0, "min": 1.0, "step": 1.0 },
    { "key": "wallThickness", "displayName": { "zh-CN": "壁厚" }, "valueType": "number", "defaultValue": 2.0, "min": 0.1, "step": 0.1 }
  ],
  "parameterDiagram": {
    "schemaVersion": 1,
    "annotations": [
      { "parameter": "width", "kind": "linear", "axis": "x", "side": "bottom", "from": ["-width/2", 0], "to": ["width/2", 0], "description": "腰圆外轮廓水平方向的总宽；宽大于高时两端为左右半圆。" },
      { "parameter": "depth", "kind": "linear", "axis": "y", "side": "left", "from": [0, "-depth/2"], "to": [0, "depth/2"], "description": "腰圆外轮廓竖直方向的总高；高大于宽时两端为上下半圆。" },
      { "parameter": "wallThickness", "kind": "leader", "side": "right", "point": ["width/2-wallThickness/2", 0], "description": "外轮廓与内轮廓之间的壁厚，同时影响直边和两端圆弧。" }
    ]
  }
}
