{
  "schema": "icax.tube-profile-descriptor",
  "schemaVersion": 2,
  "id": "ellipse",
  "version": "2.1.0",
  "displayName": { "zh-CN": "椭圆管", "en-US": "Elliptical hollow section" },
  "description": "椭圆外轮廓和等壁厚近似内轮廓组成的标准拉伸管型。",
  "parameters": [
    { "key": "width", "displayName": { "zh-CN": "外宽" }, "valueType": "number", "defaultValue": 60.0, "min": 1.0, "step": 1.0 },
    { "key": "depth", "displayName": { "zh-CN": "外高" }, "valueType": "number", "defaultValue": 30.0, "min": 1.0, "step": 1.0 },
    { "key": "wallThickness", "displayName": { "zh-CN": "壁厚" }, "valueType": "number", "defaultValue": 2.0, "min": 0.1, "step": 0.1 }
  ],
  "parameterDiagram": {
    "schemaVersion": 1,
    "annotations": [
      { "parameter": "width", "kind": "linear", "axis": "x", "side": "bottom", "from": ["-width/2", 0], "to": ["width/2", 0], "description": "椭圆外轮廓水平方向的总宽。" },
      { "parameter": "depth", "kind": "linear", "axis": "y", "side": "left", "from": [0, "-depth/2"], "to": [0, "depth/2"], "description": "椭圆外轮廓竖直方向的总高。" },
      { "parameter": "wallThickness", "kind": "leader", "side": "right", "point": ["width/2-wallThickness/2", 0], "description": "长短轴端部的名义壁厚；内椭圆的宽和高各减去两倍壁厚，并非处处等法向距离。" }
    ]
  }
}
