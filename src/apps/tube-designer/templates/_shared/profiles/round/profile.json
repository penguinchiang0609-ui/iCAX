{
  "schema": "icax.tube-profile-descriptor",
  "schemaVersion": 2,
  "id": "round",
  "version": "2.1.0",
  "displayName": { "zh-CN": "圆管", "en-US": "Circular hollow section" },
  "description": "同心圆外轮廓和内轮廓组成的标准拉伸管型。",
  "parameters": [
    { "key": "width", "displayName": { "zh-CN": "外径" }, "valueType": "number", "defaultValue": 40.0, "min": 1.0, "step": 1.0 },
    { "key": "wallThickness", "displayName": { "zh-CN": "壁厚" }, "valueType": "number", "defaultValue": 2.0, "min": 0.1, "step": 0.1 }
  ],
  "parameterDiagram": {
    "schemaVersion": 1,
    "annotations": [
      { "parameter": "width", "kind": "linear", "axis": "x", "side": "bottom", "from": ["-width/2", 0], "to": ["width/2", 0], "description": "外圆直径，不是半径；内径等于外径减去两倍壁厚。" },
      { "parameter": "wallThickness", "kind": "leader", "side": "right", "point": ["width/2-wallThickness/2", 0], "description": "内外同心圆之间的径向厚度；外径不变时增大壁厚会缩小内孔。" }
    ]
  }
}
