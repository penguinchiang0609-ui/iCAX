{
  "schema": "icax.tube-profile-descriptor",
  "schemaVersion": 2,
  "id": "rect",
  "version": "2.1.0",
  "displayName": { "zh-CN": "矩形管", "en-US": "Rectangular hollow section" },
  "description": "圆角矩形外轮廓和内轮廓组成的标准拉伸管型。",
  "parameters": [
    { "key": "width", "displayName": { "zh-CN": "外宽" }, "valueType": "number", "defaultValue": 40.0, "min": 1.0, "step": 1.0 },
    { "key": "depth", "displayName": { "zh-CN": "外高" }, "valueType": "number", "defaultValue": 20.0, "min": 1.0, "step": 1.0 },
    { "key": "wallThickness", "displayName": { "zh-CN": "壁厚" }, "valueType": "number", "defaultValue": 2.0, "min": 0.1, "step": 0.1 },
    { "key": "cornerRadius", "displayName": { "zh-CN": "外圆角" }, "valueType": "number", "defaultValue": 2.0, "min": 0.0, "step": 0.5 }
  ],
  "parameterDiagram": {
    "schemaVersion": 1,
    "annotations": [
      { "parameter": "width", "kind": "linear", "axis": "x", "side": "bottom", "from": ["-width/2", 0], "to": ["width/2", 0], "description": "矩形管左右外侧之间的总宽，包含两侧壁厚。" },
      { "parameter": "depth", "kind": "linear", "axis": "y", "side": "left", "from": [0, "-depth/2"], "to": [0, "depth/2"], "description": "矩形管上下外侧之间的总高，包含上下壁厚。" },
      { "parameter": "wallThickness", "kind": "leader", "side": "right", "point": [0, "-depth/2+wallThickness/2"], "description": "四条直边的共同壁厚；内轮廓宽高各减去两倍壁厚。" },
      { "parameter": "cornerRadius", "kind": "leader", "side": "top", "point": ["width/2-cornerRadius+cornerRadius/sqrt(2)", "depth/2-cornerRadius+cornerRadius/sqrt(2)"], "description": "四个外侧圆角的半径 R；内圆角半径为外圆角减去壁厚，最小为 0。" }
    ]
  }
}
