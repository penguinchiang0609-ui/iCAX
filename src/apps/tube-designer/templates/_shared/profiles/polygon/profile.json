{
  "schema": "icax.tube-profile-descriptor",
  "schemaVersion": 2,
  "id": "polygon",
  "version": "1.0.0",
  "displayName": { "zh-CN": "多边形管", "en-US": "Polygonal hollow section" },
  "description": "由参数生成正多边形或星形外轮廓，并按名义壁厚向内偏置形成内轮廓。",
  "parameters": [
    {
      "key": "shapeMode",
      "displayName": { "zh-CN": "轮廓类型" },
      "valueType": "string",
      "defaultValue": "regular",
      "options": [
        { "value": "regular", "displayName": { "zh-CN": "正多边形" } },
        { "value": "star", "displayName": { "zh-CN": "星形" } }
      ]
    },
    { "key": "sideCount", "displayName": { "zh-CN": "边数 / 星角数" }, "valueType": "integer", "defaultValue": 8, "min": 3, "max": 64, "step": 1 },
    { "key": "starInnerRatio", "displayName": { "zh-CN": "星谷半径比" }, "valueType": "number", "defaultValue": 0.5, "min": 0.15, "max": 0.9, "step": 0.05, "visibleWhen": { "op": "eq", "parameter": "shapeMode", "value": "star" } },
    { "key": "width", "displayName": { "zh-CN": "外宽" }, "valueType": "number", "defaultValue": 40.0, "min": 1.0, "step": 1.0 },
    { "key": "depth", "displayName": { "zh-CN": "外高" }, "valueType": "number", "defaultValue": 40.0, "min": 1.0, "step": 1.0 },
    { "key": "wallThickness", "displayName": { "zh-CN": "壁厚" }, "valueType": "number", "defaultValue": 2.0, "min": 0.1, "step": 0.1 }
  ],
  "parameterDiagram": {
    "schemaVersion": 1,
    "annotations": [
      { "parameter": "shapeMode", "kind": "leader", "side": "left", "point": ["contourX(0,0)", "contourY(0,0)"], "description": "切换正多边形或凹谷交替的星形；两者都保持指定的外宽和外高。" },
      { "parameter": "sideCount", "kind": "leader", "side": "top", "point": ["contourX(0,2)", "contourY(0,2)"], "description": "正多边形时为边数，星形时为外侧星角数量；星形实际顶点数为此数的两倍。" },
      { "parameter": "starInnerRatio", "kind": "leader", "side": "right", "point": ["contourX(0,1)", "contourY(0,1)"], "description": "星形缩放前星谷半径与星尖半径之比；值越小凹谷越深，最终轮廓仍按外宽和外高缩放。" },
      { "parameter": "width", "kind": "linear", "axis": "x", "side": "bottom", "from": ["-width/2", 0], "to": ["width/2", 0], "description": "生成并居中的外轮廓在水平方向的最大总宽，不是外接圆直径或单边长度。" },
      { "parameter": "depth", "kind": "linear", "axis": "y", "side": "left", "from": [0, "-depth/2"], "to": [0, "depth/2"], "description": "生成并居中的外轮廓在竖直方向的最大总高；宽高可独立设置。" },
      { "parameter": "wallThickness", "kind": "leader", "side": "right", "point": ["(contourX(0,0)+contourX(0,1)+contourX(1,0)+contourX(1,1))/4", "(contourY(0,0)+contourY(0,1)+contourY(1,0)+contourY(1,1))/4"], "description": "每条外轮廓边向内法向偏置的距离；过厚或星谷过深时可能无法形成有效内轮廓。" }
    ]
  }
}
