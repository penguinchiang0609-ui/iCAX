{
  "schema": "icax.tube-profile-descriptor",
  "schemaVersion": 2,
  "id": "i-section",
  "version": "2.1.0",
  "displayName": { "zh-CN": "工字钢 / H 型钢", "en-US": "I/H section" },
  "description": "等厚上下翼缘和腹板组成的工字形标准拉伸型材。",
  "parameters": [
    { "key": "width", "displayName": { "zh-CN": "翼缘宽" }, "valueType": "number", "defaultValue": 100.0, "min": 1.0, "step": 1.0 },
    { "key": "depth", "displayName": { "zh-CN": "截面高" }, "valueType": "number", "defaultValue": 100.0, "min": 1.0, "step": 1.0 },
    { "key": "wallThickness", "displayName": { "zh-CN": "厚度" }, "valueType": "number", "defaultValue": 6.0, "min": 0.1, "step": 0.1 }
  ],
  "parameterDiagram": {
    "schemaVersion": 1,
    "annotations": [
      { "parameter": "width", "kind": "linear", "axis": "x", "side": "bottom", "from": ["-width/2", "-depth/2"], "to": ["width/2", "-depth/2"], "description": "上下两块翼缘的总宽，两侧关于腹板中心对称。" },
      { "parameter": "depth", "kind": "linear", "axis": "y", "side": "left", "from": ["-width/2", "-depth/2"], "to": ["-width/2", "depth/2"], "description": "上翼缘顶面到底翼缘底面的总高，包含两块翼缘的厚度。" },
      { "parameter": "wallThickness", "kind": "leader", "side": "right", "point": [0, 0], "description": "中间腹板和上下翼缘的共同厚度；修改此值会同时改变三处厚度。" }
    ]
  }
}
