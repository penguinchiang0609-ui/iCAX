{
  "schema":"icax.punch-tool","schemaVersion":1,"id":"edge-arc-groove","version":"1.0.1",
  "displayName":"边弧槽","kind":"programmatic","target":"part","category":"槽口",
  "description":"以 V 槽为基线，把一侧直边替换为连续圆弧；左圆弧由参数选择，定位和阵列由外部调用者处理。",
  "illustration":{"viewBox":"0 0 48 48","paths":["M8 10 L40 10 L28 33 Q24 39 20 34 L8 10"]},
  "parameters":[
    {"key":"angle","displayName":"V 槽夹角（°）","valueType":"number","defaultValue":90,"min":1,"max":170},
    {"key":"leftArc","displayName":"左圆弧","valueType":"boolean","defaultValue":true},
    {"key":"bridge","displayName":"底部保留厚度（mm）","valueType":"number","defaultValue":1,"min":0.01,"max":10000},
    {"key":"reliefDiameter","displayName":"附加释放孔直径（0 不添加，mm）","valueType":"number","defaultValue":0,"min":0,"max":10000},
    {"key":"reliefLift","displayName":"附加释放孔中心上移（mm）","valueType":"number","defaultValue":0,"min":0,"max":10000},
    {"key":"bottomCut","displayName":"底部切除","valueType":"boolean","defaultValue":false},
    {"key":"bottomCutWidth","displayName":"底部切除宽度（mm）","valueType":"number","defaultValue":2,"min":0.01,"max":10000}
  ]
}
