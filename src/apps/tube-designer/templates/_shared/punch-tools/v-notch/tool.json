{
  "schema":"icax.punch-tool","schemaVersion":1,"id":"v-notch","version":"1.1.0",
  "displayName":"V 槽","kind":"programmatic","target":"part","category":"槽口",
  "description":"七种参数化槽口；圆弧按真实圆弧构造。左、右侧圆弧表示单侧槽底过渡，不包含折弯展开补偿。",
  "parameters":[
    {"key":"style","displayName":"V 槽类型","valueType":"string","defaultValue":"sharp_v","options":[
      {"value":"sharp_v","label":"尖角 V 槽"},{"value":"asymmetric_v","label":"非对称 V 槽"},
      {"value":"rounded_v","label":"圆角 V 槽"},{"value":"left_arc","label":"左侧圆弧 V 槽"},
      {"value":"right_arc","label":"右侧圆弧 V 槽"},{"value":"flat_v","label":"平底 V 槽"},
      {"value":"relief_v","label":"释放孔 V 槽"}]},
    {"key":"angle","displayName":"V 槽夹角（°）","valueType":"number","defaultValue":90,"min":1,"max":170,"visibleWhen":{"op":"any","conditions":[{"op":"eq","parameter":"style","value":"sharp_v"},{"op":"eq","parameter":"style","value":"rounded_v"},{"op":"eq","parameter":"style","value":"left_arc"},{"op":"eq","parameter":"style","value":"right_arc"},{"op":"eq","parameter":"style","value":"flat_v"},{"op":"eq","parameter":"style","value":"relief_v"}]}},
    {"key":"leftAngle","displayName":"左半角（相对槽深方向，°）","valueType":"number","defaultValue":30,"min":0.5,"max":85,"visibleWhen":{"op":"eq","parameter":"style","value":"asymmetric_v"}},
    {"key":"rightAngle","displayName":"右半角（相对槽深方向，°）","valueType":"number","defaultValue":60,"min":0.5,"max":85,"visibleWhen":{"op":"eq","parameter":"style","value":"asymmetric_v"}},
    {"key":"rotation","displayName":"绕主管旋转（°）","valueType":"number","defaultValue":0,"min":-3600,"max":3600},
    {"key":"bridge","displayName":"底部保留厚度（mm）","valueType":"number","defaultValue":1,"min":0.01,"max":10000},
    {"key":"curveRadius","displayName":"圆弧半径 R（mm）","valueType":"number","defaultValue":2,"min":0.01,"max":10000,"visibleWhen":{"op":"any","conditions":[{"op":"eq","parameter":"style","value":"rounded_v"},{"op":"eq","parameter":"style","value":"left_arc"},{"op":"eq","parameter":"style","value":"right_arc"}]}},
    {"key":"flatWidth","displayName":"槽底平口宽（mm）","valueType":"number","defaultValue":2,"min":0.01,"max":10000,"visibleWhen":{"op":"eq","parameter":"style","value":"flat_v"}},
    {"key":"holeDiameter","displayName":"释放孔直径（mm）","valueType":"number","defaultValue":4,"min":0.01,"max":10000,"visibleWhen":{"op":"eq","parameter":"style","value":"relief_v"}},
    {"key":"holeLift","displayName":"释放孔中心上移（mm）","valueType":"number","defaultValue":2,"min":0,"max":10000,"visibleWhen":{"op":"eq","parameter":"style","value":"relief_v"}},
    {"key":"rootRadius","displayName":"附加槽底圆角 R（0 不添加，mm）","valueType":"number","defaultValue":0,"min":0,"max":10000,"visibleWhen":{"op":"any","conditions":[{"op":"eq","parameter":"style","value":"sharp_v"},{"op":"eq","parameter":"style","value":"asymmetric_v"}]}},
    {"key":"rootWidth","displayName":"附加槽底平口（0 不添加，mm）","valueType":"number","defaultValue":0,"min":0,"max":10000,"visibleWhen":{"op":"any","conditions":[{"op":"eq","parameter":"style","value":"sharp_v"},{"op":"eq","parameter":"style","value":"asymmetric_v"}]}},
    {"key":"reliefDiameter","displayName":"附加释放孔直径（0 不添加，mm）","valueType":"number","defaultValue":0,"min":0,"max":10000,"visibleWhen":{"op":"any","conditions":[{"op":"eq","parameter":"style","value":"sharp_v"},{"op":"eq","parameter":"style","value":"asymmetric_v"},{"op":"eq","parameter":"style","value":"rounded_v"},{"op":"eq","parameter":"style","value":"left_arc"},{"op":"eq","parameter":"style","value":"right_arc"},{"op":"eq","parameter":"style","value":"flat_v"}]}},
    {"key":"reliefLift","displayName":"附加释放孔中心上移（mm）","valueType":"number","defaultValue":0,"min":0,"max":10000,"visibleWhen":{"op":"any","conditions":[{"op":"eq","parameter":"style","value":"sharp_v"},{"op":"eq","parameter":"style","value":"asymmetric_v"},{"op":"eq","parameter":"style","value":"rounded_v"},{"op":"eq","parameter":"style","value":"left_arc"},{"op":"eq","parameter":"style","value":"right_arc"},{"op":"eq","parameter":"style","value":"flat_v"}]}},
    {"key":"bottomCut","displayName":"底部切除","valueType":"boolean","defaultValue":false},
    {"key":"bottomCutWidth","displayName":"底部切除宽度（mm）","valueType":"number","defaultValue":2,"min":0.01,"max":10000,"visibleWhen":{"op":"eq","parameter":"bottomCut","value":true}}
  ]
}
