    "viewBox": "0 0 64 64",
    "paths": [
      {
        "d": "M4 26 H60 V38 H4 Z",
        "tone": "a"
      },
      {
        "d": "M26 4 H38 V60 H26 Z",
        "tone": "b"
      },
      {
        "d": "M26 26 H38 V38 H26 Z",
        "tone": "joint"
      }
    ]
  },
  "participants": [
    {
      "role": "host",
