          "length": {
            "role": "through",
            "field": "length"
          },
          "azimuth": {
            "role": "host",
            "field": "anchor.face",
            "map": {
              "top": 0,
              "bottom": 180,
              "left": -90,
              "right": 90
            }
          }
        }
      }
    }
  },
  "parameters": [
    {
      "key": "fitGap",
      "displayName": "开口单边配合间隙",
      "valueType": "number",
      "defaultValue": 0.2,
      "min": 0,
      "max": 10,
      "step": 0.1,
      "unit": "mm",
      "level": "basic"
    }
  ],
  "partProcesses": [
    {
      "id": "through-opening",
      "participants": [
        "host"
      ],
      "label": "主管贯穿轮廓口",
      "resource": {
        "kind": "part-process",
        "id": "branch-profile",
        "displayName": "支管相贯"
      },
      "parameterBindings": {
        "angle": 90,
        "azimuth": 0,
        "roll": 0,
        "direction": "through",
        "length": 440,
        "clearance": "$fitGap",
        "offsetY": 0,
        "offsetZ": 0
      },
      "previewPlacement": {
        "target": "part",
        "reference": "center",
        "station": 0,
        "face": "top",
        "sectionRole": "through"
      }
    }
  ],
  "manufacturingPlan": {
    "realization": "separate",
    "blankPartPolicy": "keep-separate",
