{
  "catalogueDiagram": {
    "viewBox": "0 0 64 64",
    "paths": [
      {
        "d": "M4 21 H39 V43 H4 Z",
        "tone": "a"
      },
      {
        "d": "M30 25 H60 V39 H30 Z",
        "tone": "b"
      },
      {
        "d": "M30 21 V25 M39 39 V43",
        "tone": "joint"
      }
    ]
  },
  "schema": "icax.assembly-template",
  "schemaVersion": 1,
  "id": "insert-sleeve",
  "version": "2.1.2",
  "displayName": "同轴套接 / 伸缩",
  "category": "two-end-end",
  "layoutShape": "straight",
  "categoryName": "两件 · 端—端",
  "summary": "两个端部同轴套接；管型和截面由成品构件分别确定，工艺参数校核配合间隙，可固定搭接或保留伸缩行程。",
  "topology": "端部—端部",
  "interfaceType": "同轴套接",
  "lockType": "仅配合或焊接锁止",
  "motionType": "直线插入 / 轴向滑动",
  "participants": [
    {
      "role": "insertPart",
      "label": "插入件",
      "responsibility": "主动插入或内套件",
      "count": 1
    },
    {
      "role": "receivePart",
      "label": "承接件",
      "responsibility": "开口件或外套件",
      "count": 1
    }
  ],
  "productBinding": {
    "mode": "unsupported",
    "reason": "套接与伸缩需要校验真实管型配合并改变构件位置，当前不支持增量加工绑定"
  },
  "parameters": [
    {
      "key": "connectionMode",
      "displayName": "连接方式",
      "valueType": "choice",
      "defaultValue": "sleeve",
      "options": [
        {
          "value": "sleeve",
          "label": "同轴套接"
        },
        {
          "value": "telescopic",
          "label": "伸缩连接"
        }
      ],
      "level": "basic"
    },
    {
      "key": "insertDepth",
      "displayName": "插入深度",
      "valueType": "number",
      "defaultValue": 120,
      "min": 1,
      "max": 500,
      "step": 1,
      "unit": "mm",
      "level": "basic"
    },
    {
      "key": "fitClearance",
      "displayName": "单侧配合间隙",
      "valueType": "number",
      "defaultValue": 0.3,
      "min": 0,
      "max": 10,
      "step": 0.1,
      "unit": "mm",
      "level": "basic"
    },
    {
      "key": "travelLength",
      "displayName": "有效伸缩行程",
      "valueType": "number",
      "defaultValue": 80,
      "min": 1,
      "max": 1000,
      "step": 1,
      "unit": "mm",
      "level": "basic",
      "visibleWhen": {
        "op": "eq",
        "parameter": "connectionMode",
        "value": "telescopic"
      }
    },
    {
      "key": "lockMethod",
      "displayName": "锁止方式",
      "valueType": "choice",
      "defaultValue": "none",
      "options": [
        {
          "value": "none",
          "label": "仅配合"
        },
        {
          "value": "weld",
          "label": "焊接"
        }
      ],
      "level": "advanced"
    }
  ],
  "partProcesses": [],
  "manufacturingPlan": {
    "realization": "separate",
    "blankPartPolicy": "keep-separate",
    "blankParts": [
      {
        "id": "insertBlank",
        "label": "插入件下料",
        "participants": [
          "insertPart"
        ]
      },
      {
        "id": "receiveBlank",
        "label": "承接件下料",
        "participants": [
          "receivePart"
        ]
      }
    ]
  },
  "assemblyPath": [
    {
      "id": "align",
      "label": "对正插入件与承接件轴线",
      "kind": "对正",
      "direction": "assembly.x",
      "distance": 0
    },
    {
      "id": "insert",
      "label": "沿轴线插入承接件",
      "kind": "$connectionMode",
      "direction": "assembly.x",
      "distance": "$insertDepth"
    },
    {
      "id": "travel",
      "label": "保留向外伸缩行程与最小啮合深度",
      "kind": "伸缩",
      "direction": "assembly.x",
      "distance": "$travelLength",
      "when": {
        "op": "eq",
        "parameter": "connectionMode",
        "value": "telescopic"
      }
    },
    {
      "id": "lock",
      "label": "仅保留套接配合",
      "labelVariants": [
        {
          "when": {
            "op": "eq",
            "parameter": "lockMethod",
            "value": "weld"
          },
          "value": "施焊锁止套接位置"
        }
      ],
      "kind": "$lockMethod",
      "direction": "assembly.x",
      "distance": 0
    }
  ],
  "bomRules": [],
  "dimensionChecks": [
    {
      "id": "section-fit",
      "kind": "coaxial-section-fit",
      "innerRole": "insertPart",
      "outerRole": "receivePart",
      "expectedClearance": "$fitClearance",
      "tolerance": 1e-06
    },
    {
      "id": "insert-depth-inner-limit",
      "kind": "minimum",
      "label": "插入件的外露长度",
      "value": "$insertPart_length",
      "minimum": 0,
      "unit": "mm"
    },
    {
      "id": "insert-depth-outer-limit",
      "kind": "minimum",
      "label": "承接件的剩余长度",
      "value": "$receivePart_length - $insertDepth",
      "minimum": 0,
      "unit": "mm"
    },
    {
      "id": "residual-engagement",
      "kind": "minimum",
      "label": "最大伸出后的剩余啮合深度",
      "value": "$insertDepth - $travelLength",
      "minimum": 20,
      "unit": "mm",
      "when": {
        "op": "eq",
        "parameter": "connectionMode",
        "value": "telescopic"
      }
    }
  ],
  "previewScene": {
    "manufacturingParts": [
      {
        "id": "insertBlank",
        "label": "插入件下料",
        "sourceRole": "insertPart",
        "stockLengthAddition": "$insertDepth",
        "processes": [],
        "explodedPose": {
          "origin": [
            "$receivePart_length / 2 - $insertDepth",
            0,
            0
          ],
          "direction": [
            1,
            0,
            0
          ],
          "up": [
            0,
            1,
            0
          ],
          "axialTranslation": "$insertDepth + 100"
        }
      },
      {
        "id": "receiveBlank",
        "label": "承接件下料",
        "sourceRole": "receivePart",
        "processes": [],
        "explodedPose": {
          "origin": [
            "-$receivePart_length / 2",
            0,
            0
          ],
          "direction": [
            1,
            0,
            0
          ],
          "up": [
            0,
            1,
            0
          ]
        }
      }
    ],
    "compareLayout": {
      "designOffset": [
        0,
        0,
        120
      ],
      "manufacturingOffset": [
        0,
        0,
        -120
      ]
    }
  },
  "parameterDiagram": {
    "schemaVersion": 2,
    "viewBox": "0 0 64 64",
    "paths": [
