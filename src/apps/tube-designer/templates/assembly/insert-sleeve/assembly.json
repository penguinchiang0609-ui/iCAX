        ],
        "description": "承接件内轮廓与插入件外轮廓之间的单侧配合间隙"
      }
    ]
  },
  "outputs": {
    "manufacturingPartCount": 2,
    "partGeometry": [
      "内套插入件",
      "外套承接件"
    ],
    "secondaryProcess": [
      "同轴套接或轴向伸缩",
      "按选项锁止"
    ],
    "bom": [],
    "assemblyInstruction": true
  },
  "inputContract": {
