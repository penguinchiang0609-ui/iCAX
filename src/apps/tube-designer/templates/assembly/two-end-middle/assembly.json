{
  "catalogueDiagram": {
    "viewBox": "0 0 64 64",
    "paths": [
      {
        "d": "M4 45 H60 V57 H4 Z",
        "tone": "a"
      },
      {
        "d": "M26 6 H38 V45 H26 Z",
        "tone": "b"
      },
      {
        "d": "M26 45 H38",
        "tone": "joint"
      }
    ]
  },
  "schema": "icax.assembly-template",
  "schemaVersion": 1,
  "id": "two-end-middle",
  "catalogueHidden": true,
  "version": "1.1.5",
  "displayName": "插入 / 贯穿 / 相贯",
  "category": "two-end-middle",
  "layoutShape": "t",
  "categoryName": "两件 · 端—中",
  "summary": "一个零件的端部连接到另一个零件中段；可开单面轮廓口、贯穿轮廓口或加工支管相贯端。",
  "topology": "端部—中段",
  "interfaceType": "插入 / 贯穿 / 相贯贴合",
  "lockType": "焊接或结构固定",
  "motionType": "沿支管轴线装入",
  "participants": [
    {
      "role": "host",
      "label": "主管 / 母件",
      "responsibility": "提供中段连接位置",
      "count": 1
    },
    {
      "role": "branch",
      "label": "支管 / 插入件",
      "responsibility": "以端部接入",
      "count": 1
    }
  ],
  "productBinding": {
    "mode": "incremental-cut",
    "compatibleProductTopologies": [
      {
        "topology": "T"
      }
    ],
    "anchors": {
      "host": "side",
      "branch": "end"
    },
    "axisAngle": {
      "roles": [
        "host",
        "branch"
      ],
      "directions": [
        "startToEnd",
        "awayFromAnchor"
      ],
      "measure": "direct",
      "expected": {
        "parameter": "intersectionAngle"
      }
    },
    "fitChecks": [
      {
        "id": "single-insert",
        "kind": "end-side-single-insert",
        "topology": "T",
        "when": {
          "op": "eq",
          "parameter": "interfaceMode",
          "value": "singleInsert"
        },
        "roles": {
          "host": "host",
          "branch": "branch"
        },
        "hostFaceSource": "anchor.face",
        "processIds": [
          "single-opening",
          "single-branch-end"
        ],
        "gap": {
          "parameter": "fitGap"
        }
      },
      {
        "id": "through-insert",
        "kind": "end-side-through-insert",
        "topology": "T",
        "when": {
          "op": "eq",
          "parameter": "interfaceMode",
          "value": "throughInsert"
        },
        "roles": {
          "host": "host",
          "branch": "branch"
        },
        "hostFaceSource": "anchor.face",
        "processIds": [
          "through-opening"
        ],
        "gap": {
          "millimeters": 0
        }
      },
      {
        "id": "saddle",
        "kind": "end-side-saddle",
        "topology": "T",
        "when": {
          "op": "eq",
          "parameter": "interfaceMode",
          "value": "saddle"
        },
        "roles": {
          "host": "host",
          "branch": "branch"
        },
        "hostFaceSource": "anchor.face",
        "processIds": [
          "saddle-end"
        ],
        "gap": {
          "millimeters": 0
        }
      }
    ],
    "processes": {
      "single-opening": {
        "target": "part",
        "sectionRole": "branch",
        "parameterSources": {
          "length": {
            "role": "branch",
            "field": "length"
          },
          "azimuth": {
            "role": "host",
            "endRole": "branch",
            "field": "anchor.faceByProductEnd",
            "map": {
              "end": {
                "top": 180,
                "bottom": 0,
                "left": 90,
                "right": -90
              },
              "start": {
                "top": 0,
                "bottom": 180,
                "left": -90,
                "right": 90
              }
            }
          },
          "direction": {
            "role": "branch",
            "field": "productAnchor.end",
            "map": {
              "start": "positive",
              "end": "negative"
            },
            "matchHostFaceNormal": true
          }
        }
      },
      "single-branch-end": {
        "target": "end",
        "parameterSources": {
          "trim": {
            "role": "branch",
            "field": "anchor.stockAllowance",
            "min": 0.01
          }
        }
      },
      "through-opening": {
        "target": "part",
        "sectionRole": "branch",
        "parameterSources": {
          "length": {
            "role": "branch",
            "field": "length"
          },
          "azimuth": {
            "role": "host",
            "endRole": "branch",
            "field": "anchor.faceByProductEnd",
            "map": {
              "end": {
                "top": 180,
                "bottom": 0,
                "left": 90,
                "right": -90
              },
              "start": {
                "top": 0,
                "bottom": 180,
                "left": -90,
                "right": 90
              }
            }
          }
        }
      },
      "saddle-end": {
        "target": "end",
        "sectionRole": "host",
        "parameterSources": {
          "trim": {
            "role": "branch",
            "field": "anchor.stockAllowance",
            "min": 0.01
          }
        }
      }
    }
  },
  "parameters": [
    {
      "key": "interfaceMode",
      "displayName": "端—中方式",
      "valueType": "choice",
      "defaultValue": "saddle",
      "options": [
        {
          "value": "singleInsert",
          "label": "单面插入"
        },
        {
          "value": "throughInsert",
          "label": "贯穿插入"
        },
        {
          "value": "saddle",
          "label": "相贯贴合"
        }
      ],
      "level": "basic"
    },
    {
      "key": "fitGap",
      "displayName": "开口单边配合间隙",
      "valueType": "number",
      "defaultValue": 0.2,
      "min": 0,
      "max": 10,
      "step": 0.1,
      "unit": "mm",
      "level": "basic",
      "visibleWhen": {
        "op": "eq",
        "parameter": "interfaceMode",
        "value": "singleInsert"
      }
    },
    {
      "key": "insertDepth",
      "displayName": "插入量",
      "valueType": "number",
      "defaultValue": 12,
      "min": 0.1,
      "max": 100,
      "step": 0.1,
      "unit": "mm",
      "level": "basic",
      "visibleWhen": {
        "op": "eq",
        "parameter": "interfaceMode",
        "value": "singleInsert"
      }
    }
  ],
  "partProcesses": [
    {
      "id": "single-opening",
      "participants": [
        "host"
      ],
      "label": "单面轮廓插入口",
      "appliesWhen": {
        "op": "eq",
        "parameter": "interfaceMode",
        "value": "singleInsert"
      },
      "resource": {
        "kind": "part-process",
        "id": "branch-profile",
        "displayName": "支管相贯"
      },
      "parameterBindings": {
        "angle": "$intersectionAngle",
        "azimuth": 0,
        "roll": 0,
        "direction": "negative",
        "length": 120,
        "clearance": "$fitGap",
        "offsetY": 0,
        "offsetZ": 0
      },
      "previewPlacement": {
        "target": "part",
        "reference": "center",
        "station": 0,
        "face": "top",
        "sectionRole": "branch"
      }
    },
    {
      "id": "single-branch-end",
      "participants": [
        "branch"
      ],
      "label": "支管端部平切至接头",
      "appliesWhen": {
        "op": "eq",
        "parameter": "interfaceMode",
        "value": "singleInsert"
      },
      "resource": {
        "kind": "part-process",
        "id": "end-miter",
        "displayName": "端面切割"
      },
      "parameterBindings": {
        "angle": 0,
        "trim": 0,
        "rotation": 0,
        "datum": "long"
      },
      "previewPlacement": {
        "target": "end",
        "end": "end",
        "datum": "long"
      }
    },
    {
      "id": "through-opening",
      "participants": [
        "host"
      ],
      "label": "贯穿轮廓插入口",
      "appliesWhen": {
        "op": "eq",
        "parameter": "interfaceMode",
        "value": "throughInsert"
      },
      "resource": {
        "kind": "part-process",
        "id": "branch-profile",
        "displayName": "支管相贯"
      },
      "parameterBindings": {
        "angle": "$intersectionAngle",
        "azimuth": 0,
        "roll": 0,
        "direction": "through",
        "length": 120,
        "offsetY": 0,
        "offsetZ": 0
      },
      "previewPlacement": {
        "target": "part",
        "reference": "center",
        "station": 0,
        "face": "top",
        "sectionRole": "branch"
      }
    },
    {
      "id": "saddle-end",
      "participants": [
        "branch"
      ],
      "label": "支管相贯端切",
      "appliesWhen": {
        "op": "eq",
        "parameter": "interfaceMode",
        "value": "saddle"
      },
      "resource": {
        "kind": "part-process",
        "id": "end-profile",
        "displayName": "支管端切"
      },
      "parameterBindings": {
        "cutMode": "concave",
        "angle": "$intersectionAngle",
        "trim": 0,
        "rotation": 0,
        "azimuth": 0,
        "roll": 0,
        "axialOffset": 0,
        "offsetY": 0,
        "offsetZ": 0
      },
      "previewPlacement": {
        "target": "end",
        "end": "end",
        "datum": "long",
        "sectionRole": "host"
      }
    }
  ],
  "manufacturingPlan": {
    "realization": "separate",
    "blankPartPolicy": "keep-separate",
    "blankParts": [
      {
        "id": "hostBlank",
        "label": "主管下料",
        "participants": [
          "host"
        ]
      },
      {
        "id": "branchBlank",
        "label": "支管下料",
        "participants": [
          "branch"
        ]
      }
    ]
  },
  "assemblyPath": [
    {
      "id": "prepare",
      "label": "加工主管单面轮廓插入口",
      "labelVariants": [
        {
          "when": {
            "op": "eq",
            "parameter": "interfaceMode",
            "value": "throughInsert"
          },
          "value": "加工主管贯穿轮廓插入口"
        },
        {
          "when": {
            "op": "eq",
            "parameter": "interfaceMode",
            "value": "saddle"
          },
          "value": "加工支管相贯端切"
        }
      ],
      "kind": "$interfaceMode",
      "direction": "交线",
      "distance": "$intersectionAngle"
    },
    {
      "id": "insert",
      "label": "支管沿轴线插入主管单面开口",
      "labelVariants": [
        {
          "when": {
            "op": "eq",
            "parameter": "interfaceMode",
            "value": "throughInsert"
          },
          "value": "支管沿轴线贯穿主管"
        },
        {
          "when": {
            "op": "eq",
            "parameter": "interfaceMode",
            "value": "saddle"
          },
          "value": "支管相贯端沿轴线贴合主管中段"
        }
      ],
      "kind": "端—中定位",
      "direction": "支管轴",
      "distance": 0
    }
  ],
  "previewScene": {
    "manufacturingParts": [
      {
        "id": "hostBlank",
        "label": "主管接口下料",
        "sourceRole": "host",
        "processes": [
          "single-opening",
          "through-opening"
        ],
        "explodedPose": {
          "origin": [
            "-$host_length / 2",
            0,
            0
          ],
          "direction": [
            1,
            0,
            0
          ],
          "up": [
            0,
            1,
            0
          ]
        }
      },
      {
        "id": "branchBlank",
        "label": "支管端部下料",
        "sourceRole": "branch",
        "processes": [
          "single-branch-end",
          "saddle-end"
        ],
        "explodedPose": {
          "origin": [
            0,
            0,
            0
          ],
          "direction": [
            1,
            0,
            0
          ],
          "up": [
            0,
            1,
            0
          ],
          "bendAngle": "-$intersectionAngle",
          "bendPlaneRotation": 0,
          "axialTranslation": "-$branch_length - 100"
        }
      }
    ],
    "compareLayout": {
      "designOffset": [
        0,
        0,
        120
      ],
      "manufacturingOffset": [
        0,
        0,
        -120
      ]
    }
  },
  "parameterDiagram": {
    "schemaVersion": 2,
    "viewBox": "0 0 64 64",
    "paths": [
      {
        "d": "M4 45 H60 V57 H4 Z",
        "className": "tool-diagram-part-a"
      },
      {
        "d": "M26 6 H38 V45 H26 Z",
        "className": "tool-diagram-part-b"
      },
      {
        "d": "M26 45 H38",
        "className": "tool-diagram-joint"
      }
    ],
    "labels": [
      {
        "x": 15,
        "y": 51,
        "text": "A",
        "className": "is-material"
      },
      {
        "x": 32,
        "y": 24,
        "text": "B",
        "className": "is-material"
      }
    ],
    "annotations": [
      {
        "parameter": "interfaceMode",
        "kind": "leader",
        "side": "top",
        "point": [
          32,
          45
        ],
        "description": "决定主管开口或支管端切"
      },
      {
        "parameter": "intersectionAngle",
        "kind": "leader",
        "side": "right",
        "point": [
          32,
          44
        ],
        "description": "主管与支管轴线夹角"
      },
      {
        "parameter": "fitGap",
        "kind": "leader",
        "side": "bottom",
        "point": [
          32,
          45
        ],
        "visibleWhen": {
          "op": "eq",
          "parameter": "interfaceMode",
          "value": "singleInsert"
        },
        "description": "主管单面开口相对支管外轮廓的单边放大量；同时校验主管内孔容纳余量"
      },
      {
        "parameter": "insertDepth",
        "kind": "leader",
        "side": "right",
        "point": [
          32,
          45
        ],
        "visibleWhen": {
          "op": "eq",
          "parameter": "interfaceMode",
          "value": "singleInsert"
        },
        "description": "支管端部越过主管外壁的轴向插入量"
      }
    ]
  },
  "outputs": {
    "manufacturingPartCount": 2,
    "partGeometry": [
      "主管轮廓接口",
      "支管端部"
    ],
    "secondaryProcess": [
      "端—中定位",
      "焊接或固定"
    ],
    "bom": [],
    "assemblyInstruction": true
  },
  "inputContract": {
    "schemaVersion": 1,
    "roles": [
      "host",
      "branch"
    ],
    "supportedInputModes": [
      "local-parts"
    ],
    "geometryParameters": [
      {
        "key": "intersectionAngle",
        "displayName": "成品轴线夹角",
        "valueType": "number",
        "defaultValue": 90,
        "min": 1,
        "max": 179,
        "step": 1,
        "unit": "°",
        "level": "basic"
      }
    ],
    "requirements": {
      "intersectionAngle": {
        "min": 10,
        "max": 170
      }
    }
  },
  "exampleInput": {
    "shapeId": "t",
    "roles": {
      "host": "main",
      "branch": "branch"
    },
    "parameterBindings": {
      "intersectionAngle": "intersectionAngle"
    },
    "requirements": {
      "intersectionAngle": {
        "min": 10,
        "max": 170
      }
    }
  }
}
