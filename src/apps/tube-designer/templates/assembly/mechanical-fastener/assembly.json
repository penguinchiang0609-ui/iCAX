        "description": "长孔提供的单向调节范围"
      }
    ]
  },
  "outputs": {
    "manufacturingPartCount": 2,
    "partGeometry": [
      "被连接件孔系",
      "基准件孔系"
    ],
    "secondaryProcess": [
      "紧固件装配"
    ],
    "bom": [],
    "assemblyInstruction": true
  },
  "inputContract": {
    "schemaVersion": 1,
    "roles": [
      "fastenedPart",
      "basePart"
    ],
    "supportedInputModes": [
      "local-parts"
    ],
    "geometryParameters": [
      {
        "key": "overlapLength",
        "displayName": "轴向重合长度",
        "valueType": "number",
        "defaultValue": 440,
        "min": 1,
        "max": 100000,
        "step": 1,
        "unit": "mm"
      }
    ],
    "requirements": {}
  },
  "exampleInput": {
    "shapeId": "parallel",
    "roles": {
      "fastenedPart": "lower",
      "basePart": "upper"
    },
    "parameterBindings": {},
    "requirements": {}
  }
}
