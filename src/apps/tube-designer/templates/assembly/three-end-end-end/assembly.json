    {"id":"cut-b","participants":["armB"],"label":"B 端切","resource":{"kind":"part-process","id":"end-miter","displayName":"端面切割"},"parameterBindings":{"angle":"-$miterAngle","trim":0,"rotation":0,"datum":"long"},"previewPlacement":{"target":"end","end":"end","datum":"long"}},
    {"id":"cut-c","participants":["armC"],"label":"C 端切","resource":{"kind":"part-process","id":"end-miter","displayName":"端面切割"},"parameterBindings":{"angle":"$miterAngle","trim":0,"rotation":90,"datum":"long"},"previewPlacement":{"target":"end","end":"end","datum":"long"}}
  ],
  "manufacturingPlan":{"realization":"separate","blankPartPolicy":"keep-separate","blankParts":[
