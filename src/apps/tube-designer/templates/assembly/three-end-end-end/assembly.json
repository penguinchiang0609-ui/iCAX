  ]},
  "assemblyPath":[{"id":"cut","label":"加工三个节点端面","kind":"三端端切","direction":"节点","distance":"$miterAngle"},{"id":"fit","label":"三个端部汇交定位","kind":"$nodeLayout","direction":"节点中心","distance":"$fitGap"}],
  "previewScene":{
    "designParts":[
      {"role":"armA","profileRef":{"scope":"system","id":"rect"},"parameters":{"width":50,"depth":40,"wallThickness":2,"cornerRadius":2,"innerRadius":1},"length":240,"pose":{"origin":[-240,0,0],"direction":[1,0,0],"up":[0,1,0]}},
      {"role":"armB","profileRef":{"scope":"system","id":"rect"},"parameters":{"width":50,"depth":40,"wallThickness":2,"cornerRadius":2,"innerRadius":1},"length":240,"pose":{"origin":[240,0,0],"direction":[-1,0,0],"up":[0,1,0]}},
      {"role":"armC","profileRef":{"scope":"system","id":"rect"},"parameters":{"width":50,"depth":40,"wallThickness":2,"cornerRadius":2,"innerRadius":1},"length":240,"pose":{"origin":[0,240,0],"direction":[0,-1,0],"up":[0,0,1]},"poseVariants":[{"when":{"op":"eq","parameter":"nodeLayout","value":"spatialY"},"value":{"origin":[0,0,240],"direction":[0,0,-1],"up":[0,1,0]}}]}
    ],
    "manufacturingParts":[
      {"id":"blankA","label":"A 端切下料","sourceRole":"armA","processes":["cut-a"],"explodedPose":{"origin":[-240,0,0],"direction":[1,0,0],"up":[0,1,0],"axialTranslation":-100}},
      {"id":"blankB","label":"B 端切下料","sourceRole":"armB","processes":["cut-b"],"explodedPose":{"origin":[240,0,0],"direction":[-1,0,0],"up":[0,1,0],"axialTranslation":-100}},
      {"id":"blankC","label":"C 端切下料","sourceRole":"armC","processes":["cut-c"],"explodedPose":{"origin":[0,240,0],"direction":[0,-1,0],"up":[0,0,1],"axialTranslation":-100},"explodedPoseVariants":[{"when":{"op":"eq","parameter":"nodeLayout","value":"spatialY"},"value":{"origin":[0,0,240],"direction":[0,0,-1],"up":[0,1,0],"axialTranslation":-100}}]}
    ],"compareLayout":{"designOffset":[0,0,130],"manufacturingOffset":[0,0,-130]}
  },
  "parameterDiagram":{"schemaVersion":2,"viewBox":"0 0 240 170","paths":["M20 85 H220","M120 20 V85"],"annotations":[{"parameter":"nodeLayout","kind":"leader","side":"top","point":[120,85],"description":"选择平面或空间三端节点"},{"parameter":"miterAngle","kind":"leader","side":"right","point":[120,85],"description":"三个下料端面的切割角度"},{"parameter":"fitGap","kind":"leader","side":"bottom","point":[120,85],"description":"节点中心预留间隙"}]},
  "outputs":{"manufacturingPartCount":3,"partGeometry":["A 端切","B 端切","C 端切"],"secondaryProcess":["三端节点定位","焊接"],"bom":[],"assemblyInstruction":true}
