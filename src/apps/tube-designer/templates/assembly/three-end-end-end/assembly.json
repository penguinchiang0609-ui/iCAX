    {"role":"armC","label":"构件 C","responsibility":"第三节点端","count":1}
  ],
  "parameters":[
    {"key":"nodeLayout","displayName":"节点布局","valueType":"choice","defaultValue":"planarT","options":[{"value":"planarT","label":"平面 T 形"},{"value":"spatialY","label":"空间三向"}],"level":"basic"},
    {"key":"miterAngle","displayName":"端切角度","valueType":"number","defaultValue":45,"min":0,"max":80,"step":1,"unit":"°","level":"basic"},
    {"key":"fitGap","displayName":"节点间隙","valueType":"number","defaultValue":0,"min":0,"max":20,"step":0.1,"unit":"mm","level":"basic"}
  ],
  "partProcesses":[
