{
  "schema": "icax.assembly-template",
  "schemaVersion": 1,
  "id": "orthogonal-corner",
  "version": "1.0.3",
  "displayName": "三向直角节点",
  "category": "three-end-orthogonal",
  "layoutShape": "orthogonal-corner",
  "categoryName": "三向角点",
  "summary": "三根互相垂直的直管共用角点；A/B 斜接或包接，C 贴焊、插入或圆弧公母。",
  "topology": "三向互垂直端点",
  "interfaceType": "组合端切与节点侧壁开口",
  "lockType": "装配后焊接固定",
  "motionType": "C 沿第三轴插入共同角面",
  "catalogueDiagram": {
    "viewBox": "0 0 64 64",
    "paths": [
      {
        "d": "M5 47 L36 29 L46 35 L15 53 Z",
        "tone": "a"
      },
      {
        "d": "M36 29 L57 42 L47 48 L26 35 Z",
        "tone": "b"
      },
      {
        "d": "M31 8 L41 8 L41 32 L36 35 L31 32 Z",
        "tone": "c"
      },
      {
        "d": "M26 35 L46 35 M31 32 L41 32",
        "tone": "joint"
      }
    ]
  },
  "participants": [
    {
      "role": "memberA",
      "label": "A 边",
      "responsibility": "三向节点 A 直管",
      "count": 1
    },
    {
      "role": "memberB",
      "label": "B 边",
      "responsibility": "三向节点 B 直管",
      "count": 1
    },
    {
      "role": "memberC",
      "label": "C 边",
      "responsibility": "三向节点 C 直管",
      "count": 1
    }
  ],
  "parameters": [
    {
      "key": "abJoint",
      "displayName": "A / B 转角连接",
      "valueType": "choice",
      "defaultValue": "miter",
      "options": [
        {
          "value": "miter",
          "label": "双端斜接"
        },
        {
          "value": "wrap",
          "label": "A 长件包接 B"
        },
        {
          "value": "continuous",
          "label": "A / B 已为连续母材"
        }
      ],
      "level": "basic"
    },
    {
      "key": "cJoint",
      "displayName": "C 第三件连接",
      "valueType": "choice",
      "defaultValue": "weld",
      "options": [
        {
          "value": "weld",
          "label": "端面贴焊"
        },
        {
          "value": "insert",
          "label": "轮廓插入"
        },
        {
          "value": "tabs",
          "label": "圆弧公母"
        }
      ],
      "level": "basic"
    },
    {
      "key": "insertDepth",
      "displayName": "C 插入深度",
      "valueType": "number",
      "defaultValue": 12,
      "min": 0.1,
      "max": 100,
      "step": 0.1,
      "unit": "mm",
      "level": "basic",
      "visibleWhen": {
        "op": "eq",
        "parameter": "cJoint",
        "value": "insert"
      }
    },
    {
      "key": "fitGap",
      "displayName": "轮廓孔单边间隙",
      "valueType": "number",
      "defaultValue": 0.2,
      "min": 0,
      "max": 3,
      "step": 0.1,
      "unit": "mm",
      "level": "basic",
      "visibleWhen": {
        "op": "eq",
        "parameter": "cJoint",
        "value": "insert"
      }
    },
    {
      "key": "tabWidth",
      "displayName": "圆弧插舌宽度",
      "valueType": "number",
      "defaultValue": 8,
      "min": 1,
      "max": 30,
      "step": 0.1,
      "unit": "mm",
      "level": "basic",
      "visibleWhen": {
        "op": "eq",
        "parameter": "cJoint",
        "value": "tabs"
      }
    },
    {
      "key": "tabLength",
      "displayName": "圆弧插舌插入长度",
      "valueType": "number",
      "defaultValue": 12,
      "min": 1,
      "max": 60,
      "step": 0.1,
      "unit": "mm",
      "level": "basic",
      "visibleWhen": {
        "op": "eq",
        "parameter": "cJoint",
        "value": "tabs"
      }
    },
    {
      "key": "sideClearance",
      "displayName": "公母单边间隙",
      "valueType": "number",
      "defaultValue": 0.2,
      "min": 0,
      "max": 3,
      "step": 0.1,
      "unit": "mm",
      "level": "basic",
      "visibleWhen": {
        "op": "eq",
        "parameter": "cJoint",
        "value": "tabs"
      }
    }
  ],
  "partProcesses": [
    {
      "id": "ab-miter-a",
      "participants": [
        "memberA"
      ],
      "label": "A 节点斜切",
      "appliesWhen": {
        "op": "eq",
        "parameter": "abJoint",
        "value": "miter"
      },
      "resource": {
        "kind": "part-process",
        "id": "end-miter"
      },
      "parameterBindings": {
        "angle": -45,
        "trim": 0,
        "rotation": 90,
        "datum": "long"
      },
      "previewPlacement": {
        "target": "end",
        "end": "end",
        "datum": "long"
      }
    },
    {
      "id": "ab-miter-b",
      "participants": [
        "memberB"
      ],
      "label": "B 节点斜切",
      "appliesWhen": {
        "op": "eq",
        "parameter": "abJoint",
        "value": "miter"
      },
      "resource": {
        "kind": "part-process",
        "id": "end-miter"
      },
      "parameterBindings": {
        "angle": 45,
        "trim": 0,
        "rotation": 90,
        "datum": "long"
      },
      "previewPlacement": {
        "target": "end",
        "end": "start",
        "datum": "long"
      }
    },
    {
      "id": "ab-wrap-b",
      "participants": [
        "memberB"
      ],
      "label": "B 退切至 A 侧壁",
      "appliesWhen": {
        "op": "eq",
        "parameter": "abJoint",
        "value": "wrap"
      },
      "resource": {
        "kind": "part-process",
        "id": "end-miter"
      },
      "parameterBindings": {
        "angle": 0,
        "trim": 0,
        "rotation": 0,
        "datum": "long"
      },
      "previewPlacement": {
        "target": "end",
        "end": "start",
        "datum": "long"
      }
    },
    {
      "id": "c-weld-end",
      "participants": [
        "memberC"
      ],
      "label": "C 端部 平切贴合",
      "appliesWhen": {
        "op": "eq",
        "parameter": "cJoint",
        "value": "weld"
      },
      "resource": {
        "kind": "part-process",
        "id": "end-miter"
      },
      "parameterBindings": {
        "angle": 0,
        "trim": 0,
        "rotation": 0,
        "datum": "long"
      },
      "previewPlacement": {
        "target": "end",
        "end": "start",
        "datum": "long"
      }
    },
    {
      "id": "c-insert-end",
      "participants": [
        "memberC"
      ],
      "label": "C 端部 插入端切",
      "appliesWhen": {
        "op": "eq",
        "parameter": "cJoint",
        "value": "insert"
      },
      "resource": {
        "kind": "part-process",
        "id": "end-miter"
      },
      "parameterBindings": {
        "angle": 0,
        "trim": 0,
        "rotation": 0,
        "datum": "long"
      },
      "previewPlacement": {
        "target": "end",
        "end": "start",
        "datum": "long"
      }
    },
    {
      "id": "c-tabs-end",
      "participants": [
        "memberC"
      ],
      "label": "C 端部 圆弧插舌",
      "appliesWhen": {
        "op": "eq",
        "parameter": "cJoint",
        "value": "tabs"
      },
      "resource": {
        "kind": "part-process",
        "id": "paired-end-tabs"
      },
      "parameterBindings": {
        "pairCount": 2,
        "tabWidth": "$tabWidth",
        "tabLength": "$tabLength",
        "trim": 0,
        "rotation": 0
      },
      "previewPlacement": {
        "target": "end",
        "end": "start",
        "datum": "long",
        "sectionRole": "memberA"
      }
    },
    {
      "id": "c-insert-a",
      "participants": [
        "memberA"
      ],
      "label": "A 承接 C 轮廓孔",
      "appliesWhen": {
        "op": "eq",
        "parameter": "cJoint",
        "value": "insert"
      },
      "resource": {
        "kind": "part-process",
        "id": "branch-profile"
      },
      "parameterBindings": {
        "angle": 90,
        "azimuth": 90,
        "roll": 0,
        "direction": "positive",
        "length": 120,
        "clearance": "$fitGap",
        "offsetY": 0,
        "offsetZ": 0
      },
      "previewPlacement": {
        "target": "part",
        "face": "right",
        "reference": "start",
        "station": 0,
        "offset": 0,
        "sectionRole": "memberC"
      }
    },
    {
      "id": "c-tabs-a",
      "participants": [
        "memberA"
      ],
      "label": "A 承接 C 圆弧母槽",
      "appliesWhen": {
        "op": "eq",
        "parameter": "cJoint",
        "value": "tabs"
      },
      "resource": {
        "kind": "part-process",
        "id": "paired-side-slots"
      },
      "parameterBindings": {
        "pairCount": 2,
        "tabWidth": "$tabWidth",
        "tabLength": "$tabLength",
        "sideClearance": "$sideClearance",
        "pairRotation": 0,
        "allowEndOpening": false
      },
      "previewPlacement": {
        "target": "part",
        "face": "right",
        "reference": "start",
        "station": 0,
        "offset": 0,
        "sectionRole": "memberC"
      }
    },
    {
      "id": "c-insert-b",
      "participants": [
        "memberB"
      ],
      "label": "B 承接 C 轮廓孔",
      "appliesWhen": {
        "op": "all",
        "conditions": [
          {
            "op": "eq",
            "parameter": "cJoint",
            "value": "insert"
          },
          {
            "op": "any",
            "conditions": [
              {
                "op": "eq",
                "parameter": "abJoint",
                "value": "miter"
              },
              {
                "op": "eq",
                "parameter": "abJoint",
                "value": "continuous"
