      },
      "resource": {
        "kind": "part-process",
        "id": "paired-side-slots"
      },
      "parameterBindings": {
        "pairCount": 2,
        "tabWidth": "$tabWidth",
        "tabLength": "$tabLength",
        "sideClearance": "$sideClearance",
        "pairRotation": 90,
        "allowEndOpening": false
      },
      "previewPlacement": {
        "target": "part",
        "face": "right",
        "reference": "start",
        "station": 0,
        "offset": 0,
        "sectionRole": "memberC"
      }
