{
  "catalogueDiagram": {
    "viewBox": "0 0 64 64",
    "paths": [
      {
        "d": "M4 45 H33 L45 57 H4 Z",
        "tone": "a"
      },
      {
        "d": "M33 6 H45 V57 L33 45 Z",
        "tone": "b"
      },
      {
        "d": "M33 45 L45 57",
        "tone": "joint"
      }
    ]
  },
  "schema": "icax.assembly-template",
  "schemaVersion": 1,
  "id": "two-end-end-angle",
  "version": "1.2.3",
  "displayName": "斜接 · 双端对切",
  "category": "two-end-end",
  "layoutShape": "l",
  "categoryName": "两件 · 端—端",
  "summary": "两个管段在同一节点斜接，两侧端面按轴线转角对切；0° 可作为直连退化情况。",
  "topology": "端部—端部",
  "interfaceType": "端部斜接 / 0° 直连",
  "lockType": "焊接或现场固定",
  "motionType": "端面配合",
  "participants": [
    {
      "role": "memberA",
      "label": "构件 A",
      "responsibility": "第一端部",
      "count": 1
    },
    {
      "role": "memberB",
      "label": "构件 B",
      "responsibility": "第二端部",
      "count": 1
    }
  ],
  "productBinding": {
    "mode": "incremental-cut",
    "compatibleProductTopologies": [
      {
        "topology": "L",
        "when": {
          "op": "ne",
          "parameter": "jointAngle",
          "value": 0
        }
      },
      {
        "topology": "straight",
        "when": {
          "op": "eq",
          "parameter": "jointAngle",
          "value": 0
        }
      }
    ],
    "anchors": {
      "memberA": "end",
      "memberB": "end"
    },
    "connectionOnlyWhen": {
      "op": "all",
      "conditions": [
        {
          "op": "eq",
          "parameter": "jointAngle",
          "value": 0
        },
        {
          "op": "eq",
          "parameter": "fitGap",
          "value": 0
        }
      ]
    },
    "axisAngle": {
      "roles": [
        "memberA",
        "memberB"
      ],
      "directions": [
        "awayFromAnchor",
        "awayFromAnchor"
      ],
      "measure": "supplement",
      "expected": {
        "parameter": "jointAngle"
      }
    },
    "fitChecks": [
      {
        "id": "miter-corner",
        "kind": "end-end-miter",
        "topology": "L",
        "when": {
          "op": "ne",
          "parameter": "jointAngle",
          "value": 0
        },
        "roles": {
          "a": "memberA",
          "b": "memberB"
        },
        "processIds": [
          "miter-a",
          "miter-b"
        ],
        "gap": {
          "parameter": "fitGap"
        },
        "planeRotation": {
          "parameter": "planeRotation"
        }
      },
      {
        "id": "miter-straight",
        "kind": "end-end-miter",
        "topology": "straight",
        "when": {
          "op": "eq",
          "parameter": "jointAngle",
          "value": 0
        },
        "roles": {
          "a": "memberA",
          "b": "memberB"
        },
        "processIds": [
          "miter-a",
          "miter-b"
        ],
        "gap": {
          "parameter": "fitGap"
        },
        "planeRotation": {
          "parameter": "planeRotation"
        }
      }
    ],
    "processes": {
      "miter-a": {
        "target": "end",
        "parameterSources": {
          "angle": {
            "role": "memberA",
            "field": "nodeFrame.miterAngle",
            "angleParameter": "jointAngle"
          },
          "rotation": {
            "role": "memberA",
            "field": "nodeFrame.miterRotation",
            "angleParameter": "jointAngle"
          },
          "trim": {
            "role": "memberA",
            "field": "anchor.stockAllowance",
            "offsetParameter": "fitGap",
            "offsetFactor": 0.5,
            "offsetProjection": "miter-face-normal",
            "offsetAngleParameter": "jointAngle"
          },
          "datum": {
            "role": "memberA",
            "field": "constant",
            "value": "center"
          }
        }
      },
      "miter-b": {
        "target": "end",
        "parameterSources": {
          "angle": {
            "role": "memberB",
            "field": "nodeFrame.miterAngle",
            "angleParameter": "jointAngle"
          },
          "rotation": {
            "role": "memberB",
            "field": "nodeFrame.miterRotation",
            "angleParameter": "jointAngle"
          },
          "trim": {
            "role": "memberB",
            "field": "anchor.stockAllowance",
            "offsetParameter": "fitGap",
            "offsetFactor": 0.5,
            "offsetProjection": "miter-face-normal",
            "offsetAngleParameter": "jointAngle"
          },
          "datum": {
            "role": "memberB",
            "field": "constant",
            "value": "center"
          }
        }
      }
    }
  },
  "parameters": [
    {
      "key": "fitGap",
      "displayName": "端面法向间隙",
      "valueType": "number",
      "defaultValue": 0,
      "min": 0,
      "max": 20,
      "step": 0.1,
      "unit": "mm",
      "level": "basic"
    }
  ],
  "partProcesses": [
    {
      "id": "miter-a",
      "participants": [
        "memberA"
      ],
      "label": "A 端面切割",
      "resource": {
        "kind": "part-process",
        "id": "end-miter",
        "displayName": "端面切割"
      },
      "parameterBindings": {
        "angle": "-$jointAngle / 2",
        "trim": {
          "kind": "miter-normal-gap-axial-trim",
          "gapParameter": "fitGap",
          "angleParameter": "jointAngle",
          "share": 0.5
        },
        "rotation": "$planeRotation + 90",
        "datum": "long"
      },
      "previewPlacement": {
        "target": "end",
        "end": "end",
        "datum": "long"
      }
    },
    {
      "id": "miter-b",
      "participants": [
        "memberB"
      ],
      "label": "B 端面切割",
      "resource": {
        "kind": "part-process",
        "id": "end-miter",
        "displayName": "端面切割"
      },
      "parameterBindings": {
        "angle": "$jointAngle / 2",
        "trim": {
          "kind": "miter-normal-gap-axial-trim",
          "gapParameter": "fitGap",
          "angleParameter": "jointAngle",
          "share": 0.5
        },
        "rotation": "$planeRotation + 90",
        "datum": "long"
      },
      "previewPlacement": {
        "target": "end",
        "end": "start",
        "datum": "long"
      }
    }
  ],
  "manufacturingPlan": {
    "realization": "separate",
    "blankPartPolicy": "keep-separate",
    "blankParts": [
      {
        "id": "blankA",
        "label": "构件 A 下料",
        "participants": [
          "memberA"
        ]
      },
      {
        "id": "blankB",
        "label": "构件 B 下料",
        "participants": [
          "memberB"
        ]
      }
    ]
  },
  "assemblyPath": [
    {
      "id": "cut",
      "label": "按轴线转角切割两侧端面",
      "kind": "端面切割",
      "direction": "接合面",
      "distance": "$jointAngle"
    },
    {
      "id": "fit",
      "label": "对正两端面",
      "kind": "端部对接",
      "direction": "端面法向",
      "distance": "$fitGap"
    }
  ],
  "previewScene": {
    "formedPreviewScript": "assembly.py",
    "manufacturingParts": [
      {
        "id": "blankA",
        "label": "构件 A 端切下料",
        "sourceRole": "memberA",
        "processes": [
          "miter-a"
        ],
        "explodedPose": {
          "origin": [
            "-$memberA_length",
