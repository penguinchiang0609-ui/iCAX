        "label": "构件 B 端切下料",
        "sourceRole": "memberB",
        "processes": [
          "miter-b"
        ],
        "explodedPose": {
          "origin": [
            0,
            0,
            0
          ],
          "direction": [
            1,
            0,
            0
          ],
          "up": [
            0,
            1,
            0
          ],
          "bendAngle": "-$jointAngle",
          "bendPlaneRotation": "$planeRotation",
          "axialTranslation": 100
        }
      }
    ],
    "compareLayout": {
      "designOffset": [
        0,
        0,
        120
      ],
      "manufacturingOffset": [
        0,
        0,
        -120
      ]
    }
  },
  "parameterDiagram": {
    "schemaVersion": 2,
    "viewBox": "0 0 64 64",
    "paths": [
      {
        "d": "M4 45 H33 L45 57 H4 Z",
        "className": "tool-diagram-part-a"
      },
      {
        "d": "M33 6 H45 V57 L33 45 Z",
        "className": "tool-diagram-part-b"
      },
      {
        "d": "M33 45 L45 57",
        "className": "tool-diagram-joint"
      }
    ],
    "labels": [
      {
        "x": 16,
        "y": 51,
        "text": "A",
        "className": "is-material"
      },
      {
        "x": 39,
