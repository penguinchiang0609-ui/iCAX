  },
  "outputs": {
    "manufacturingPartCount": 2,
    "partGeometry": [
      "构件 A 端切",
      "构件 B 端切"
    ],
    "secondaryProcess": [
      "端部对正",
      "焊接或固定"
    ],
    "bom": [],
    "assemblyInstruction": true
  },
  "inputContract": {
    "schemaVersion": 1,
    "roles": [
      "memberA",
      "memberB"
    ],
    "supportedInputModes": [
      "local-parts"
    ],
    "geometryParameters": [
      {
        "key": "jointAngle",
        "displayName": "成品转角",
        "valueType": "number",
        "defaultValue": 90,
        "min": 0,
        "max": 179,
        "step": 1,
        "unit": "°",
        "level": "basic"
      },
      {
        "key": "planeRotation",
        "displayName": "外形平面转角",
        "valueType": "number",
        "defaultValue": 0,
        "min": -180,
        "max": 180,
        "step": 1,
        "unit": "°",
        "level": "advanced"
      }
    ],
    "requirements": {
