{
  "catalogueDiagram": {
    "viewBox": "0 0 64 64",
    "paths": [
      {
        "d": "M4 23 H27 V27 H34 V37 H27 V41 H4 Z",
        "tone": "a"
      },
      {
        "d": "M60 23 H35 V27 H41 V37 H35 V41 H60 Z",
        "tone": "b"
      },
      {
        "d": "M27 27 H34 V37 H27",
        "tone": "joint"
      }
    ]
  },
  "schema": "icax.assembly-template",
  "schemaVersion": 1,
  "id": "tab-slot-lock",
  "version": "1.0.1",
  "displayName": "插舌 / 插槽装配",
  "category": "two-end-end",
  "layoutShape": "straight",
  "categoryName": "两件 · 端—端",
  "summary": "两个逻辑零件分别下料，加工插舌与插槽后沿装配轴插入并锁止。",
  "topology": "端部—端部",
  "interfaceType": "插舌 / 插槽",
  "lockType": "结构锁止",
  "motionType": "直线插入",
  "participants": [
    {
      "role": "tab",
      "label": "插舌件",
      "responsibility": "主动件",
      "count": 1
    },
    {
      "role": "slot",
      "label": "插槽件",
      "responsibility": "承接件",
      "count": 1
    }
  ],
  "productBinding": {
    "mode": "incremental-cut",
    "compatibleProductTopologies": [
      {
        "topology": "straight"
      }
    ],
    "anchors": {
      "tab": "end",
      "slot": "end"
    },
    "processes": {
      "tab-end": {
        "target": "end"
      },
      "slot-end": {
        "target": "end"
      }
    },
    "unsupportedBranches": [
      {
        "when": {
          "op": "in",
          "parameter": "lockMethod",
          "values": [
            "bolt"
          ]
        },
        "reason": "尚未声明螺栓锁止孔，不能生成完整实际加工绑定"
      }
    ]
  },
  "parameters": [
    {
      "key": "nominalWidth",
      "displayName": "装配名义宽度",
      "valueType": "number",
      "defaultValue": 20,
      "min": 1,
      "max": 200,
      "step": 0.1,
      "unit": "mm",
      "level": "basic"
    },
    {
      "key": "straightDepth",
      "displayName": "插入直线段深度",
      "valueType": "number",
      "defaultValue": 20,
      "min": 0,
      "max": 300,
      "step": 0.1,
      "unit": "mm",
      "level": "basic"
    },
    {
      "key": "fitClearance",
      "displayName": "配合间隙",
      "valueType": "number",
      "defaultValue": 0.2,
      "min": 0,
      "max": 5,
      "step": 0.1,
      "unit": "mm",
      "level": "advanced"
    },
    {
      "key": "lockMethod",
      "displayName": "锁止方式",
      "valueType": "choice",
      "defaultValue": "self",
      "options": [
        {
          "value": "self",
          "label": "结构自锁"
        },
        {
          "value": "weld",
          "label": "点焊锁止"
        },
        {
          "value": "bolt",
          "label": "螺栓锁止"
        }
      ],
      "level": "advanced"
    }
  ],
  "partProcesses": [
    {
      "id": "tab-end",
      "participants": [
        "tab"
      ],
      "label": "插舌端部成形",
      "resource": {
        "kind": "part-process",
        "id": "end-key-joint",
        "displayName": "插舌／插槽"
      },
      "parameterBindings": {
        "gender": "male",
        "width": "$nominalWidth",
        "straightDepth": "$straightDepth"
      },
      "previewPlacement": {
        "target": "end",
        "end": "end",
        "datum": "long"
      }
    },
    {
      "id": "slot-end",
      "participants": [
        "slot"
      ],
      "label": "插槽端部成形",
      "resource": {
        "kind": "part-process",
        "id": "end-key-joint",
        "displayName": "插舌／插槽"
      },
      "parameterBindings": {
        "gender": "female",
        "width": "$nominalWidth",
        "straightDepth": "$straightDepth",
        "sideClearance": "$fitClearance",
        "axialClearance": "$fitClearance"
      },
      "previewPlacement": {
        "target": "end",
        "end": "start",
        "datum": "long"
      }
    }
  ],
  "manufacturingPlan": {
    "realization": "separate",
    "blankPartPolicy": "keep-separate",
    "blankParts": [
      {
        "id": "tabBlank",
        "label": "插舌下料件",
        "participants": [
          "tab"
        ]
      },
      {
        "id": "slotBlank",
        "label": "插槽下料件",
        "participants": [
          "slot"
        ]
      }
    ]
  },
  "assemblyPath": [
    {
      "id": "align",
      "label": "对正插舌与插槽",
      "kind": "对正",
      "direction": "assembly.z",
      "distance": 0
    },
    {
      "id": "insert",
      "label": "沿装配轴插入",
      "kind": "直线",
      "direction": "assembly.z",
      "distance": "$straightDepth+$nominalWidth/2"
    },
    {
      "id": "lock",
      "label": "通过插舌结构自锁",
      "labelVariants": [
        {
          "when": {
            "op": "eq",
            "parameter": "lockMethod",
            "value": "weld"
          },
          "value": "在插舌与插槽接合处点焊锁止"
        },
        {
          "when": {
            "op": "eq",
            "parameter": "lockMethod",
            "value": "bolt"
          },
          "value": "增加锁止孔后装入螺栓"
        }
      ],
      "kind": "$lockMethod",
      "direction": "assembly.z",
      "distance": 0
    }
  ],
  "bomRules": [
    {
      "id": "lock-bolt",
      "label": "插舌锁止螺栓",
      "quantity": 1,
      "unit": "件",
      "when": {
        "op": "eq",
        "parameter": "lockMethod",
        "value": "bolt"
      },
      "specificationStatus": "requires-size-selection"
    }
  ],
  "dimensionChecks": [
    {
      "id": "bolt-hole-missing",
      "kind": "required-process",
      "detail": "螺栓锁止尚未声明锁止孔加工，不能直接用于产品拆单",
      "when": {
        "op": "eq",
        "parameter": "lockMethod",
        "value": "bolt"
      }
    }
  ],
  "previewScene": {
    "manufacturingParts": [
      {
        "id": "tabBlank",
        "label": "插舌下料件",
        "sourceRole": "tab",
        "stockLengthAddition": "$straightDepth + $nominalWidth / 2",
        "processes": [
          "tab-end"
        ],
        "explodedPose": {
          "origin": [
            "-$tab_length",
            0,
            0
          ],
          "direction": [
            1,
            0,
            0
          ],
          "up": [
            0,
            1,
            0
          ],
          "axialTranslation": -100
        }
      },
      {
        "id": "slotBlank",
        "label": "插槽下料件",
        "sourceRole": "slot",
        "processes": [
          "slot-end"
        ],
        "explodedPose": {
          "origin": [
            0,
            0,
            0
          ],
          "direction": [
            1,
            0,
            0
          ],
          "up": [
            0,
            1,
            0
          ],
          "axialTranslation": "-$straightDepth - $nominalWidth / 2 + 100"
        }
      }
    ],
    "compareLayout": {
      "designOffset": [
        0,
