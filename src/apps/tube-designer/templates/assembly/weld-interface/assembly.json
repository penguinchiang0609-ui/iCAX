        ],
        "description": "决定两件拓扑、端切和开孔方式"
      },
      {
        "parameter": "fitGap",
        "kind": "linear",
        "axis": "x",
        "side": "bottom",
        "from": [
          31,
          31
        ],
        "to": [
          33,
