        ],
        "description": "两件搭接区域长度"
      }
    ]
  },
  "outputs": {
    "manufacturingPartCount": 2,
    "partGeometry": [
      "基准焊件",
      "带塞焊孔或槽焊孔的配合焊件"
    ],
    "secondaryProcess": [
      "装配定位",
      "焊接"
    ],
    "bom": [],
    "assemblyInstruction": true
  },
  "inputContract": {
    "schemaVersion": 1,
    "roles": [
      "primary",
      "secondary"
    ],
    "supportedInputModes": [
      "local-parts"
    ],
    "geometryParameters": [
      {
        "key": "overlapLength",
        "displayName": "轴向重合长度",
        "valueType": "number",
        "defaultValue": 440,
        "min": 1,
        "max": 100000,
        "step": 1,
        "unit": "mm"
      }
    ],
    "requirements": {
      "overlapLength": {
        "min": 10,
        "max": 500
      }
    }
  },
  "exampleInput": {
    "shapeId": "parallel",
    "roles": {
      "primary": "lower",
      "secondary": "upper"
    },
    "parameterBindings": {
      "overlapLength": "overlapLength"
    },
    "requirements": {
      "overlapLength": {
        "min": 10,
        "max": 500
      }
    }
  }
}
