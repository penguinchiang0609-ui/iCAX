<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- The desktop Debug runtime is used for interactive modelling too. Keep
       symbols, _DEBUG and STL checks, while optimizing the document/geometry
       computation units so template-heavy value handling does not dominate
       normal edits and disassembly. Other units retain ordinary Debug builds. -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <ICAXDebugComputationSources Condition="'$(MSBuildProjectName)' == 'Data'">Variant.cpp;VariantSerializer.cpp</ICAXDebugComputationSources>
    <ICAXDebugComputationSources Condition="'$(MSBuildProjectName)' == 'Database'">Repository.cpp;OperationLog.cpp;ComponentBase.cpp;Entity.cpp;ChangeSet.cpp;RepositoryUndoRedoHistory.cpp</ICAXDebugComputationSources>
    <ICAXDebugComputationSources Condition="'$(MSBuildProjectName)' == 'TemplateRuntime'">TemplateCodec.cpp;StandardJsonCodec.cpp;PythonTemplateHost.cpp</ICAXDebugComputationSources>
    <ICAXDebugComputationSources Condition="'$(MSBuildProjectName)' == 'ProjectFile'">ProjectDocument.cpp;ProjectFileCodec.cpp;ProjectFileStore.cpp</ICAXDebugComputationSources>
    <ICAXDebugComputationSources Condition="'$(MSBuildProjectName)' == 'ProjectFile'">ProjectDocument.cpp;ProjectFileCodec.cpp;ProjectFileStore.cpp</ICAXDebugComputationSources>
    <ICAXDebugComputationSources Condition="'$(MSBuildProjectName)' == 'OpenCascadeResourceImport'">OpenCascadeNeutralModelEvaluator.cpp;OpenCascadeResourceImporter.cpp;OpenCascadeBRepBuilder.cpp</ICAXDebugComputationSources>
    <ICAXDebugComputationSources Condition="'$(MSBuildProjectName)' == 'TubeDesigner'">TubeDesignerSDO.cpp;TubeDesigner.cpp</ICAXDebugComputationSources>
    <!-- Native fixtures register the same inline component metadata as the
         product DLL. Compile those registrations with the product's settings
         so the test EXE cannot substitute an unoptimized field handler. -->
    <ICAXDebugComputationSources Condition="'$(MSBuildProjectName)' == 'TubeDesignerTest'">TubeDesignerTests.cpp;PunchPersistenceSDOTests.cpp;PunchGeometryTests.cpp;NestingAdapterTests.cpp;NestingStandardPartSDOTests.cpp;ImportedPartBatchRecoveryTests.cpp;ImportedPartHoleRecoveryTests.cpp</ICAXDebugComputationSources>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64' and '$(ICAXDebugComputationSources)' != ''">
    <ClCompile Update="$(ICAXDebugComputationSources)">
      <Optimization>MaxSpeed</Optimization>
      <InlineFunctionExpansion>AnySuitable</InlineFunctionExpansion>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <SupportJustMyCode>false</SupportJustMyCode>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>
  <UsingTask TaskName="ICAXCheckWritableBuildOutputs"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <OutputPaths ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        foreach (var item in OutputPaths)
        {
            var path = Path.GetFullPath(item.ItemSpec);
            if (!File.Exists(path))
                continue;

            try
            {
                // Probe write access without changing the file. Windows refuses
                // this while an executable or DLL is loaded by a running process.
                using (var stream = new FileStream(path, FileMode.Open, FileAccess.Write,
                    FileShare.ReadWrite | FileShare.Delete)) { }
            }
            catch (IOException exception)
            {
                Log.LogError("iCAX", "ICAXBUILD001", null, path, 0, 0, 0, 0,
                    "无法更新生成文件。请先保存并关闭正在运行的 TubeDesigner 或测试程序，再重新生成。原因：{0}", exception.Message);
                return false;
            }
            catch (UnauthorizedAccessException exception)
            {
                Log.LogError("iCAX", "ICAXBUILD001", null, path, 0, 0, 0, 0,
                    "无法写入生成文件。请关闭正在运行的 TubeDesigner 或测试程序，并检查文件是否只读及目录权限。原因：{0}", exception.Message);
                return false;
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Check before CppClean removes import libraries, not just when linking.
       ProjectReference remains responsible for dependency scheduling. -->
  <Target Name="ICAXCheckBuildOutputLocks"
          BeforeTargets="CoreCppClean"
          Condition="'$(VCProjectVersion)' != '' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_ICAXWritableBuildOutput Include="$(OutDir)TubeDesigner.exe" />
      <_ICAXWritableBuildOutput Include="$(TargetPath)" Condition="'$(TargetPath)' != ''" />
    </ItemGroup>
    <ICAXCheckWritableBuildOutputs OutputPaths="@(_ICAXWritableBuildOutput)" />
  </Target>

  <!-- MSBuild executes each target only once in a build. Use a separate check
       here to catch a runtime started after Clean but before Link. -->
  <Target Name="ICAXCheckLinkOutputLocks"
          BeforeTargets="Link"
          Condition="'$(VCProjectVersion)' != '' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_ICAXWritableLinkOutput Include="$(OutDir)TubeDesigner.exe" />
      <_ICAXWritableLinkOutput Include="$(TargetPath)" Condition="'$(TargetPath)' != ''" />
    </ItemGroup>
    <ICAXCheckWritableBuildOutputs OutputPaths="@(_ICAXWritableLinkOutput)" />
  </Target>

  <!-- TubeDesigner templates and webpage modules are runtime data, not
       compiled sources. Keep complete copies beside the Debug/Release
       binaries so the running application and browser regressions exercise
       the same files. TubeDesigner owns its template deployment, including
       standalone plugin builds. Both builds also deploy the current webpage.
       Application depends on TubeDesigner and may safely repeat the sync;
       other projects do not write the output tree. -->
  <Target Name="ICAXCopyTubeDesignerTemplates"
          AfterTargets="Build"
          Condition="('$(MSBuildProjectName)' == 'TubeDesigner' or '$(MSBuildProjectName)' == 'Application') and '$(DesignTimeBuild)' != 'true'">
    <!-- Mirror templates so removed packages disappear from the running catalogue. -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ICAXSourceRoot)tools\build\sync_tube_designer_templates.ps1&quot; -OutputDirectory &quot;$(OutDir).&quot;" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ICAXSourceRoot)tools\build\sync_tube_designer_web_assets.ps1&quot; -OutputDirectory &quot;$(OutDir).&quot;" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ICAXSourceRoot)tools\build\deploy_tube_designer_manifest.ps1&quot; -OutputDirectory &quot;$(OutDir).&quot;" />
  </Target>
</Project>
